Subject: [selfhost 001] Multi-line Stage 0 ternaries -> value-form if

ternary_to_if.py will not cross a newline (Scripts/Migration/README: "by
hand"); these four are the sites it leaves: rg '^\s+if .* else '.

diff --git a/Compiler/Diagnostic/PrettyConsumer.k b/Compiler/Diagnostic/PrettyConsumer.k
index 1481b793..3b19b79c 100644
--- a/Compiler/Diagnostic/PrettyConsumer.k
+++ b/Compiler/Diagnostic/PrettyConsumer.k
@@ -856,8 +856,8 @@ class PrettyDiagConsumer derives DiagConsumer {
             var end_lc    = sm->get_line_col(label.range.end);
             var line_text = sm->get_full_line(label.range.start);
 
-            var glyph_col  = (if (label.style == DiagLabel::Style::Primary) => (sev_col) else => DIM)
-                if color else "";
+            var glyph_col  = if color => (if (label.style == DiagLabel::Style::Primary) => (sev_col) else => DIM)
+                else => "";
 
             var line_num_str = f"{start_lc.line}";
             var pad_count    = left_pad - line_num_str.length();
diff --git a/Compiler/Lexer/Lexer.k b/Compiler/Lexer/Lexer.k
