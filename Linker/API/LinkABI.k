/// --- The Kairo Project ----------------------- Linker/API/LinkABI.k ----- ///
///
///   \brief The link-time half of the object ABI note (c-cpp-abi.mdx): read
///          each input's note and refuse a link its objects disagree about.
///
///   \detail
///     The compiler writes the note (EmitIR::_abi_note) as eight bytes in a
///     section of its own:
///
///       0x7f 'K' 'A' 'B' 'I'   magic
///       version                1
///       conventions            bit 0 preserve_most, 1 preserve_all,
///                              2 preserve_none: what the object defines or
///                              calls
///       LLVM major             the code generator's (the compiler's LLVM)
///
///     LLVM documents these calling conventions as unstable across releases,
///     so two objects that use any of them must come from one LLVM major.
///     An object with no note (C, C++, or Kairo code that uses no
///     convention) is never part of the comparison.
///
///     The note is found by its bytes rather than by parsing the object
///     format: one scan reads ELF, Mach-O and COFF objects and every member
///     of an archive alike. A bitcode object (--lto) holds the record
///     bit-packed, so it is not found there yet (ticketed).
///
///   Part of the Kairo Project, under the Apache License v2.0 with the
///   Kairo Runtime Library Exception.
///
///   See: https://www.kairolang.org/LICENSE.txt
///   SPDX-License-Identifier: Apache-2.0 WITH KAIRO-RUNTIME-EXCEPTION
///   Copyright (c) 2026 Dhruvan Kartik
///
/// ------------------------------------------------------------------------ ///

import Linker::API::FS::*;
import Linker::API::LinkDiag::*;
import Linker::API::LinkJob::*;

/// One note found in one input.
struct AbiNote {
    var path:  string;
    var bits:  u32 = 0;
    var major: u32 = 0;
}

class LinkABI {
    /// Every note in \p job's inputs; an error in \p msgs when two that use
    /// a calling convention were generated by different LLVM majors. Only
    /// the first disagreement is reported: rebuilding resolves the rest.
    static fn check(job: ref!(LinkJob), msgs: ref!(vec::<LinkMessage>)) {
        var notes = vec::<AbiNote>();
        for o: string in job.objects      { LinkABI::_scan(o, notes); }
        for o: string in job.lazy_objects { LinkABI::_scan(o, notes); }
        if notes.size() < 2 { return; }

        var first = notes[0];
        for var i: usize = 1; i < notes.size(); ++i {
            var n = notes[i];
            if n.major == first.major { continue; }
            // The convention both use, if one is shared; else the first's.
            var both = first.bits & n.bits;
            var nm = LinkABI::_conv_name((both) if (both != 0) else (first.bits));
            msgs.push_back(LinkDiag::make(LinkSeverity::Error,
                f"'@{nm}' is used by {first.path} (LLVM {first.major}) and {n.path} (LLVM {n.major}); "
                + "this calling convention is not stable across LLVM versions; rebuild both"));
            return;
        }
    }

    /// Appends each well-formed note in \p path to \p out. An unreadable
    /// input is lld's to report, not this check's.
    priv static fn _scan(path: string, out: ref!(vec::<AbiNote>)) {
        var data = "";
        if !LinkFS::read(path, data) { return; }
        var n = data.size();
        if n < 8 { return; }
        for var i: usize = 0; (i + 8) <= n; ++i {
            if static_cast::<u32>(static_cast::<u8>(data[i])) != 127 { continue; }
            if static_cast::<u32>(static_cast::<u8>(data[i + 1])) != 75 { continue; }   // K
            if static_cast::<u32>(static_cast::<u8>(data[i + 2])) != 65 { continue; }   // A
            if static_cast::<u32>(static_cast::<u8>(data[i + 3])) != 66 { continue; }   // B
            if static_cast::<u32>(static_cast::<u8>(data[i + 4])) != 73 { continue; }   // I
            var ver   = static_cast::<u32>(static_cast::<u8>(data[i + 5]));
            var bits  = static_cast::<u32>(static_cast::<u8>(data[i + 6]));
            var major = static_cast::<u32>(static_cast::<u8>(data[i + 7]));
            // A record of a version this linker does not know, or bytes that
            // only look like the magic, are not a note.
            if (ver != 1) || (bits == 0) || (bits > 7) || (major == 0) { continue; }
            var a = AbiNote{};
            a.path  = path;
            a.bits  = bits;
            a.major = major;
            out.push_back(a);
            i += 7;
        }
    }

    /// The attribute bit \p bits' lowest set bit stands for.
    priv static fn _conv_name(bits: u32) -> string {
        if (bits & 1) != 0 { return "preserve_most"; }
        if (bits & 2) != 0 { return "preserve_all"; }
        return "preserve_none";
    }
}
