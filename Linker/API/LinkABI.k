/// --- The Kairo Project -------------------------------- API/LinkABI.k --- ///
///
///   Reads each input's ABI note and refuses a link whose objects disagree.
///
///     The compiler writes the note (EmitIR::_abi_note) as eight bytes in a
///     section of its own:
///
///       0x7f 'K' 'A' 'B' 'I'   magic
///       version                1
///       conventions            bit 0 preserve_most, 1 preserve_all,
///                              2 preserve_none: what the object defines or
///                              calls
///       LLVM major             the code generator's (the compiler's LLVM)
///
///     Beside it every Kairo object has a global-allocator record of seven
///     bytes (EmitIR::_abi_note):
///
///       0x7f 'K' 'A' 'B' 'I'   magic
///       kind                   2
///       flags                  1: compiled without
///                              __KAIRO_GLOBAL_ALLOCATOR_SET, so its Global
///                              is System, inlined; 2: it sets the global
///                              allocator (strong kairo_global_*)
///
///     An object with bit 1 linked with one with bit 2 (the same one too)
///     allocates around the program's allocator: refused, naming the object
///     to rebuild.
///
///     LLVM documents these calling conventions as unstable across releases,
///     so two objects that use any of them must come from one LLVM major.
///     An object with no note (C, C++, or Kairo code that uses no
///     convention) is never part of the comparison.
///
///     The note is found by its bytes rather than by parsing the object
///     format: one scan reads ELF, Mach-O and COFF objects and every member
///     of an archive alike. A bitcode object (--lto) holds the record
///     bit-packed, so it is not found there yet.
///
///   Part of the Kairo Project, under the Apache License v2.0 with the
///   Kairo Runtime Library Exception.
///
///   See: https://www.kairolang.org/LICENSE
///   SPDX-License-Identifier: Apache-2.0 WITH AdditionRef-Kairo-Runtime-exception
///   Copyright (c) 2026 Dhruvan Kartik
///
/// ------------------------------------------------------------------------ ///

ffi "c++" import "vector"

import API::FS::LinkFS
import API::LinkDiag::{
    LinkDiag,
    LinkMessage,
    LinkSeverity,
}
import API::LinkJob::LinkJob

/// One note found in one input.
pub struct AbiNote {
    var path:  string
    var bits:  u32    = 0
    var major: u32    = 0
}

/// One global-allocator record found in one input.
pub struct AllocNote {
    var path:  string
    var flags: u32    = 0
}

pub class LinkABI {
    /// Every note in \p job's inputs; an error in \p msgs when two that use
    /// a calling convention were generated by different LLVM majors. Only
    /// the first disagreement is reported: rebuilding resolves the rest.
    static fn check(@inout job: LinkJob, @inout msgs: cxx::std::vector<LinkMessage>) {
        var notes  = cxx::std::vector<AbiNote>()
        var allocs = cxx::std::vector<AllocNote>()
        for var o: string in job.objects {
            LinkABI::_scan(o, &notes, &allocs)
        }

        for var o: string in job.lazy_objects {
            LinkABI::_scan(o, &notes, &allocs)
        }

        LinkABI::_check_global_allocator(&allocs, &msgs)
        if notes.size() < 2 {
            return
        }

        var first = notes[0]
        for var i: usize = 1; i < notes.size(); ++i {
            var n = notes[i]
            if n.major == first.major {
                continue
            }

            // The convention both use, if one is shared; else the first's.
            var both = first.bits & n.bits
            var nm   = LinkABI::_conv_name(if (both != 0) => (both) else => first.bits)
            msgs.push_back(
                LinkDiag::make(
                    LinkSeverity::Error,
                    f"'@{nm}' is used by {first.path} (LLVM {first.major}) and {n.path} (LLVM {n.major}); " + "this calling convention is not stable across LLVM versions; rebuild both",
                ),
            )

            return
        }
    }

    /// true when an object (or archive) at \p path was compiled from a file
    /// that sets the global allocator (a record with flag 2): a link of
    /// objects alone learns the program's allocator is set from this, and
    /// takes the cached library built to match.
    pub static fn sets_global_allocator(const path: string) -> bool {
        var notes  = cxx::std::vector<AbiNote>()
        var allocs = cxx::std::vector<AllocNote>()
        LinkABI::_scan(path, &notes, &allocs)
        for var a: AllocNote in allocs {
            if (a.flags & 2) != 0 {
                return true
            }
        }

        return false
    }

    /// An object that inlined System (flag 1) beside one that sets the
    /// global allocator (flag 2): its allocations never reach that
    /// allocator. One error, at the first such pair.
    priv static fn _check_global_allocator(@inout allocs: cxx::std::vector<AllocNote>,
                                           @inout msgs:   cxx::std::vector<LinkMessage>) {
        var setter: isize = -1
        for var i: usize = 0; i < allocs.size(); ++i {
            if (allocs[i].flags & 2) != 0 {
                setter = (i as isize)
                break
            }
        }

        if setter < 0 {
            return
        }

        var s = allocs[setter as usize]
        for var a: AllocNote in allocs {
            if (a.flags & 1) == 0 {
                continue
            }

            var how = if (a.path == s.path) => (f"{a.path} sets the global allocator, but was")
                      else => f"{s.path} sets the global allocator, but {a.path} was"
            msgs.push_back(
                LinkDiag::make(
                    LinkSeverity::Error,
                    how + " compiled without __KAIRO_GLOBAL_ALLOCATOR_SET, so its allocations go to System and bypass it; " + f"rebuild {a.path} with --global-allocator-set",
                ),
            )

            return
        }
    }

    /// Appends each well-formed note in \p path to \p out, and each
    /// global-allocator record to \p allocs. An unreadable input is lld's
    /// to report, not this check's.
    priv static fn _scan(const path:    string,
                         @inout out:    cxx::std::vector<AbiNote>,
                         @inout allocs: cxx::std::vector<AllocNote>) {
        var data = ""
        if !LinkFS::read(path, &data) {
            return
        }

        var n = data.size()
        if n < 7 {
            return
        }

        for var i: usize = 0; i + 7 <= n; ++i {
            if ((data[i]) as u32) != 127 {
                continue
            }

            if ((data[i + 1]) as u32) != 75 { // K
                continue
            }

            if ((data[i + 2]) as u32) != 65 { // A
                continue
            }

            if ((data[i + 3]) as u32) != 66 { // B
                continue
            }

            if ((data[i + 4]) as u32) != 73 { // I
                continue
            }

            var ver  = ((data[i + 5]) as u32)
            var bits = ((data[i + 6]) as u32)
            if ver == 2 {
                if bits == 0 || bits > 3 {
                    continue
                }

                var g = AllocNote{}
                g.path  = path
                g.flags = bits
                allocs.push_back(g)
                i += 6
                continue
            }

            if i + 8 > n {
                continue
            }

            var major = ((data[i + 7]) as u32)
            // A record of a version this linker does not know, or bytes that
            // only look like the magic, are not a note.
            if ver != 1 || bits == 0 || bits > 7 || major == 0 {
                continue
            }

            var a = AbiNote{}
            a.path  = path
            a.bits  = bits
            a.major = major
            out.push_back(a)
            i += 7
        }
    }

    /// The attribute bit \p bits' lowest set bit stands for.
    priv static fn _conv_name(bits: u32) -> string {
        if (bits & 1) != 0 {
            return "preserve_most"
        }

        if (bits & 2) != 0 {
            return "preserve_all"
        }

        return "preserve_none"
    }
}
