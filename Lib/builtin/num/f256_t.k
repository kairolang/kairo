/// --- The Kairo Project ----------------------- Lib/builtin/num/f256_t.k --- ///
///
///   \brief `f256`, IEEE 754 binary256, as a library class: the C++ spelling
///          of the `f256` type keyword (AST/Node/CanonicalNodes.k).
///
///   \detail
///     Sign, 19-bit exponent (bias 262143), 236-bit fraction with a
///     hidden leading bit: 237 bits of precision, 71 decimal digits, range
///     about 10^+-78913. The interchange format IEEE 754-2019 3.6 defines
///     for k = 256.
///
///     No LLVM type exists at this width, so every operation is a call into
///     num/softfloat.k (arithmetic, conversions) and num/softfloat_text.k
///     (decimal text), the same engine at every width. Correctly rounded
///     (to nearest, ties to even) everywhere, signed zeros, subnormals,
///     infinities; a NaN result is the canonical quiet NaN. Sema types the
///     operators and casts on `f256` as it does any float's; the C++ they
///     lower to (`a + b`, `static_cast<double>(x)`) lands on the members
///     here.
///
///     A float-to-integer cast truncates toward zero and saturates at the
///     target's limits, NaN giving 0 (casting.mdx). Generated by
///     Scripts/gen_softfloat.py from one template with
///     f512_t.k; change both. The file is not `f256.k` because `f256` is
///     a keyword, and a keyword cannot be a module path segment.
///
///   SPDX-License-Identifier: Apache-2.0 WITH AdditionRef-Kairo-Runtime-exception
///   Copyright (c) 2026 Dhruvan Kartik
///
/// ------------------------------------------------------------------------ ///

import base::c_char::*
import base::intrinsics::*
import fmt::fmt_buf::FmtBuf
import num::softfloat::*
import num::softfloat_text::*
import string::*

/// The `f256` type: binary256 in a u256 (bit 255 the sign).
///
/// Aligned to its size, as Kairo lays out u256 (clang's _BitInt is only
/// 8-aligned; without the attribute the two layouts of `f256?` differ, P720).
@align(32)
pub class F256 {
    /// The encoding.
    pub var bits: u256 = 0

    /// +0.0.
    pub fn F256(self) {
        self.bits = 0
    }

    /// The encoding's format for the engine.
    pub inline static fn fmt_() -> SfFmt {
        return sf_fmt(256, 19)
    }

    /// The value whose encoding is `b`.
    pub inline static fn from_bits(b: u256) -> F256 {
        var r = F256()
        r.bits = b
        return r
    }

    /// The encoding.
    pub inline fn to_bits(const self) -> u256 {
        return self.bits
    }

    // --- from other types: what `x as f256` lowers to ---------------------

    /// `x as f256` from f64, exactly (every f64 is an f256).
    pub fn F256(self, v: f64) {
        self.bits = sf_cvt(
            F256::fmt_(),
            sf_fmt(64, 11),
            __builtin_bitcast<u64, f64>(v) as u512,
        ) as u256
    }

    /// `x as f256` from f32.
    pub fn F256(self, v: f32) {
        self.bits = sf_cvt(
            F256::fmt_(),
            sf_fmt(32, 8),
            __builtin_bitcast<u32, f32>(v) as u512,
        ) as u256
    }

    /// `x as f256` from i8, rounded to nearest even.
    pub fn F256(self, v: i8) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F256::fmt_(), mag, v < 0) as u256
    }

    /// `x as f256` from i16, rounded to nearest even.
    pub fn F256(self, v: i16) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F256::fmt_(), mag, v < 0) as u256
    }

    /// `x as f256` from i32, rounded to nearest even.
    pub fn F256(self, v: i32) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F256::fmt_(), mag, v < 0) as u256
    }

    /// `x as f256` from i64, rounded to nearest even.
    pub fn F256(self, v: i64) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F256::fmt_(), mag, v < 0) as u256
    }

    /// `x as f256` from u8, rounded to nearest even.
    pub fn F256(self, v: u8) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F256::fmt_(), mag, false) as u256
    }

    /// `x as f256` from u16, rounded to nearest even.
    pub fn F256(self, v: u16) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F256::fmt_(), mag, false) as u256
    }

    /// `x as f256` from u32, rounded to nearest even.
    pub fn F256(self, v: u32) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F256::fmt_(), mag, false) as u256
    }

    /// `x as f256` from u64, rounded to nearest even.
    pub fn F256(self, v: u64) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F256::fmt_(), mag, false) as u256
    }

    /// `x as f256` from i128, rounded to nearest even.
    pub fn F256(self, v: i128) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F256::fmt_(), mag, v < 0) as u256
    }

    /// `x as f256` from u128, rounded to nearest even.
    pub fn F256(self, v: u128) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F256::fmt_(), mag, false) as u256
    }

    /// `x as f256` from i256, rounded to nearest even.
    pub fn F256(self, v: i256) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F256::fmt_(), mag, v < 0) as u256
    }

    /// `x as f256` from u256, rounded to nearest even.
    pub fn F256(self, v: u256) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F256::fmt_(), mag, false) as u256
    }

    /// `x as f256` from i512, rounded to nearest even.
    pub fn F256(self, v: i512) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F256::fmt_(), mag, v < 0) as u256
    }

    /// `x as f256` from u512, rounded to nearest even.
    pub fn F256(self, v: u512) {
        var mag: u512 = v
        self.bits = sf_from_mag(F256::fmt_(), mag, false) as u256
    }


    // clang defines __FLT16_MAX__ exactly where _Float16 exists (fmt_buf.k).
    eval if defined!(__FLT16_MAX__) {
        /// `x as f256` from f16.
        pub fn F256(self, v: f16) {
            self.bits = sf_cvt(F256::fmt_(), sf_fmt(16, 5), __builtin_bitcast<u16, f16>(v) as u512) as u256
        }

        /// `x as f16`, rounded once.
        pub fn op as (const self) -> f16 {
            return __builtin_bitcast<f16, u16>(sf_cvt(sf_fmt(16, 5), F256::fmt_(), self.bits as u512) as u16)
        }
    }

    // The arches clang gives __bf16 (fmt_buf.k says why there is no macro),
    // but wasm: there a bf16 value's mere passing calls compiler-rt's
    // __truncsfbf2 with the wrong signature (P706), a link warning in every
    // program.
    eval if defined!(__x86_64__) || defined!(__i386__) || defined!(__aarch64__) || defined!(__arm__)
         || defined!(__riscv) || defined!(__loongarch__) {
        /// `x as f256` from bf16.
        pub fn F256(self, v: bf16) {
            self.bits = sf_cvt(F256::fmt_(), sf_fmt(16, 8), __builtin_bitcast<u16, bf16>(v) as u512) as u256
        }

        /// `x as bf16`, rounded once.
        pub fn op as (const self) -> bf16 {
            return __builtin_bitcast<bf16, u16>(sf_cvt(sf_fmt(16, 8), F256::fmt_(), self.bits as u512) as u16)
        }
    }

    // __SIZEOF_FLOAT128__ marks __float128; wasm32 has it without the macro.
    eval if defined!(__SIZEOF_FLOAT128__) || defined!(__wasm__) {
        /// `x as f256` from f128.
        pub fn F256(self, v: f128) {
            self.bits = sf_cvt(F256::fmt_(), sf_fmt(128, 15), __builtin_bitcast<u128, f128>(v) as u512) as u256
        }

        /// `x as f128`, rounded once.
        pub fn op as (const self) -> f128 {
            return __builtin_bitcast<f128, u128>(sf_cvt(sf_fmt(128, 15), F256::fmt_(), self.bits as u512) as u128)
        }
    }

    // f80 is x87 extended where it exists at all (fmt_buf.k's gate). Its
    // bytes are read and written directly: sizeof is 16 or 12, the value
    // is the low 10, little-endian (x86).
    eval if (defined!(__x86_64__) || defined!(__i386__)) && !defined!(_MSC_VER) && !defined!(__ANDROID__) {
        /// `x as f256` from f80.
        pub fn F256(self, v: f80) {
            var m: u64 = 0
            var se: u16 = 0
            unsafe {
                var unsafe *p = (&v) as unsafe *const u8
                for var i: i32 = 7; i >= 0; i -= 1 { m = (m << 8) | (p[i] as u64) }
                se = (p[8] as u16) | ((p[9] as u16) << 8)
            }
            self.bits = sf_cvt(F256::fmt_(), sf_fmt(79, 15), sf_from_x87(se, m)) as u256
        }

        /// `x as f80`, rounded once.
        pub fn op as (const self) -> f80 {
            var se: u16 = 0
            var m: u64 = 0
            sf_to_x87(sf_cvt(sf_fmt(79, 15), F256::fmt_(), self.bits as u512), &se, &m)
            var r: f80 = 0.0
            unsafe {
                var unsafe *p = (&r) as unsafe *u8
                for var i: i32 = 0; i < 8; ++i { p[i] = (m >> ((8 * i) as u64)) as u8 }
                p[8] = se as u8
                p[9] = (se >> 8) as u8
            }
            return r
        }
    }

    // --- to other types: what `x as T` lowers to ---------------------------

    /// `x as f64`, rounded once (never through an intermediate format).
    pub fn op as (const self) -> f64 {
        return __builtin_bitcast<f64, u64>(
            sf_cvt(sf_fmt(64, 11), F256::fmt_(), self.bits as u512) as u64,
        )
    }

    /// `x as f32`, rounded once.
    pub fn op as (const self) -> f32 {
        return __builtin_bitcast<f32, u32>(
            sf_cvt(sf_fmt(32, 8), F256::fmt_(), self.bits as u512) as u32,
        )
    }

    /// `x as i8`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i8 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 8, true) as i8
    }

    /// `x as i16`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i16 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 16, true) as i16
    }

    /// `x as i32`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i32 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 32, true) as i32
    }

    /// `x as i64`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i64 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 64, true) as i64
    }

    /// `x as u8`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u8 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 8, false) as u8
    }

    /// `x as u16`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u16 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 16, false) as u16
    }

    /// `x as u32`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u32 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 32, false) as u32
    }

    /// `x as u64`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u64 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 64, false) as u64
    }

    /// `x as i128`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i128 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 128, true) as i128
    }

    /// `x as u128`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u128 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 128, false) as u128
    }

    /// `x as i256`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i256 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 256, true) as i256
    }

    /// `x as u256`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u256 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 256, false) as u256
    }

    /// `x as i512`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i512 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 512, true) as i512
    }

    /// `x as u512`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u512 {
        return sf_to_sat(F256::fmt_(), self.bits as u512, 512, false)
    }

    // isize / usize where they are not i64 / u64 or i32 / u32 under another
    // name (elsewhere those overloads already take them).
    eval if defined!(__APPLE__) && defined!(__LP64__) {
        /// `x as f256` from isize.
        pub fn F256(self, v: isize) {
            var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
            self.bits = sf_from_mag(F256::fmt_(), mag, v < 0) as u256
        }

        /// `x as isize`: toward zero, saturating, NaN 0.
        pub fn op as (const self) -> isize { return sf_to_sat(F256::fmt_(), self.bits as u512, 64, true) as isize }

        /// `x as f256` from usize.
        pub fn F256(self, v: usize) {
            var mag: u512 = v as u512
            self.bits = sf_from_mag(F256::fmt_(), mag, false) as u256
        }

        /// `x as usize`: toward zero, saturating, NaN 0.
        pub fn op as (const self) -> usize { return sf_to_sat(F256::fmt_(), self.bits as u512, 64, false) as usize }
    }

    eval if defined!(__wasm32__) {
        /// `x as f256` from isize.
        pub fn F256(self, v: isize) {
            var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
            self.bits = sf_from_mag(F256::fmt_(), mag, v < 0) as u256
        }

        /// `x as isize`: toward zero, saturating, NaN 0.
        pub fn op as (const self) -> isize { return sf_to_sat(F256::fmt_(), self.bits as u512, 32, true) as isize }

        /// `x as f256` from usize.
        pub fn F256(self, v: usize) {
            var mag: u512 = v as u512
            self.bits = sf_from_mag(F256::fmt_(), mag, false) as u256
        }

        /// `x as usize`: toward zero, saturating, NaN 0.
        pub fn op as (const self) -> usize { return sf_to_sat(F256::fmt_(), self.bits as u512, 32, false) as usize }
    }

    // --- text ----------------------------------------------------------------

    /// The correctly rounded value of a decimal or hex float literal's
    /// digits: what the compiler emits for `1.5f256`, `0.1` typed `f256`, and
    /// so on (EmitIR's float literal). Not for users: `parse` is.
    pub static fn lit_(p: *const __builtin_c_char, n: usize) -> F256 {
        var r       = F256()
        var v: u512 = 0
        unsafe {
            sf_parse_bits(F256::fmt_(), p as unsafe *const u8 as *const u8, n, &v)
        }

        r.bits = v as u256
        return r
    }

    /// Parses `s` (decimal, `0x` hex, `inf`, `infinity`, `nan`, an optional
    /// sign, `_` between digits), correctly rounded, into `*out`; false
    /// (out untouched) when `s` is not a float.
    ///
    /// \note Not `-> F256?`: a nullable return from a builtin class with
    /// this alignment does not compile yet (P721).
    pub static fn parse(const s: string, out: *F256) -> bool {
        var v: u512 = 0
        if !sf_parse_bits(F256::fmt_(), s.as_ptr(), s.length(), &v) {
            return false
        }

        out->bits = v as u256
        return true
    }

    /// |self| as text into out[0..cap) (rt/fmt.h's contract: conv 'g',
    /// 'e' or 'E', prec < 0 for the shortest round-trip digits); returns the
    /// bytes written. The sign is the caller's (fmt_put_).
    pub fn format_into_(const self, out: unsafe *u8, cap: usize, prec: i32, conv: u8) -> i32 {
        return sf_format_bits(F256::fmt_(), self.bits as u512, out, cap, prec, conv)
    }

    /// Appends self to `b` as an f-string hole, honouring the sign bit of -0.0 and NaN: what
    /// `{x}` on an `f256` lowers to (FStringLowering calls `x.fmt_put_(&buf, spec)`; a put on
    /// FmtBuf would name the type, P723). Precision, width, fill and alignment come from `spec`;
    /// the `e` base selects exponent form, `E` with the upper flag. The shortest form has at
    /// most 73 significant digits; a precision gives at most 600.
    pub fn fmt_put_(const self, b: *FmtBuf, spec: u64) {
        var prec = FmtBuf::prec_(spec)
        var digits: usize = (if prec >= 0 => prec as usize else => 0) + 2 * (sf_rt_digits(
            F256::fmt_(),
        ) as usize) + 24
        var slot     = b->number_slot_(spec, digits)
        var n:   i32 = 0
        unsafe {
            n = self.format_into_(unsafe &b->data[slot], digits, prec as i32, FmtBuf::conv_(spec))
        }

        b->number_at_(slot, n as usize, self.bits >> 255 != 0, spec)
    }

    // --- arithmetic ---------------------------------------------------------

    /// self + o, rounded to nearest even.
    pub fn op + (const self, const o: F256) -> F256 {
        return F256::from_bits(
            sf_op(F256::fmt_(), SF_OP_ADD, self.bits as u512, o.bits as u512, 0) as u256,
        )
    }

    /// self - o, rounded to nearest even.
    pub fn op - (const self, const o: F256) -> F256 {
        return F256::from_bits(
            sf_op(F256::fmt_(), SF_OP_SUB, self.bits as u512, o.bits as u512, 0) as u256,
        )
    }

    /// self * o, rounded to nearest even.
    pub fn op * (const self, const o: F256) -> F256 {
        return F256::from_bits(
            sf_op(F256::fmt_(), SF_OP_MUL, self.bits as u512, o.bits as u512, 0) as u256,
        )
    }

    /// self / o, rounded to nearest even.
    pub fn op / (const self, const o: F256) -> F256 {
        return F256::from_bits(
            sf_op(F256::fmt_(), SF_OP_DIV, self.bits as u512, o.bits as u512, 0) as u256,
        )
    }

    /// -self: the sign bit flipped (NaN included).
    pub fn op - (const self) -> F256 {
        return F256::from_bits(self.bits ^ (1 as u256) << 255)
    }

    // `+=` and the rest derive from these (operator-overloading.mdx).

    /// The square root, correctly rounded; sqrt(-0) is -0, other negatives NaN.
    pub fn sqrt(const self) -> F256 {
        return F256::from_bits(sf_op(F256::fmt_(), SF_OP_SQRT, self.bits as u512, 0, 0) as u256)
    }

    /// self * b + c, rounded once.
    pub fn fma(const self, const b: F256, const c: F256) -> F256 {
        return F256::from_bits(
            sf_op(
                F256::fmt_(),
                SF_OP_FMA,
                self.bits as u512,
                b.bits as u512,
                c.bits as u512,
            ) as u256,
        )
    }

    /// |self|: the sign bit cleared.
    pub fn abs(const self) -> F256 {
        return F256::from_bits(self.bits & ~((1 as u256) << 255))
    }

    /// self's magnitude with s's sign.
    pub fn copysign(const self, const s: F256) -> F256 {
        var m: u256 = (1 as u256) << 255
        return F256::from_bits(self.bits & ~m | s.bits & m)
    }

    // --- comparison: IEEE, a NaN is unordered with everything ---------------

    /// IEEE equality: false when either is NaN; -0 == +0.
    pub fn op == (const self, const o: F256) -> bool {
        return sf_cmp_bits(F256::fmt_(), self.bits as u512, o.bits as u512) == 0
    }

    /// The negation of ==: true when either is NaN.
    pub fn op != (const self, const o: F256) -> bool {
        return sf_cmp_bits(F256::fmt_(), self.bits as u512, o.bits as u512) != 0
    }

    /// IEEE less-than: false when unordered.
    pub fn op < (const self, const o: F256) -> bool {
        return sf_cmp_bits(F256::fmt_(), self.bits as u512, o.bits as u512) == -1
    }

    /// IEEE less-or-equal: false when unordered.
    pub fn op <= (const self, const o: F256) -> bool {
        var c = sf_cmp_bits(F256::fmt_(), self.bits as u512, o.bits as u512)
        return c == -1 || c == 0
    }

    /// IEEE greater-than: false when unordered.
    pub fn op > (const self, const o: F256) -> bool {
        return sf_cmp_bits(F256::fmt_(), self.bits as u512, o.bits as u512) == 1
    }

    /// IEEE greater-or-equal: false when unordered.
    pub fn op >= (const self, const o: F256) -> bool {
        var c = sf_cmp_bits(F256::fmt_(), self.bits as u512, o.bits as u512)
        return c == 1 || c == 0
    }

    /// Whether either is a NaN (IEEE's unordered predicate).
    pub fn is_unordered(const self, const o: F256) -> bool {
        return sf_cmp_bits(F256::fmt_(), self.bits as u512, o.bits as u512) == 2
    }

    // --- classification -----------------------------------------------------

    /// Whether self is a NaN.
    pub fn is_nan(const self) -> bool {
        return sf_class_bits(F256::fmt_(), self.bits as u512) == SF_NAN
    }

    /// Whether self is an infinity.
    pub fn is_infinite(const self) -> bool {
        return sf_class_bits(F256::fmt_(), self.bits as u512) == SF_INF
    }

    /// Whether self is neither infinite nor NaN.
    pub fn is_finite(const self) -> bool {
        return sf_class_bits(F256::fmt_(), self.bits as u512) < SF_INF
    }

    /// Whether self is +0 or -0.
    pub fn is_zero(const self) -> bool {
        return sf_class_bits(F256::fmt_(), self.bits as u512) == SF_ZERO
    }

    /// Whether self is subnormal (nonzero, below the smallest normal).
    pub fn is_subnormal(const self) -> bool {
        return sf_subnormal_bits(F256::fmt_(), self.bits as u512)
    }

    /// Whether self is normal (finite, nonzero, not subnormal).
    pub fn is_normal(const self) -> bool {
        return sf_class_bits(F256::fmt_(), self.bits as u512) == SF_FINITE && !self.is_subnormal()
    }

    /// Whether the sign bit is set (-0.0 and negative NaNs included).
    pub fn is_sign_negative(const self) -> bool {
        return self.bits >> 255 != 0
    }

    // --- limits ---------------------------------------------------------------

    /// +infinity.
    pub static fn infinity() -> F256 {
        return F256::from_bits(F256::exp_mask_())
    }

    /// -infinity.
    pub static fn neg_infinity() -> F256 {
        return F256::from_bits(F256::exp_mask_() | (1 as u256) << 255)
    }

    /// The canonical quiet NaN.
    pub static fn nan() -> F256 {
        return F256::from_bits(F256::exp_mask_() | (1 as u256) << 235)
    }

    /// The largest finite value.
    pub static fn max() -> F256 {
        return F256::from_bits(F256::exp_mask_() - 1)
    }

    /// The smallest positive normal value.
    pub static fn min_positive() -> F256 {
        return F256::from_bits((1 as u256) << 236)
    }

    /// The smallest positive subnormal value.
    pub static fn min_subnormal() -> F256 {
        return F256::from_bits(1)
    }

    /// The gap between 1.0 and the next value up: 2^-236.
    pub static fn epsilon() -> F256 {
        return F256::from_bits(((262143 - 236) as u256) << 236)
    }

    priv inline static fn exp_mask_() -> u256 {
        return ((1 as u256) << 19) - 1 << 236
    }
}

// --- the same, as methods of the `f256` type ----------------------------------
//
// Sema types `f256` as a builtin, unrelated to F256 (only C++ spells it as the
// class), so the class's members are not members of an `f256` value. These
// make them so (`x.sqrt()`, `x.is_nan()`), each a pass-through on the one
// encoding both have. The limits are the type's associated constants
// (`f256::MAX`, PrimitiveLimits.k), not methods.

/// An `f256` as the class.
priv inline fn f256_cls_(x: f256) -> F256 {
    return F256::from_bits(__builtin_bitcast<u256, f256>(x))
}

/// The class as an `f256`.
priv inline fn f256_val_(c: F256) -> f256 {
    return __builtin_bitcast<f256, u256>(c.bits)
}

extend f256 {
    /// The encoding (bit 255 the sign).
    pub fn to_bits(const self) -> u256 {
        return __builtin_bitcast<u256, f256>(self)
    }

    /// The square root, correctly rounded; sqrt(-0) is -0, other negatives NaN.
    pub fn sqrt(const self) -> f256 {
        return f256_val_(f256_cls_(self).sqrt())
    }

    /// self * b + c, rounded once.
    pub fn fma(const self, b: f256, c: f256) -> f256 {
        return f256_val_(f256_cls_(self).fma(f256_cls_(b), f256_cls_(c)))
    }

    /// |self|: the sign bit cleared.
    pub fn abs(const self) -> f256 {
        return f256_val_(f256_cls_(self).abs())
    }

    /// self's magnitude with s's sign.
    pub fn copysign(const self, s: f256) -> f256 {
        return f256_val_(f256_cls_(self).copysign(f256_cls_(s)))
    }

    /// Whether either is a NaN (IEEE's unordered predicate).
    pub fn is_unordered(const self, o: f256) -> bool {
        return f256_cls_(self).is_unordered(f256_cls_(o))
    }

    /// Whether self is a NaN.
    pub fn is_nan(const self) -> bool {
        return f256_cls_(self).is_nan()
    }

    /// Whether self is an infinity.
    pub fn is_infinite(const self) -> bool {
        return f256_cls_(self).is_infinite()
    }

    /// Whether self is neither infinite nor NaN.
    pub fn is_finite(const self) -> bool {
        return f256_cls_(self).is_finite()
    }

    /// Whether self is +0 or -0.
    pub fn is_zero(const self) -> bool {
        return f256_cls_(self).is_zero()
    }

    /// Whether self is subnormal (nonzero, below the smallest normal).
    pub fn is_subnormal(const self) -> bool {
        return f256_cls_(self).is_subnormal()
    }

    /// Whether self is normal (finite, nonzero, not subnormal).
    pub fn is_normal(const self) -> bool {
        return f256_cls_(self).is_normal()
    }

    /// Whether the sign bit is set (-0.0 and negative NaNs included).
    pub fn is_sign_negative(const self) -> bool {
        return f256_cls_(self).is_sign_negative()
    }
}
