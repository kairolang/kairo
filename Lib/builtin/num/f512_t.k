/// --- The Kairo Project ----------------------- Lib/builtin/num/f512_t.k --- ///
///
///   \brief `f512`, IEEE 754 "binary512", as a library class: the C++ spelling
///          of the `f512` type keyword (AST/Node/CanonicalNodes.k).
///
///   \detail
///     Sign, 23-bit exponent (bias 4194303), 488-bit fraction with a
///     hidden leading bit: 489 bits of precision, 147 decimal digits, range
///     about 10^+-1262612. IEEE 754 defines no 512-bit format; this is its
///     interchange-format rule (3.6, Table 3.5) carried to k = 512:
///     precision p = k - round(4 log2(k)) + 13 = 489, so the exponent is
///     w = k - p = round(4 * 9) - 13 = 23 bits and emax = 2^22 - 1. The
///     rule gives 15 at k = 128 and 19 at k = 256, the standard widths.
///
///     No LLVM type exists at this width, so every operation is a call into
///     num/softfloat.k (arithmetic, conversions) and num/softfloat_text.k
///     (decimal text), the same engine at every width. Correctly rounded
///     (to nearest, ties to even) everywhere, signed zeros, subnormals,
///     infinities; a NaN result is the canonical quiet NaN. Sema types the
///     operators and casts on `f512` as it does any float's; the C++ they
///     lower to (`a + b`, `static_cast<double>(x)`) lands on the members
///     here.
///
///     A float-to-integer cast truncates toward zero and saturates at the
///     target's limits, NaN giving 0 (casting.mdx). Generated by
///     Scripts/gen_softfloat.py from one template with
///     f256_t.k; change both. The file is not `f512.k` because `f512` is
///     a keyword, and a keyword cannot be a module path segment.
///
///   SPDX-License-Identifier: Apache-2.0 WITH AdditionRef-Kairo-Runtime-exception
///   Copyright (c) 2026 Dhruvan Kartik
///
/// ------------------------------------------------------------------------ ///

import base::c_char::*
import base::intrinsics::*
import num::f256_t::*
import num::softfloat::*
import num::softfloat_text::*
import string::*

/// The `f512` type: "binary512" in a u512 (bit 511 the sign).
///
/// Aligned to its size, as Kairo lays out u512 (clang's _BitInt is only
/// 8-aligned; without the attribute the two layouts of `f512?` differ, P720).
@align(64)
pub class F512 {
    /// The encoding.
    pub var bits: u512 = 0

    /// +0.0.
    pub fn F512(self) {
        self.bits = 0
    }

    /// The encoding's format for the engine.
    pub inline static fn fmt_() -> SfFmt {
        return sf_fmt(512, 23)
    }

    /// The value whose encoding is `b`.
    pub inline static fn from_bits(b: u512) -> F512 {
        var r = F512()
        r.bits = b
        return r
    }

    /// The encoding.
    pub inline fn to_bits(const self) -> u512 {
        return self.bits
    }

    // --- from other types: what `x as f512` lowers to ---------------------

    /// `x as f512` from f64, exactly (every f64 is an f512).
    pub fn F512(self, v: f64) {
        self.bits = sf_cvt(F512::fmt_(), sf_fmt(64, 11), __builtin_bitcast<u64, f64>(v) as u512)
    }

    /// `x as f512` from f32.
    pub fn F512(self, v: f32) {
        self.bits = sf_cvt(F512::fmt_(), sf_fmt(32, 8), __builtin_bitcast<u32, f32>(v) as u512)
    }

    /// `x as f512` from i8, rounded to nearest even.
    pub fn F512(self, v: i8) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F512::fmt_(), mag, v < 0)
    }

    /// `x as f512` from i16, rounded to nearest even.
    pub fn F512(self, v: i16) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F512::fmt_(), mag, v < 0)
    }

    /// `x as f512` from i32, rounded to nearest even.
    pub fn F512(self, v: i32) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F512::fmt_(), mag, v < 0)
    }

    /// `x as f512` from i64, rounded to nearest even.
    pub fn F512(self, v: i64) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F512::fmt_(), mag, v < 0)
    }

    /// `x as f512` from u8, rounded to nearest even.
    pub fn F512(self, v: u8) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F512::fmt_(), mag, false)
    }

    /// `x as f512` from u16, rounded to nearest even.
    pub fn F512(self, v: u16) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F512::fmt_(), mag, false)
    }

    /// `x as f512` from u32, rounded to nearest even.
    pub fn F512(self, v: u32) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F512::fmt_(), mag, false)
    }

    /// `x as f512` from u64, rounded to nearest even.
    pub fn F512(self, v: u64) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F512::fmt_(), mag, false)
    }

    /// `x as f512` from i128, rounded to nearest even.
    pub fn F512(self, v: i128) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F512::fmt_(), mag, v < 0)
    }

    /// `x as f512` from u128, rounded to nearest even.
    pub fn F512(self, v: u128) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F512::fmt_(), mag, false)
    }

    /// `x as f512` from i256, rounded to nearest even.
    pub fn F512(self, v: i256) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F512::fmt_(), mag, v < 0)
    }

    /// `x as f512` from u256, rounded to nearest even.
    pub fn F512(self, v: u256) {
        var mag: u512 = v as u512
        self.bits = sf_from_mag(F512::fmt_(), mag, false)
    }

    /// `x as f512` from i512, rounded to nearest even.
    pub fn F512(self, v: i512) {
        var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
        self.bits = sf_from_mag(F512::fmt_(), mag, v < 0)
    }

    /// `x as f512` from u512, rounded to nearest even.
    pub fn F512(self, v: u512) {
        var mag: u512 = v
        self.bits = sf_from_mag(F512::fmt_(), mag, false)
    }

    /// `x as f512` from f256, exactly.
    pub fn F512(self, const v: F256) {
        self.bits = sf_cvt(F512::fmt_(), F256::fmt_(), v.bits as u512)
    }

    /// `x as f256`, rounded once.
    pub fn op as (const self) -> F256 {
        return F256::from_bits(sf_cvt(F256::fmt_(), F512::fmt_(), self.bits) as u256)
    }

    // clang defines __FLT16_MAX__ exactly where _Float16 exists (fmt_buf.k).
    eval if defined!(__FLT16_MAX__) {
        /// `x as f512` from f16.
        pub fn F512(self, v: f16) {
            self.bits = sf_cvt(F512::fmt_(), sf_fmt(16, 5), __builtin_bitcast<u16, f16>(v) as u512)
        }

        /// `x as f16`, rounded once.
        pub fn op as (const self) -> f16 {
            return __builtin_bitcast<f16, u16>(sf_cvt(sf_fmt(16, 5), F512::fmt_(), self.bits) as u16)
        }
    }

    // The arches clang gives __bf16 (fmt_buf.k says why there is no macro),
    // but wasm: there a bf16 value's mere passing calls compiler-rt's
    // __truncsfbf2 with the wrong signature (P706), a link warning in every
    // program.
    eval if defined!(__x86_64__) || defined!(__i386__) || defined!(__aarch64__) || defined!(__arm__)
         || defined!(__riscv) || defined!(__loongarch__) {
        /// `x as f512` from bf16.
        pub fn F512(self, v: bf16) {
            self.bits = sf_cvt(F512::fmt_(), sf_fmt(16, 8), __builtin_bitcast<u16, bf16>(v) as u512)
        }

        /// `x as bf16`, rounded once.
        pub fn op as (const self) -> bf16 {
            return __builtin_bitcast<bf16, u16>(sf_cvt(sf_fmt(16, 8), F512::fmt_(), self.bits) as u16)
        }
    }

    // __SIZEOF_FLOAT128__ marks __float128; wasm32 has it without the macro.
    eval if defined!(__SIZEOF_FLOAT128__) || defined!(__wasm__) {
        /// `x as f512` from f128.
        pub fn F512(self, v: f128) {
            self.bits = sf_cvt(F512::fmt_(), sf_fmt(128, 15), __builtin_bitcast<u128, f128>(v) as u512)
        }

        /// `x as f128`, rounded once.
        pub fn op as (const self) -> f128 {
            return __builtin_bitcast<f128, u128>(sf_cvt(sf_fmt(128, 15), F512::fmt_(), self.bits) as u128)
        }
    }

    // f80 is x87 extended where it exists at all (fmt_buf.k's gate). Its
    // bytes are read and written directly: sizeof is 16 or 12, the value
    // is the low 10, little-endian (x86).
    eval if (defined!(__x86_64__) || defined!(__i386__)) && !defined!(_MSC_VER) && !defined!(__ANDROID__) {
        /// `x as f512` from f80.
        pub fn F512(self, v: f80) {
            var m: u64 = 0
            var se: u16 = 0
            unsafe {
                var unsafe *p = (&v) as unsafe *const u8
                for var i: i32 = 7; i >= 0; i -= 1 { m = (m << 8) | (p[i] as u64) }
                se = (p[8] as u16) | ((p[9] as u16) << 8)
            }
            self.bits = sf_cvt(F512::fmt_(), sf_fmt(79, 15), sf_from_x87(se, m))
        }

        /// `x as f80`, rounded once.
        pub fn op as (const self) -> f80 {
            var se: u16 = 0
            var m: u64 = 0
            sf_to_x87(sf_cvt(sf_fmt(79, 15), F512::fmt_(), self.bits), &se, &m)
            var r: f80 = 0.0
            unsafe {
                var unsafe *p = (&r) as unsafe *u8
                for var i: i32 = 0; i < 8; ++i { p[i] = (m >> ((8 * i) as u64)) as u8 }
                p[8] = se as u8
                p[9] = (se >> 8) as u8
            }
            return r
        }
    }

    // --- to other types: what `x as T` lowers to ---------------------------

    /// `x as f64`, rounded once (never through an intermediate format).
    pub fn op as (const self) -> f64 {
        return __builtin_bitcast<f64, u64>(sf_cvt(sf_fmt(64, 11), F512::fmt_(), self.bits) as u64)
    }

    /// `x as f32`, rounded once.
    pub fn op as (const self) -> f32 {
        return __builtin_bitcast<f32, u32>(sf_cvt(sf_fmt(32, 8), F512::fmt_(), self.bits) as u32)
    }

    /// `x as i8`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i8 {
        return sf_to_sat(F512::fmt_(), self.bits, 8, true) as i8
    }

    /// `x as i16`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i16 {
        return sf_to_sat(F512::fmt_(), self.bits, 16, true) as i16
    }

    /// `x as i32`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i32 {
        return sf_to_sat(F512::fmt_(), self.bits, 32, true) as i32
    }

    /// `x as i64`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i64 {
        return sf_to_sat(F512::fmt_(), self.bits, 64, true) as i64
    }

    /// `x as u8`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u8 {
        return sf_to_sat(F512::fmt_(), self.bits, 8, false) as u8
    }

    /// `x as u16`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u16 {
        return sf_to_sat(F512::fmt_(), self.bits, 16, false) as u16
    }

    /// `x as u32`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u32 {
        return sf_to_sat(F512::fmt_(), self.bits, 32, false) as u32
    }

    /// `x as u64`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u64 {
        return sf_to_sat(F512::fmt_(), self.bits, 64, false) as u64
    }

    /// `x as i128`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i128 {
        return sf_to_sat(F512::fmt_(), self.bits, 128, true) as i128
    }

    /// `x as u128`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u128 {
        return sf_to_sat(F512::fmt_(), self.bits, 128, false) as u128
    }

    /// `x as i256`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i256 {
        return sf_to_sat(F512::fmt_(), self.bits, 256, true) as i256
    }

    /// `x as u256`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u256 {
        return sf_to_sat(F512::fmt_(), self.bits, 256, false) as u256
    }

    /// `x as i512`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> i512 {
        return sf_to_sat(F512::fmt_(), self.bits, 512, true) as i512
    }

    /// `x as u512`: toward zero, saturating, NaN 0.
    pub fn op as (const self) -> u512 {
        return sf_to_sat(F512::fmt_(), self.bits, 512, false)
    }

    // isize / usize where they are not i64 / u64 or i32 / u32 under another
    // name (elsewhere those overloads already take them).
    eval if defined!(__APPLE__) && defined!(__LP64__) {
        /// `x as f512` from isize.
        pub fn F512(self, v: isize) {
            var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
            self.bits = sf_from_mag(F512::fmt_(), mag, v < 0)
        }

        /// `x as isize`: toward zero, saturating, NaN 0.
        pub fn op as (const self) -> isize { return sf_to_sat(F512::fmt_(), self.bits, 64, true) as isize }

        /// `x as f512` from usize.
        pub fn F512(self, v: usize) {
            var mag: u512 = v as u512
            self.bits = sf_from_mag(F512::fmt_(), mag, false)
        }

        /// `x as usize`: toward zero, saturating, NaN 0.
        pub fn op as (const self) -> usize { return sf_to_sat(F512::fmt_(), self.bits, 64, false) as usize }
    }

    eval if defined!(__wasm32__) {
        /// `x as f512` from isize.
        pub fn F512(self, v: isize) {
            var mag: u512 = (if v < 0 => (0 as u512) - (v as u512) else => v as u512)
            self.bits = sf_from_mag(F512::fmt_(), mag, v < 0)
        }

        /// `x as isize`: toward zero, saturating, NaN 0.
        pub fn op as (const self) -> isize { return sf_to_sat(F512::fmt_(), self.bits, 32, true) as isize }

        /// `x as f512` from usize.
        pub fn F512(self, v: usize) {
            var mag: u512 = v as u512
            self.bits = sf_from_mag(F512::fmt_(), mag, false)
        }

        /// `x as usize`: toward zero, saturating, NaN 0.
        pub fn op as (const self) -> usize { return sf_to_sat(F512::fmt_(), self.bits, 32, false) as usize }
    }

    // --- text ----------------------------------------------------------------

    /// The correctly rounded value of a decimal or hex float literal's
    /// digits: what the compiler emits for `1.5f512`, `0.1` typed `f512`, and
    /// so on (EmitIR's float literal). Not for users: `parse` is.
    pub static fn lit_(p: *const __builtin_c_char, n: usize) -> F512 {
        var r       = F512()
        var v: u512 = 0
        unsafe {
            sf_parse_bits(F512::fmt_(), p as unsafe *const u8 as *const u8, n, &v)
        }

        r.bits = v
        return r
    }

    /// Parses `s` (decimal, `0x` hex, `inf`, `infinity`, `nan`, an optional
    /// sign, `_` between digits), correctly rounded, into `*out`; false
    /// (out untouched) when `s` is not a float.
    ///
    /// \note Not `-> F512?`: a nullable return from a builtin class with
    /// this alignment does not compile yet (P721).
    pub static fn parse(const s: string, out: *F512) -> bool {
        var v: u512 = 0
        if !sf_parse_bits(F512::fmt_(), s.as_ptr(), s.length(), &v) {
            return false
        }

        out->bits = v
        return true
    }

    /// |self| as text into out[0..cap) (rt/fmt.h's contract: conv 'g',
    /// 'e' or 'E', prec < 0 for the shortest round-trip digits); returns the
    /// bytes written. The sign is the caller's (FmtBuf::put_f512).
    pub fn format_into_(const self, out: unsafe *u8, cap: usize, prec: i32, conv: u8) -> i32 {
        return sf_format_bits(F512::fmt_(), self.bits, out, cap, prec, conv)
    }

    // --- arithmetic ---------------------------------------------------------

    /// self + o, rounded to nearest even.
    pub fn op + (const self, const o: F512) -> F512 {
        return F512::from_bits(sf_op(F512::fmt_(), SF_OP_ADD, self.bits, o.bits, 0))
    }

    /// self - o, rounded to nearest even.
    pub fn op - (const self, const o: F512) -> F512 {
        return F512::from_bits(sf_op(F512::fmt_(), SF_OP_SUB, self.bits, o.bits, 0))
    }

    /// self * o, rounded to nearest even.
    pub fn op * (const self, const o: F512) -> F512 {
        return F512::from_bits(sf_op(F512::fmt_(), SF_OP_MUL, self.bits, o.bits, 0))
    }

    /// self / o, rounded to nearest even.
    pub fn op / (const self, const o: F512) -> F512 {
        return F512::from_bits(sf_op(F512::fmt_(), SF_OP_DIV, self.bits, o.bits, 0))
    }

    /// -self: the sign bit flipped (NaN included).
    pub fn op - (const self) -> F512 {
        return F512::from_bits(self.bits ^ (1 as u512) << 511)
    }

    // `+=` and the rest derive from these (operator-overloading.mdx).

    /// The square root, correctly rounded; sqrt(-0) is -0, other negatives NaN.
    pub fn sqrt(const self) -> F512 {
        return F512::from_bits(sf_op(F512::fmt_(), SF_OP_SQRT, self.bits, 0, 0))
    }

    /// self * b + c, rounded once.
    pub fn fma(const self, const b: F512, const c: F512) -> F512 {
        return F512::from_bits(sf_op(F512::fmt_(), SF_OP_FMA, self.bits, b.bits, c.bits))
    }

    /// |self|: the sign bit cleared.
    pub fn abs(const self) -> F512 {
        return F512::from_bits(self.bits & ~((1 as u512) << 511))
    }

    /// self's magnitude with s's sign.
    pub fn copysign(const self, const s: F512) -> F512 {
        var m: u512 = (1 as u512) << 511
        return F512::from_bits(self.bits & ~m | s.bits & m)
    }

    // --- comparison: IEEE, a NaN is unordered with everything ---------------

    /// IEEE equality: false when either is NaN; -0 == +0.
    pub fn op == (const self, const o: F512) -> bool {
        return sf_cmp_bits(F512::fmt_(), self.bits, o.bits) == 0
    }

    /// The negation of ==: true when either is NaN.
    pub fn op != (const self, const o: F512) -> bool {
        return sf_cmp_bits(F512::fmt_(), self.bits, o.bits) != 0
    }

    /// IEEE less-than: false when unordered.
    pub fn op < (const self, const o: F512) -> bool {
        return sf_cmp_bits(F512::fmt_(), self.bits, o.bits) == -1
    }

    /// IEEE less-or-equal: false when unordered.
    pub fn op <= (const self, const o: F512) -> bool {
        var c = sf_cmp_bits(F512::fmt_(), self.bits, o.bits)
        return c == -1 || c == 0
    }

    /// IEEE greater-than: false when unordered.
    pub fn op > (const self, const o: F512) -> bool {
        return sf_cmp_bits(F512::fmt_(), self.bits, o.bits) == 1
    }

    /// IEEE greater-or-equal: false when unordered.
    pub fn op >= (const self, const o: F512) -> bool {
        var c = sf_cmp_bits(F512::fmt_(), self.bits, o.bits)
        return c == 1 || c == 0
    }

    /// Whether either is a NaN (IEEE's unordered predicate).
    pub fn is_unordered(const self, const o: F512) -> bool {
        return sf_cmp_bits(F512::fmt_(), self.bits, o.bits) == 2
    }

    // --- classification -----------------------------------------------------

    /// Whether self is a NaN.
    pub fn is_nan(const self) -> bool {
        return sf_class_bits(F512::fmt_(), self.bits) == SF_NAN
    }

    /// Whether self is an infinity.
    pub fn is_infinite(const self) -> bool {
        return sf_class_bits(F512::fmt_(), self.bits) == SF_INF
    }

    /// Whether self is neither infinite nor NaN.
    pub fn is_finite(const self) -> bool {
        return sf_class_bits(F512::fmt_(), self.bits) < SF_INF
    }

    /// Whether self is +0 or -0.
    pub fn is_zero(const self) -> bool {
        return sf_class_bits(F512::fmt_(), self.bits) == SF_ZERO
    }

    /// Whether self is subnormal (nonzero, below the smallest normal).
    pub fn is_subnormal(const self) -> bool {
        return sf_subnormal_bits(F512::fmt_(), self.bits)
    }

    /// Whether self is normal (finite, nonzero, not subnormal).
    pub fn is_normal(const self) -> bool {
        return sf_class_bits(F512::fmt_(), self.bits) == SF_FINITE && !self.is_subnormal()
    }

    /// Whether the sign bit is set (-0.0 and negative NaNs included).
    pub fn is_sign_negative(const self) -> bool {
        return self.bits >> 511 != 0
    }

    // --- limits ---------------------------------------------------------------

    /// +infinity.
    pub static fn infinity() -> F512 {
        return F512::from_bits(F512::exp_mask_())
    }

    /// -infinity.
    pub static fn neg_infinity() -> F512 {
        return F512::from_bits(F512::exp_mask_() | (1 as u512) << 511)
    }

    /// The canonical quiet NaN.
    pub static fn nan() -> F512 {
        return F512::from_bits(F512::exp_mask_() | (1 as u512) << 487)
    }

    /// The largest finite value.
    pub static fn max() -> F512 {
        return F512::from_bits(F512::exp_mask_() - 1)
    }

    /// The smallest positive normal value.
    pub static fn min_positive() -> F512 {
        return F512::from_bits((1 as u512) << 488)
    }

    /// The smallest positive subnormal value.
    pub static fn min_subnormal() -> F512 {
        return F512::from_bits(1)
    }

    /// The gap between 1.0 and the next value up: 2^-488.
    pub static fn epsilon() -> F512 {
        return F512::from_bits(((4194303 - 488) as u512) << 488)
    }

    priv inline static fn exp_mask_() -> u512 {
        return ((1 as u512) << 23) - 1 << 488
    }
}
