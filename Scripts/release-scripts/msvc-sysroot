$XwinSha256 = @{
    'x86_64-unknown-linux-musl'  = 'd870eb4b2f390878af6da1ccd3cf321d22fcb72720984853b4be732ae597fc88'
    'aarch64-unknown-linux-musl' = '6d56d28537a86f37aa3d041318898f25ee3100c6b6ec332ad873c28faf37be23'
    'x86_64-pc-windows-msvc'     = '96e83665ef5c1406aabd0be603a8d08e67e604f36fda630b6807ee948a614e26'
}
$MsvcLicenseUrl = 'https://go.microsoft.com/fwlink/?LinkId=2086102'
