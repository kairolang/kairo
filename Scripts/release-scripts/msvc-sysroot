# The xwin asset that runs on this host, or $null. Windows on ARM takes the
# x86_64 build: Windows 11 runs x64 binaries under emulation, and xwin only
# downloads and copies files, so speed does not matter. (Windows 10 on ARM
# cannot; there xwin fails to start and the message points at cargo.)
function Xwin-HostAsset {
    if ($OnWindows) {
        $cpu = if ($env:PROCESSOR_ARCHITEW6432) { $env:PROCESSOR_ARCHITEW6432 } else { $env:PROCESSOR_ARCHITECTURE }
        if ($cpu -eq 'AMD64' -or $cpu -eq 'ARM64') { return 'x86_64-pc-windows-msvc' }
        return $null
    }
    if ($IsLinux) {
        $cpu = [string][System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture
        if ($cpu -eq 'X64') { return 'x86_64-unknown-linux-musl' }
        if ($cpu -eq 'Arm64') { return 'aarch64-unknown-linux-musl' }
