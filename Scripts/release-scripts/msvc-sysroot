#!/usr/bin/env bash
set "x\" <# " "$@"
shift
# msvc-sysroot: build a windows-msvc sysroot (x86_64, aarch64 a.k.a. arm64,
# i686 a.k.a. i386) for this Kairo install from YOUR copy of the Microsoft CRT
# and Windows SDK, plus libc++ and compiler-rt builtins compiled against it
# from the LLVM runtimes source that ships in <install>/share/kairo/runtimes.
#
# ONE file for sh/bash (Linux, WSL, macOS) and PowerShell (Windows PowerShell
# 5.1, pwsh 7 on any OS); it ships as scripts/msvc-sysroot.sh and
# scripts/msvc-sysroot.ps1, which are identical. Line 2 is a harmless `set`
# to sh (the arguments come back with the shift), while PowerShell starts a
# block comment there that ends below the sh half. So: never write the
# PowerShell block-comment close marker in the sh half, and keep the file
# ASCII with LF line endings.
#
# Kairo cannot ship these roots: Microsoft's license forbids redistributing
# the CRT and SDK. Two ways to get your own copy:
#
#  * Windows, with Visual Studio or the Build Tools installed (the "Desktop
#    development with C++" workload, which brings the Windows SDK): nothing to
#    fetch. The PowerShell half finds them with vswhere and the registry.
#
#      powershell -ExecutionPolicy Bypass -File <install>\scripts\msvc-sysroot.ps1 x86_64
#
#  * Any host: an xwin splat (github.com/Jake-Shadle/xwin), which downloads
#    the CRT and SDK from Microsoft. The script does this for you:
#
#      <install>/scripts/msvc-sysroot.sh x86_64          (or: aarch64 i686)
#      <install>\scripts\msvc-sysroot.ps1 x86_64
#
#    It shows Microsoft's license and asks you to accept it (--accept-license
#    or KAIRO_ACCEPT_MSVC_LICENSE=1 accept it up front, for CI; a
#    non-interactive run without either stops), then uses xwin from
#    $XWIN_BIN, else PATH, else <install>/share/kairo/tools/xwin-<ver>/, else
#    downloads the pinned xwin release for this host into that directory and
#    checks its sha256. The splat lands in <install>/share/kairo/msvc-cache/
#    and is reused by later runs (re-splatted when an arch is missing). xwin
#    publishes no macOS build: there the script builds it with cargo
#    (https://rustup.rs) when cargo is on PATH. Or bring your own splat:
#
#      xwin --accept-license --arch x86_64,aarch64,x86 splat --output ~/xwin
#      XWIN=~/xwin <install>/scripts/msvc-sysroot.sh x86_64
#      $env:XWIN = "$HOME\xwin"; <install>\scripts\msvc-sysroot.ps1 x86_64
#
#    On a case-insensitive filesystem (the macOS default) add
#    --disable-symlinks to your own splat: its case-variant links
#    (Windows.h -> windows.h) would collide. The script's splat does.
#
#    Fetching needs tar, gzip, curl or wget, and sha256sum or shasum (sh), or
#    tar.exe (Windows 10 1803+ ships it), Invoke-WebRequest and Get-FileHash
#    (PowerShell); all are checked before anything is downloaded.
#
# Then `kairo --target x86_64-windows-msvc main.k -o main.exe` finds the root
# with no flags.
#
# Two layers, one directory (<root> = <install>/sysroot/<arch>-windows-msvc):
#   <root>/msvc/                  Microsoft CRT + SDK, copied from the splat or
#                                 the installed VC tools and Windows Kits.
#                                 SYSROOT.toml lists it in local_only.
#   <root>/include/c++/v1, lib/, compiler-rt/
#                                 libc++ and builtins, built here (LLVM 22,
#                                 Apache-2.0 WITH LLVM-exception).
#
# Header order matters: include/c++/v1, then clang's resource headers, then
# the CRT/SDK dirs. The UCRT's stddef.h lacks max_align_t, and searched before
# clang's it hides the one libc++ needs. Kairo orders include_dirs that way
# (c++ dirs, resource dir, the rest); the build below uses -idirafter for the
# same effect.
#
# Static CRT (/MT: libcmt + libvcruntime + libucrt): a Kairo binary needs no
# vcruntime140.dll / VC++ redistributable on the target. libc++ uses the
# vcruntime ABI (exceptions/RTTI come from vcruntime), so there is no
# libc++abi or libunwind here.
#
# libc++ is compiled with _CRT_STDIO_ISO_WIDE_SPECIFIERS, and the UCRT stamps
# every object with /failifmismatch on it: every TU linked against this
# sysroot must define it too (SYSROOT.toml cc_defines), or the link refuses.
#
# Toolchain: only this install's own tools. kcc (the Kairo C/C++ driver)
# replaces clang and clang-cl: it compiles every C, C++ and assembly source,
# in its GNU-style driver mode with an MSVC --target. kld (-flavor link)
# replaces lld-link for the symbol probe, llvm-ar / llvm-lib archive. No host
# compiler, LLVM install or Kairo checkout is used.
#
# Fast path: a release ships the second layer prebuilt, in
# <install>/share/kairo/sdk-overlays/msvc-<arch>/ (LLVM code, so it may ship,
# unlike the CRT and SDK). When that overlay exists the script copies the CRT
# and SDK, copies the overlay beside them and writes SYSROOT.toml: seconds,
# and nothing beyond this install, the CRT and the SDK is needed.
#
# Full build (no overlay, or --from-source): about 10 minutes per arch. Host
# requirements: cmake (3.20+), ninja and python3 (the LLVM runtimes build runs
# it); bash and the usual POSIX tools for the sh half. On Windows, cmake and
# ninja may come from PATH or from Visual Studio's own copies.
#
# Usage: msvc-sysroot.sh [--from-source] [x86_64|aarch64|arm64|i686|i386 ...]   (default: all three)
#   --from-source       compile libc++ and the builtins even when an overlay exists
#   --overlay-only DIR  full build, but write only the second layer to DIR/msvc-<arch>
#                       (how a release's overlays are made: Scripts/build_sdk_overlays.py)
#   --accept-license    accept Microsoft's license for the xwin download (no prompt)
#   -h, --help          print this text
#   XWIN=...    an existing xwin splat dir (default: the script's own, see above;
#               on Windows the installed Visual Studio comes first)
#   XWIN_BIN=...  the xwin executable to run (default: PATH, then the tools cache)
#   KAIRO_ACCEPT_MSVC_LICENSE=1  same as --accept-license
#   MSVC_CACHE=...  default: <install>/share/kairo/msvc-cache (splat + xwin's downloads)
#   OUT=...     default: <install>/sysroot; each root lands in OUT/<arch>-windows-msvc
#   WORK=...    build scratch (default: <install>/.sysroot-work/msvc; removed on success)
#   JOBS=...    parallel compile jobs (default: CPU count, at most 8)
#   KEEP_WORK=1 keep the build scratch after a successful run
# (PowerShell reads the same names from $env:.)
set -euo pipefail

die() { echo "!! $*" >&2; exit 1; }

HERE="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
KAIRO="$(cd "$HERE/.." && pwd -P)"
BIN="$KAIRO/bin"
KCC="$BIN/kcc"; KLD="$BIN/kld"; LLVM_AR="$BIN/llvm-ar"; LLVM_LIB="$BIN/llvm-lib"
SRC="$KAIRO/share/kairo/runtimes"
OVERLAYS="$KAIRO/share/kairo/sdk-overlays"
STAGE="${OUT:-$KAIRO/sysroot}"
WORK="${WORK:-$KAIRO/.sysroot-work/msvc}"

FROM_SOURCE=0; OVERLAY_OUT=; ACCEPT_LICENSE=0
# Options first, then arches. Rebuilt in place (no arrays: bash 3.2 + set -u).
n=$#
while [ "$n" -gt 0 ]; do
  a="$1"; shift; n=$((n - 1))
  case "$a" in
    --from-source) FROM_SOURCE=1 ;;
    --accept-license) ACCEPT_LICENSE=1 ;;
    --overlay-only)
      [ "$n" -gt 0 ] || die "--overlay-only needs a directory"
      OVERLAY_OUT="$1"; shift; n=$((n - 1)) ;;
    # The header comment is the help: line 4 up to the first command.
    -h|--help) sed -n '4,/^set -euo pipefail/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'; exit 0 ;;
    -*) die "unknown option $a (--from-source, --overlay-only DIR, --accept-license, --help)" ;;
    *) set -- "$@" "$a" ;;
  esac
done
[ $# -eq 0 ] && set -- x86_64 aarch64 i686

# The canonical arch name (the overlay's and the root's) for any accepted spelling.
canon_arch() {
  case "$1" in
    x86_64|amd64|x64) echo x86_64 ;;
    aarch64|arm64)    echo aarch64 ;;
    i686|i386|x86)    echo i686 ;;
    *) echo "$1" ;;
  esac
}
# An arch takes the fast path when this install ships its overlay;
# --overlay-only is the full build by definition.
use_overlay() {   # $1 = canonical arch
  [ "$FROM_SOURCE" = 0 ] && [ -z "$OVERLAY_OUT" ] && [ -f "$OVERLAYS/msvc-$1/lib/libc++.lib" ]
}
NEED_BUILD=0
for a in "$@"; do use_overlay "$(canon_arch "$a")" || NEED_BUILD=1; done

for t in "$KCC" "$KLD" "$LLVM_AR" "$LLVM_LIB"; do
  [ -x "$t" ] || die "$t is missing: run this script from inside a Kairo install (<install>/scripts/msvc-sysroot.sh)"
done
for t in cp du mkdir grep; do
  command -v "$t" >/dev/null 2>&1 || die "need '$t' on PATH"
done
# The fast path copies; only a full build compiles, so only it asks for the
# build tools.
if [ "$NEED_BUILD" = 1 ]; then
  [ -f "$SRC/runtimes/CMakeLists.txt" ] || die "no LLVM runtimes source at $SRC (it ships in the release archive)"
  for t in cmake ninja python3 find tar sed; do
    command -v "$t" >/dev/null 2>&1 || die "need '$t' on PATH for the full build (cmake and ninja come from your package manager)"
  done
fi

# ---- the Microsoft half: $XWIN, else the cached splat, else xwin makes one ----
# xwin release pinned by version and by the sha256 of each asset (the GitHub
# release's own digest, its .sha256 sidecar and a fresh download all agree).
# 0.10.0 publishes exactly these three; no macOS or Windows-on-ARM binary.
XWIN_VERSION=0.10.0
xwin_asset_sha256() {   # $1 = asset triple -> pinned lowercase sha256, or nothing
  case "$1" in
    x86_64-unknown-linux-musl)  echo d870eb4b2f390878af6da1ccd3cf321d22fcb72720984853b4be732ae597fc88 ;;
    aarch64-unknown-linux-musl) echo 6d56d28537a86f37aa3d041318898f25ee3100c6b6ec332ad873c28faf37be23 ;;
    x86_64-pc-windows-msvc)     echo 96e83665ef5c1406aabd0be603a8d08e67e604f36fda630b6807ee948a614e26 ;;
  esac
}
MSVC_LICENSE_URL="https://go.microsoft.com/fwlink/?LinkId=2086102"
TOOLS="$KAIRO/share/kairo/tools"
MSVC_CACHE="${MSVC_CACHE:-$KAIRO/share/kairo/msvc-cache}"
HOST_OS="$(uname -s 2>/dev/null || echo unknown)"
HOST_CPU="$(uname -m 2>/dev/null || echo unknown)"

# The command that installs $1 on this host, for a "need X" message.
pkg_hint() {
  case "$HOST_OS" in
    Darwin) echo "brew install $1 (Homebrew) or sudo port install $1 (MacPorts)" ;;
    FreeBSD) echo "pkg install $1" ;;
    MINGW*|MSYS*) echo "pacman -S $1 (MSYS2), or run msvc-sysroot.ps1 from PowerShell instead" ;;
    CYGWIN*) echo "the Cygwin installer (package $1), or run msvc-sysroot.ps1 from PowerShell instead" ;;
    *)
      if command -v apt-get >/dev/null 2>&1; then echo "sudo apt-get install $1"
      elif command -v dnf >/dev/null 2>&1; then echo "sudo dnf install $1"
      elif command -v pacman >/dev/null 2>&1; then echo "sudo pacman -S $1"
      elif command -v zypper >/dev/null 2>&1; then echo "sudo zypper install $1"
      elif command -v apk >/dev/null 2>&1; then echo "apk add $1"
      else echo "your package manager (package $1)"
      fi ;;
  esac
}
have() { command -v "$1" >/dev/null 2>&1; }

# The xwin asset that runs on this host, or nothing.
xwin_host_asset() {
  case "$HOST_OS-$HOST_CPU" in
    Linux-x86_64|Linux-amd64)  echo x86_64-unknown-linux-musl ;;
    Linux-aarch64|Linux-arm64) echo aarch64-unknown-linux-musl ;;
    MINGW*-x86_64|MSYS*-x86_64|CYGWIN*-x86_64) echo x86_64-pc-windows-msvc ;;
  esac
}
XWIN_EXE=xwin
case "$HOST_OS" in MINGW*|MSYS*|CYGWIN*) XWIN_EXE=xwin.exe ;; esac
XWIN_TOOL_DIR="$TOOLS/xwin-$XWIN_VERSION"

# The requested arches in xwin's spelling, for --arch and the reuse check.
XWIN_ARCHES=
add_xwin_arch() {
  case ",$XWIN_ARCHES," in
    *",$1,"*) ;;
    *) XWIN_ARCHES="${XWIN_ARCHES:+$XWIN_ARCHES,}$1" ;;
  esac
}
for a in "$@"; do
  case "$(canon_arch "$a")" in
    x86_64) add_xwin_arch x86_64 ;; aarch64) add_xwin_arch aarch64 ;; i686) add_xwin_arch x86 ;;
    *) die "unknown arch $a (x86_64, aarch64/arm64, i686/i386)" ;;
  esac
done

# A splat is usable when it has the SDK headers and every requested arch's CRT.
splat_has_arches() {   # $1 = splat dir
  [ -f "$1/sdk/include/um/Windows.h" ] || [ -f "$1/sdk/include/um/windows.h" ] || return 1
  for sa in $(echo "$XWIN_ARCHES" | tr ',' ' '); do
    [ -d "$1/crt/lib/$sa" ] || return 1
  done
  return 0
}

# Microsoft's license is the user's to accept, never ours: an explicit flag or
# variable, or a yes typed at a terminal. A CI job with neither stops here
# rather than hanging on a prompt nobody can answer.
accept_msvc_license() {
  if [ "$ACCEPT_LICENSE" = 1 ] || [ "${KAIRO_ACCEPT_MSVC_LICENSE:-0}" = 1 ]; then
    echo ">> Microsoft license accepted (--accept-license / KAIRO_ACCEPT_MSVC_LICENSE=1): $MSVC_LICENSE_URL"
    return 0
  fi
  cat >&2 <<EOF

  The MSVC CRT and the Windows SDK are Microsoft software. xwin downloads them
  from Microsoft's servers for you, under Microsoft's license terms (the
  license xwin asks you to accept):

      $MSVC_LICENSE_URL

  The copy is for your own use on this machine. Kairo does not ship it, and
  the license does not let you redistribute it.

EOF
  [ -t 0 ] || die "Microsoft's license was not accepted, and there is no terminal to ask at. Read it ($MSVC_LICENSE_URL), then re-run with --accept-license or KAIRO_ACCEPT_MSVC_LICENSE=1."
  printf 'Do you accept the license? [y/N] ' >&2
  ans=
  read -r ans || ans=
  case "$ans" in
    y|Y|yes|Yes|YES) ;;
    *) die "license not accepted; nothing was downloaded" ;;
  esac
}

fetch_url() {   # $1 = url, $2 = output file
  if have curl; then curl -fsSL --retry 3 --proto '=https' -o "$2" "$1"
  else wget -q -O "$2" "$1"
  fi
}
sha256_of() {   # $1 = file -> lowercase hex
  if have sha256sum; then sha256sum "$1"; else shasum -a 256 "$1"; fi \
    | cut -d' ' -f1 | tr 'ABCDEF' 'abcdef'
}

# Downloads, verifies and unpacks the pinned xwin into $XWIN_TOOL_DIR. The
# directory appears only complete (built as .tmp, then moved), so a broken
# run never leaves something the next one would take for a cached xwin.
install_xwin() {
  asset="$(xwin_host_asset)"
  want="$(xwin_asset_sha256 "$asset")"
  tmp="$XWIN_TOOL_DIR.tmp"
  rm -rf "$tmp"; mkdir -p "$tmp"
  if [ -n "$want" ]; then
    url="https://github.com/Jake-Shadle/xwin/releases/download/$XWIN_VERSION/xwin-$XWIN_VERSION-$asset.tar.gz"
    echo ">> downloading xwin $XWIN_VERSION ($asset)"
    fetch_url "$url" "$tmp/xwin.tar.gz" || die "could not download $url"
    got="$(sha256_of "$tmp/xwin.tar.gz")"
    [ "$got" = "$want" ] || die "xwin download failed its checksum: got sha256 $got, pinned $want ($url)"
    tar -xzf "$tmp/xwin.tar.gz" -C "$tmp" || die "could not unpack $tmp/xwin.tar.gz"
    mv "$tmp/xwin-$XWIN_VERSION-$asset/$XWIN_EXE" "$tmp/$XWIN_EXE" || die "the xwin archive has no $XWIN_EXE"
    rm -rf "$tmp/xwin.tar.gz" "$tmp/xwin-$XWIN_VERSION-$asset"
  else
    # No release binary for this host (macOS, Windows on ARM, BSD): build
    # the same pinned version from crates.io.
    echo ">> building xwin $XWIN_VERSION with cargo (no release binary for $HOST_OS $HOST_CPU)"
    cargo install xwin --version "$XWIN_VERSION" --locked --root "$tmp/cargo" \
      || die "cargo install xwin $XWIN_VERSION failed"
    mv "$tmp/cargo/bin/$XWIN_EXE" "$tmp/$XWIN_EXE" || die "cargo installed no $XWIN_EXE"
    rm -rf "$tmp/cargo"
  fi
  chmod +x "$tmp/$XWIN_EXE"
  rm -rf "$XWIN_TOOL_DIR"; mv "$tmp" "$XWIN_TOOL_DIR"
}

if [ -n "${XWIN:-}" ]; then
  # Your own splat: you accepted the license when you ran xwin.
  XWIN="$(cd "$XWIN" && pwd -P)" || die "XWIN=$XWIN does not exist"
elif splat_has_arches "$MSVC_CACHE/splat"; then
  XWIN="$(cd "$MSVC_CACHE/splat" && pwd -P)"
  echo ">> CRT + SDK: cached splat $XWIN"
else
  # Every tool this needs is checked before anything is downloaded or asked.
  if [ -n "${XWIN_BIN:-}" ]; then
    [ -x "$XWIN_BIN" ] || die "XWIN_BIN=$XWIN_BIN is not an executable"
    XWIN_CMD="$XWIN_BIN"
  elif have xwin; then
    XWIN_CMD="$(command -v xwin)"
  elif [ -x "$XWIN_TOOL_DIR/$XWIN_EXE" ]; then
    XWIN_CMD="$XWIN_TOOL_DIR/$XWIN_EXE"
  else
    XWIN_CMD=
    if [ -n "$(xwin_asset_sha256 "$(xwin_host_asset)")" ]; then
      have curl || have wget || die "need curl or wget to download xwin: $(pkg_hint curl)"
      have tar || die "need 'tar' to unpack xwin: $(pkg_hint tar)"
      have gzip || die "need 'gzip' to unpack xwin: $(pkg_hint gzip)"
      have sha256sum || have shasum || die "need sha256sum or shasum to verify xwin: $(pkg_hint coreutils)"
      for t in cut tr; do have "$t" || die "need '$t' on PATH: $(pkg_hint coreutils)"; done
    else
      have cargo || die "xwin $XWIN_VERSION has no release binary for $HOST_OS $HOST_CPU. Install Rust (https://rustup.rs) so this script can build it with cargo, or run: cargo install xwin --version $XWIN_VERSION --locked, then re-run (or set XWIN_BIN=, or XWIN= to a splat)."
    fi
  fi
  accept_msvc_license
  if [ -z "$XWIN_CMD" ]; then install_xwin; XWIN_CMD="$XWIN_TOOL_DIR/$XWIN_EXE"; fi
  echo ">> xwin: $XWIN_CMD ($("$XWIN_CMD" --version 2>/dev/null || echo 'version unknown'))"
  # Re-splat with the union of what the cache had and what is asked for, so
  # adding an arch never drops one. xwin's download cache sits beside the
  # splat: a re-splat reuses it instead of downloading again.
  for sa in x86_64 aarch64 x86; do
    if [ -d "$MSVC_CACHE/splat/crt/lib/$sa" ]; then add_xwin_arch "$sa"; fi
  done
  # The case-variant symlinks (Windows.h -> windows.h) collide on a
  # case-insensitive filesystem, the macOS and Windows default.
  NOLINKS=
  case "$HOST_OS" in Darwin|MINGW*|MSYS*|CYGWIN*) NOLINKS=--disable-symlinks ;; esac
  mkdir -p "$MSVC_CACHE"
  rm -rf "$MSVC_CACHE/splat.tmp"
  echo ">> [xwin] downloading and splatting the CRT + SDK for $XWIN_ARCHES into $MSVC_CACHE (several GB, a few minutes)"
  # shellcheck disable=SC2086
  "$XWIN_CMD" --accept-license --cache-dir "$MSVC_CACHE/xwin-cache" --arch "$XWIN_ARCHES" \
    splat $NOLINKS --output "$MSVC_CACHE/splat.tmp" \
    || die "xwin splat failed (its download cache is kept in $MSVC_CACHE/xwin-cache; re-run to resume)"
  splat_has_arches "$MSVC_CACHE/splat.tmp" || die "xwin's splat in $MSVC_CACHE/splat.tmp lacks the SDK headers or a requested arch"
  rm -rf "$MSVC_CACHE/splat"; mv "$MSVC_CACHE/splat.tmp" "$MSVC_CACHE/splat"
  # The unpacked packages are moved into the splat and the rest is scratch;
  # the downloads stay for a later re-splat.
  rm -rf "$MSVC_CACHE/xwin-cache/unpack"
  XWIN="$(cd "$MSVC_CACHE/splat" && pwd -P)"
  echo ">> CRT + SDK: new splat $XWIN"
fi
[ -f "$XWIN/sdk/include/um/Windows.h" ] || [ -f "$XWIN/sdk/include/um/windows.h" ] \
  || die "$XWIN is not an xwin splat (no sdk/include/um/Windows.h): run xwin splat first"

if [ -z "${JOBS:-}" ]; then
  JOBS=$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 4)
  [ "$JOBS" -gt 8 ] && JOBS=8
fi
# kcc looks for <install>/sysroot/<target> on its own; pointing it at an empty
# root keeps the build hermetic (only the flags below reach the compiles).
NOROOT="$WORK/noroot"

# <root name> <xwin arch>  ->  SYSROOT.toml
emit_toml() {
  local triple="$1" xa="$2"
  cat >"$3" <<EOF
triple        = "$triple"
llvm_version  = "22.1.0"
family        = "windows-msvc"
sysroot       = "."
include_dirs  = ["include/c++/v1", "msvc/crt/include", "msvc/sdk/include/ucrt", "msvc/sdk/include/um", "msvc/sdk/include/shared"]
lib_dirs      = ["lib", "msvc/crt/lib/$xa", "msvc/sdk/lib/um/$xa", "msvc/sdk/lib/ucrt/$xa"]
has_libcxx    = true
static        = true
crt_startup   = []
crt_end       = []
libc_link     = ["libcmt.lib", "libvcruntime.lib", "libucrt.lib", "oldnames.lib", "kernel32.lib", "user32.lib", "advapi32.lib", "shell32.lib", "uuid.lib"]
libcxx_link   = ["libc++.lib", "libcpmt.lib"]
rtlib         = "compiler-rt"
linker        = "lld-link"
resource_dir  = "compiler-rt"
msvc_crt      = "static"
local_only    = ["msvc"]
cc_defines    = ["_CRT_STDIO_ISO_WIDE_SPECIFIERS"]
cc_isolation  = ["-nostdlibinc", "-nostdinc++"]
EOF
}

# Microsoft's half: headers for every arch, libs for this arch only. cp -a
# keeps xwin's case-variant symlinks (Windows.h -> windows.h), which is what
# lets the SDK's mixed-case #includes resolve on a case-sensitive filesystem.
stage_msvc() {   # $1 = xwin arch, $2 = dst
  local xa="$1" m="$2/msvc" d
  [ -d "$XWIN/crt/lib/$xa" ] || die "$XWIN has no crt/lib/$xa: re-run xwin with --arch including $xa"
  mkdir -p "$m/crt/lib" "$m/sdk/include" "$m/sdk/lib/um" "$m/sdk/lib/ucrt"
  cp -a "$XWIN/crt/include"             "$m/crt/"
  cp -a "$XWIN/crt/lib/$xa"             "$m/crt/lib/"
  for d in ucrt um shared winrt; do
    if [ -d "$XWIN/sdk/include/$d" ]; then cp -a "$XWIN/sdk/include/$d" "$m/sdk/include/"; fi
  done
  cp -a "$XWIN/sdk/lib/um/$xa"          "$m/sdk/lib/um/"
  cp -a "$XWIN/sdk/lib/ucrt/$xa"        "$m/sdk/lib/ucrt/"
}

# The CRT/SDK headers go AFTER clang's resource headers (see the top).
# -fms-runtime-lib=static is /MT. --target is spelled out: CMake adds it from
# *_COMPILER_TARGET only for a compiler it identifies as clang, which for ASM
# it does by the --version banner (kcc's is its own), so .S files would
# otherwise be assembled for the host.
cc_flags() {   # $1 = dst, $2 = clang triple
  local m="$1/msvc"
  # -ffile-prefix-map: the builtins embed __FILE__, and a shipped overlay must
  # not carry the build machine's paths (it also makes rebuilds comparable).
  echo "--target=$2 --sysroot=$NOROOT -fms-runtime-lib=static -ffile-prefix-map=$SRC=kairo-runtimes -idirafter $m/crt/include -idirafter $m/sdk/include/ucrt -idirafter $m/sdk/include/um -idirafter $m/sdk/include/shared"
}

# configure_build <label> <log dir> <source dir> <ninja target> <cmake args...>
configure_build() {
  local label="$1" b="$2" src="$3" target="$4"
  shift 4
  rm -rf "$b"; mkdir -p "$b"
  echo ">> [$label] configuring"
  cmake -G Ninja -S "$src" -B "$b" "$@" >"$b/configure.log" 2>&1 \
    || { tail -30 "$b/configure.log" >&2; die "[$label] configure failed ($b/configure.log)"; }
  echo ">> [$label] building (-j$JOBS)"
  ninja -C "$b" -j "$JOBS" "$target" >"$b/build.log" 2>&1 \
    || { grep -m30 -A8 "^FAILED" "$b/build.log" | grep -v "^/" >&2; die "[$label] build failed ($b/build.log)"; }
}

# The full build writes the second layer into its own directory (the
# overlay), never straight into the root: the fast path then installs a
# shipped overlay with the very same copy, so the two paths cannot drift.
build_runtimes() {   # $1 = clang triple, $2 = xwin arch, $3 = staged root (CRT/SDK headers), $4 = builtins arch, $5 = overlay dir
  local triple="$1" xa="$2" root="$3" rtarch="$4" dst="$5" out="$WORK/$1-out"
  local flags
  flags=$(cc_flags "$root" "$triple")
  rm -rf "$out"
  # kcc is a GNU-style driver, so CMake drives it like clang targeting MSVC
  # (Windows-Clang, GNU front end). try_compile stays compile-only: there is
  # no libc++ or builtins to link until this build makes them. Nothing here
  # links an executable, so no linker, rc or mt is configured.
  set -- -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$out" \
    -DCMAKE_SYSTEM_NAME=Windows -DCMAKE_SYSTEM_VERSION=10.0 \
    -DCMAKE_SYSTEM_PROCESSOR="${triple%%-*}" \
    -DCMAKE_C_COMPILER="$KCC" -DCMAKE_CXX_COMPILER="$KCC" -DCMAKE_ASM_COMPILER="$KCC" \
    -DCMAKE_C_COMPILER_TARGET="$triple" -DCMAKE_CXX_COMPILER_TARGET="$triple" \
    -DCMAKE_ASM_COMPILER_TARGET="$triple" \
    -DCMAKE_AR="$LLVM_AR" -DCMAKE_RANLIB="$BIN/llvm-ranlib" \
    -DCMAKE_C_FLAGS="$flags" -DCMAKE_CXX_FLAGS="$flags" -DCMAKE_ASM_FLAGS="$flags" \
    -DCMAKE_C_STANDARD_LIBRARIES="" -DCMAKE_CXX_STANDARD_LIBRARIES="" \
    -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY \
    -DCMAKE_POLICY_DEFAULT_CMP0091=NEW -DCMAKE_MSVC_RUNTIME_LIBRARY=MultiThreaded \
    -DLLVM_ENABLE_PER_TARGET_RUNTIME_DIR=OFF
  # compiler-rt builtins, standalone. The fork picks its MSVC source list
  # (no x87 long double, no MinGW __chkstk/_alloca, TF via clang's
  # __float128) by CMake's MSVC variable, which only a cl front end sets;
  # MSVC=ON selects it with kcc's GNU spelling. The /flags it adds are all
  # behind compiler checks, which fail for a GNU driver and add nothing.
  configure_build "$triple builtins" "$WORK/$triple-builtins" "$SRC/compiler-rt/lib/builtins" install "$@" \
    -DMSVC=ON \
    -DCOMPILER_RT_DEFAULT_TARGET_ONLY=ON \
    -DCOMPILER_RT_ENABLE_SOFTWARE_INT128=ON \
    -DCOMPILER_RT_INCLUDE_TESTS=OFF
  # libc++ (vcruntime ABI, static only) through the runtimes glue.
  configure_build "$triple libc++" "$WORK/$triple-libcxx" "$SRC/runtimes" install "$@" \
    -DLLVM_ENABLE_RUNTIMES=libcxx \
    -DLLVM_DEFAULT_TARGET_TRIPLE="$triple" \
    -DLLVM_INCLUDE_TESTS=OFF -DLLVM_INCLUDE_DOCS=OFF \
    -DLIBCXX_CXX_ABI=vcruntime \
    -DLIBCXX_ENABLE_SHARED=OFF -DLIBCXX_ENABLE_STATIC=ON \
    -DLIBCXX_INCLUDE_TESTS=OFF -DLIBCXX_INCLUDE_BENCHMARKS=OFF \
    -DLIBCXX_INCLUDE_DOCS=OFF
  local b="$WORK/$triple-builtins"

  # The GNU front end may name the archives lib*.a; the root's names are the
  # ones SYSROOT.toml and the driver expect.
  local cxx rt
  cxx=$(find "$out" -type f \( -name 'libc++.lib' -o -name 'c++.lib' -o -name 'libc++.a' \) | head -1)
  rt=$(find "$out" -type f \( -name 'clang_rt.builtins*.lib' -o -name 'libclang_rt.builtins*.a' \) | head -1)
  [ -n "$cxx" ] && [ -n "$rt" ] || die "[$triple] runtimes incomplete (libc++: '$cxx', builtins: '$rt')"
  [ -d "$out/include/c++/v1" ] || die "[$triple] no libc++ headers installed"
  mkdir -p "$dst/include" "$dst/lib" "$dst/compiler-rt/lib/windows"
  cp -a "$out/include/c++" "$dst/include/"
  cp "$cxx" "$dst/lib/libc++.lib"
  rt_lib="$dst/compiler-rt/lib/windows/clang_rt.builtins-$rtarch.lib"
  cp "$rt" "$rt_lib"
  add_tf_compare_aliases "$triple" "$root" "$rt_lib" "$b"
  probe_builtins "$triple" "$rt_lib" "$b" \
    __addtf3 __trunctfbf2 __truncsfbf2 __eqtf2 __netf2 __lttf2 __gttf2 __cmptf2
  grep '_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS' "$dst/include/c++/v1/__config_site" >/dev/null \
    || die "[$triple] __config_site is not static-only (would import __imp_ symbols)"
}

# comparetf2.c defines __letf2 / __getf2 and makes __eqtf2, __lttf2, __netf2,
# __gttf2 (and __cmptf2) aliases of them. COMPILER_RT_ALIAS expands to nothing
# on _WIN32 (COFF has no symbol aliases), so on these targets those names do
# not exist and any f128 comparison fails to link (undefined __netf2). Add
# them as forwarding functions, built with the same headers so CMP_RESULT and
# fp_t match, into the builtins archive.
add_tf_compare_aliases() {   # $1 = triple, $2 = dst, $3 = builtins .lib (rewritten), $4 = build dir
  local triple="$1" dst="$2" lib="$3" w="$4/tf-compare-aliases"
  local B="$SRC/compiler-rt/lib/builtins"
  mkdir -p "$w"
  cat >"$w/tf_compare_aliases.c" <<'EOC'
#define QUAD_PRECISION
#include "fp_lib.h"
#if defined(CRT_HAS_TF_MODE)
#include "fp_compare_impl.inc"
COMPILER_RT_ABI CMP_RESULT __letf2(fp_t a, fp_t b);
COMPILER_RT_ABI CMP_RESULT __getf2(fp_t a, fp_t b);
COMPILER_RT_ABI CMP_RESULT __cmptf2(fp_t a, fp_t b) { return __letf2(a, b); }
COMPILER_RT_ABI CMP_RESULT __eqtf2(fp_t a, fp_t b) { return __letf2(a, b); }
COMPILER_RT_ABI CMP_RESULT __lttf2(fp_t a, fp_t b) { return __letf2(a, b); }
COMPILER_RT_ABI CMP_RESULT __netf2(fp_t a, fp_t b) { return __letf2(a, b); }
COMPILER_RT_ABI CMP_RESULT __gttf2(fp_t a, fp_t b) { return __getf2(a, b); }
#else
#error "no TF mode: __float128 / int128 missing on this target"
#endif
EOC
  # shellcheck disable=SC2046
  "$KCC" $(cc_flags "$dst" "$triple") -fforce-enable-int128 -O2 -I"$B" \
    -c "$w/tf_compare_aliases.c" -o "$w/tf_compare_aliases.obj" \
    || die "[$triple] tf_compare_aliases.c failed to compile"
  # From inside $w: llvm-lib names a member by the path it was given, and a
  # shipped overlay must not carry the build machine's paths.
  (cd "$w" && "$LLVM_LIB" /nologo /out:merged.lib "$lib" tf_compare_aliases.obj) \
    || die "[$triple] llvm-lib could not merge the compare aliases"
  mv "$w/merged.lib" "$lib"
}

# Symbol check without nm: a probe that takes the address of every required
# builtin, linked by kld (lld-link flavor) against the builtins archive alone.
# An undefined symbol fails the link, which is exactly "the archive lacks it".
probe_builtins() {   # $1 = triple, $2 = builtins .lib, $3 = build dir, $4... = symbols
  local triple="$1" lib="$2" w="$3/probe" mach s
  shift 3
  case "$triple" in
    x86_64-*) mach=x64 ;; aarch64-*) mach=arm64 ;; i686-*) mach=x86 ;;
  esac
  mkdir -p "$w"
  {
    # The CRT's float marker, which every float-using object references.
    echo "int _fltused = 0;"
    for s in "$@"; do echo "extern void $s(void);"; done
    echo "__declspec(dllexport) void *const kairo_probe[] = {"
    for s in "$@"; do echo "  (void *)&$s,"; done
    echo "};"
  } >"$w/probe.c"
  "$KCC" --target="$triple" --sysroot="$NOROOT" -O0 -c "$w/probe.c" -o "$w/probe.obj" \
    || die "[$triple] symbol probe failed to compile"
  "$KLD" -flavor link /nologo /dll /noentry /nodefaultlib /machine:"$mach" \
    /out:"$w/probe.dll" "$w/probe.obj" "$lib" >"$w/probe.log" 2>&1 \
    || { cat "$w/probe.log" >&2; die "[$triple] builtins lack a required symbol (TF/bf16 routines compiled empty?)"; }
}

# The Kairo-shaped check: C++ with a thrown and caught exception, compiled
# and linked by kcc from SYSROOT.toml alone (no include or library flags).
validate() {   # $1 = root name, $2 = dst
  local name="$1" r="$2" t="$WORK/$1-test"
  mkdir -p "$t"
  cat >"$t/t.cpp" <<'EOF'
#include <cstdio>
#include <stdexcept>
#include <string>
#include <vector>
int main() {
  std::vector<std::string> v{"a", "b"};
  try { throw std::runtime_error(v[0] + v[1]); }
  catch (const std::exception &e) { std::printf("%s\n", e.what()); }
  return 0;
}
EOF
  "$KCC" --target="$name" --sysroot="$r" -std=c++20 -O1 "$t/t.cpp" -o "$t/t.exe" >"$t/link.log" 2>&1 \
    || { cat "$t/link.log" >&2; die "[$name] validation link failed (kcc --target=$name --sysroot=$r)"; }
  echo "   validated: kcc linked a C++ program from SYSROOT.toml ($t/t.exe)"
}

# copy_overlay <overlay dir> <root>: cp -R, not tar (the fast path asks for no
# more than cp). The root holds only msvc/ at this point, so nothing merges.
copy_overlay() {
  local d
  for d in include lib compiler-rt; do
    cp -R "$1/$d" "$2/" || die "could not copy $1/$d"
  done
}

echo ">> install: $KAIRO"
if [ "$NEED_BUILD" = 1 ]; then
  echo ">> runtimes source: $SRC (rev $(cat "$SRC/REVISION" 2>/dev/null || echo unknown))"
fi
for arch in "$@"; do
  case "$arch" in
    x86_64|amd64|x64) arch=x86_64;  xa=x86_64;  rtarch=x86_64 ;;
    aarch64|arm64)    arch=aarch64; xa=aarch64; rtarch=aarch64 ;;
    i686|i386|x86)    arch=i686;    xa=x86;     rtarch=i386 ;;
    *) die "unknown arch $arch (x86_64, aarch64/arm64, i686/i386)" ;;
  esac
  triple="$arch-pc-windows-msvc"
  name="$arch-windows-msvc"
  dst="$STAGE/$name"
  if [ -n "$OVERLAY_OUT" ]; then dst="$WORK/$name"; fi
  echo ">> [$name] staging from $XWIN -> $dst"
  # Assembled under WORK and moved into place only when complete: kcc picks
  # up <install>/sysroot/<name> by itself (ahead of --sysroot), so neither an
  # old root nor a half-built one may sit there during the build.
  root="$WORK/$name-root"
  rm -rf "$dst" "$root"; mkdir -p "$root" "$NOROOT"
  stage_msvc "$xa" "$root"
  if use_overlay "$arch"; then
    ov="$OVERLAYS/msvc-$arch"
    echo ">> [$name] prebuilt libc++ + builtins: $ov (rev $(cat "$OVERLAYS/REVISION" 2>/dev/null || echo unknown))"
  else
    ov="$WORK/overlay-$arch"
    rm -rf "$ov"; mkdir -p "$ov"
    build_runtimes "$triple" "$xa" "$root" "$rtarch" "$ov"
  fi
  copy_overlay "$ov" "$root"
  grep '_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS' "$root/include/c++/v1/__config_site" >/dev/null \
    || die "[$name] __config_site is not static-only (would import __imp_ symbols)"
  emit_toml "$name" "$xa" "$root/SYSROOT.toml"
  mkdir -p "$(dirname "$dst")"; mv "$root" "$dst"
  validate "$name" "$dst"
  if [ -n "$OVERLAY_OUT" ]; then
    # Only the second layer leaves WORK; the CRT/SDK-bearing root is scratch.
    mkdir -p "$OVERLAY_OUT"; rm -rf "$OVERLAY_OUT/msvc-$arch"; mkdir -p "$OVERLAY_OUT/msvc-$arch"
    copy_overlay "$ov" "$OVERLAY_OUT/msvc-$arch"
    rm -rf "$dst"
    echo ">> [$name] overlay written: $OVERLAY_OUT/msvc-$arch ($(du -sh "$OVERLAY_OUT/msvc-$arch" | cut -f1))"
    continue
  fi
  echo ">> [$name] staged ($(du -sh "$dst" | cut -f1))"
done
if [ "${KEEP_WORK:-0}" != 1 ]; then rm -rf "$WORK"; rmdir "$(dirname "$WORK")" 2>/dev/null || true; fi
echo "msvc sysroots ready. Try: kairo --target ${name:-x86_64-windows-msvc} main.k -o main.exe"
echo "(They contain Microsoft's CRT and SDK: keep them local, never redistribute them.)"
exit 0
