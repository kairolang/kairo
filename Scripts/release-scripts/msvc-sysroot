# A splat is usable when it has the SDK headers and every requested arch's CRT.
function Splat-HasArches([string]$d) {
    if (-not ((Test-Path -LiteralPath (Join-Path $d 'sdk/include/um/Windows.h')) -or
              (Test-Path -LiteralPath (Join-Path $d 'sdk/include/um/windows.h')))) { return $false }
    foreach ($sa in $XwinArches) { if (-not (Test-Path -LiteralPath (Join-Path $d "crt/lib/$sa"))) { return $false } }
    return $true
}

# The command that installs $what on this host, for a "need X" message.
function Pkg-Hint([string]$what) {
    if ($OnWindows) { return "Windows 10 1803+ ships tar.exe in System32; on older Windows put a tar on PATH (Git for Windows has one)" }
    if ($OnMac) { return "brew install $what (Homebrew)" }
    foreach ($pm in @(@('apt-get', 'sudo apt-get install'), @('dnf', 'sudo dnf install'), @('pacman', 'sudo pacman -S'),
                      @('zypper', 'sudo zypper install'), @('apk', 'apk add'))) {
        if (Find-Program $pm[0] @()) { return "$($pm[1]) $what" }
    }
    return "your package manager (package $what)"
}

