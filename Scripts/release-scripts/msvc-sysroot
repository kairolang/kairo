#>
# ---------------------------------------------------------------------------------------
# PowerShell half (Windows PowerShell 5.1 and pwsh 7, any OS). Everything above is a
# comment here. Same steps, same layout and the same SYSROOT.toml as the sh half; on
# Windows it can also take the CRT and SDK from the installed Visual Studio + Windows Kits.
# ---------------------------------------------------------------------------------------
$ErrorActionPreference = 'Stop'

function Die([string]$m) { [Console]::Error.WriteLine("!! $m"); exit 1 }

$OnWindows = ($PSVersionTable.PSVersion.Major -lt 6) -or $IsWindows
$Kairo = (Resolve-Path -LiteralPath (Join-Path (Split-Path -Parent $PSCommandPath) '..')).Path
