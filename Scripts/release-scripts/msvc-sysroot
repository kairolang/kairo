    foreach ($l in $notice) { [Console]::Error.WriteLine($l) }
    if ([Console]::IsInputRedirected -or -not [Environment]::UserInteractive) {
        Die "Microsoft's license was not accepted, and there is no console to ask at. Read it ($MsvcLicenseUrl), then re-run with --accept-license or `$env:KAIRO_ACCEPT_MSVC_LICENSE = '1'."
    }
    $ans = Read-Host 'Do you accept the license? [y/N]'
    if ($ans -notmatch '^(y|yes)$') { Die 'license not accepted; nothing was downloaded' }
}

# Downloads, verifies and unpacks the pinned xwin into $XwinToolDir, which
# appears only complete (built as .tmp, then moved), so a broken run never
# leaves something the next one would take for a cached xwin.
function Install-Xwin([string]$asset) {
    $tmp = "$XwinToolDir.tmp"
    if (Test-Path -LiteralPath $tmp) { Remove-Item -LiteralPath $tmp -Recurse -Force }
    New-Item -ItemType Directory -Force -Path $tmp | Out-Null
    if ($asset) {
        $url = "https://github.com/Jake-Shadle/xwin/releases/download/$XwinVersion/xwin-$XwinVersion-$asset.tar.gz"
        $tgz = Join-Path $tmp 'xwin.tar.gz'
        Write-Host ">> downloading xwin $XwinVersion ($asset)"
        # Windows PowerShell 5.1 defaults to TLS 1.0, which GitHub refuses, and
        # its progress bar slows the download to a crawl.
        [Net.ServicePointManager]::SecurityProtocol = [Net.ServicePointManager]::SecurityProtocol -bor [Net.SecurityProtocolType]::Tls12
        $oldProgress = $ProgressPreference; $ProgressPreference = 'SilentlyContinue'
        try { Invoke-WebRequest -Uri $url -OutFile $tgz -UseBasicParsing }
        catch { Die "could not download $url ($($_.Exception.Message))" }
        finally { $ProgressPreference = $oldProgress }
        $got = (Get-FileHash -LiteralPath $tgz -Algorithm SHA256).Hash.ToLowerInvariant()
        $want = $XwinSha256[$asset]
        if ($got -ne $want) { Die "xwin download failed its checksum: got sha256 $got, pinned $want ($url)" }
        Run 'unpack xwin' $Tar @('-xzf', $tgz, '-C', $tmp) $null
        Move-Item -LiteralPath (Join-Path $tmp "xwin-$XwinVersion-$asset/$XwinExe") -Destination (Join-Path $tmp $XwinExe)
        Remove-Item -LiteralPath $tgz, (Join-Path $tmp "xwin-$XwinVersion-$asset") -Recurse -Force
    } else {
        # No release binary for this host (macOS, Linux on another CPU): build
        # the same pinned version from crates.io.
        Write-Host ">> building xwin $XwinVersion with cargo (no release binary for this host)"
        Run "cargo install xwin $XwinVersion" $Cargo @('install', 'xwin', '--version', $XwinVersion, '--locked', '--root', (Join-Path $tmp 'cargo')) $null
        Move-Item -LiteralPath (Join-Path $tmp "cargo/bin/$XwinExe") -Destination (Join-Path $tmp $XwinExe)
        Remove-Item -LiteralPath (Join-Path $tmp 'cargo') -Recurse -Force
    }
    if (-not $OnWindows) { Run 'chmod xwin' 'chmod' @('+x', (Join-Path $tmp $XwinExe)) $null }
    if (Test-Path -LiteralPath $XwinToolDir) { Remove-Item -LiteralPath $XwinToolDir -Recurse -Force }
    Move-Item -LiteralPath $tmp -Destination $XwinToolDir
}

$MsSplat = Join-Path $MsvcCache 'splat'
if ($Xwin) {
    # Your own splat: you accepted the license when you ran xwin.
    $Xwin = (Resolve-Path -LiteralPath $Xwin).Path
    if (-not ((Test-Path -LiteralPath (Join-Path $Xwin 'sdk/include/um/Windows.h')) -or
              (Test-Path -LiteralPath (Join-Path $Xwin 'sdk/include/um/windows.h')))) {
        Die "$Xwin is not an xwin splat (no sdk/include/um/Windows.h): run xwin splat first"
    }
    $From = "xwin splat $Xwin"
} elseif ($VS -and (Test-Path -LiteralPath (Join-Path $VS 'VC\Auxiliary\Build\Microsoft.VCToolsVersion.default.txt'))) {
    # A Visual Studio without the C++ tools falls through to xwin below.
    $verFile = Join-Path $VS 'VC\Auxiliary\Build\Microsoft.VCToolsVersion.default.txt'
    $VcVer = (Get-Content -LiteralPath $verFile -TotalCount 1).Trim()
    $VC = Join-Path $VS "VC\Tools\MSVC\$VcVer"
    $roots = Get-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Windows Kits\Installed Roots' -ErrorAction SilentlyContinue
    if (-not $roots -or -not $roots.KitsRoot10) { Die 'no Windows 10/11 SDK found (HKLM:\SOFTWARE\Microsoft\Windows Kits\Installed Roots KitsRoot10)' }
    $Kits = $roots.KitsRoot10
    $SdkVer = Get-ChildItem -LiteralPath (Join-Path $Kits 'Include') -Directory -ErrorAction SilentlyContinue |
        Where-Object { $_.Name -match '^10\.' -and (Test-Path -LiteralPath (Join-Path $_.FullName 'um\Windows.h')) } |
        Sort-Object { [version]$_.Name } | Select-Object -Last 1
    if (-not $SdkVer) { Die "no Windows SDK version with um\Windows.h under $Kits\Include" }
    $SdkVer = $SdkVer.Name
    $From = "MSVC $VcVer + Windows SDK $SdkVer"
} elseif (Splat-HasArches $MsSplat) {
    $Xwin = (Resolve-Path -LiteralPath $MsSplat).Path
    $From = "cached xwin splat $Xwin"
} else {
    # Every tool this needs is checked before anything is downloaded or asked.
    $XwinCmd = $null; $asset = $null; $Tar = $null; $Cargo = $null
    $xb = Env 'XWIN_BIN' ''
    if ($xb) {
        if (-not (Test-Path -LiteralPath $xb -PathType Leaf)) { Die "XWIN_BIN=$xb is not a file" }
        $XwinCmd = $xb
    } elseif ($c = Find-Program 'xwin' @()) {
        $XwinCmd = $c
    } elseif (Test-Path -LiteralPath (Join-Path $XwinToolDir $XwinExe) -PathType Leaf) {
        $XwinCmd = Join-Path $XwinToolDir $XwinExe
    } else {
        $asset = Xwin-HostAsset
        if ($asset) {
            foreach ($cmd in 'Invoke-WebRequest', 'Get-FileHash') {
                if (-not (Get-Command $cmd -ErrorAction SilentlyContinue)) { Die "need $cmd (PowerShell 5.1 or later) to download xwin" }
            }
            # Windows' own bsdtar first: an MSYS tar on PATH reads C:\... as a remote host.
            $sysTar = if ($OnWindows) { Join-Path $env:SystemRoot 'System32\tar.exe' } else { '' }
            $Tar = if ($sysTar -and (Test-Path -LiteralPath $sysTar -PathType Leaf)) { $sysTar } else { Find-Program 'tar' @() }
            if (-not $Tar) { Die "need tar to unpack xwin: $(Pkg-Hint 'tar')" }
        } else {
            $Cargo = Find-Program 'cargo' @()
            if (-not $Cargo) {
                Die ("xwin $XwinVersion has no release binary for this host. Install Rust (https://rustup.rs) so this " +
                     "script can build it with cargo, or run: cargo install xwin --version $XwinVersion --locked, then " +
                     "re-run (or set `$env:XWIN_BIN, or `$env:XWIN to a splat).")
            }
        }
    }
    Accept-MsvcLicense
    if (-not $XwinCmd) { Install-Xwin $asset; $XwinCmd = Join-Path $XwinToolDir $XwinExe }
    Write-Host ">> xwin: $XwinCmd"
    # Re-splat with the union of what the cache had and what is asked for, so
    # adding an arch never drops one. xwin's download cache sits beside the
    # splat: a re-splat reuses it instead of downloading again.
    foreach ($sa in 'x86_64', 'aarch64', 'x86') {
        if ((Test-Path -LiteralPath (Join-Path $MsSplat "crt/lib/$sa")) -and ($XwinArches -notcontains $sa)) { $XwinArches += $sa }
    }
    $tmpSplat = Join-Path $MsvcCache 'splat.tmp'
    New-Item -ItemType Directory -Force -Path $MsvcCache | Out-Null
    if (Test-Path -LiteralPath $tmpSplat) { Remove-Item -LiteralPath $tmpSplat -Recurse -Force }
    $xargv = @('--accept-license', '--cache-dir', (Join-Path $MsvcCache 'xwin-cache'), '--arch', ($XwinArches -join ','), 'splat')
    # The case-variant symlinks (Windows.h -> windows.h) collide on a
    # case-insensitive filesystem (the Windows and macOS default), and Windows
    # symlinks need a privilege most users lack.
    if ($OnWindows -or $OnMac) { $xargv += '--disable-symlinks' }
    $xargv += @('--output', $tmpSplat)
    Write-Host ">> [xwin] downloading and splatting the CRT + SDK for $($XwinArches -join ',') into $MsvcCache (several GB, a few minutes)"
    Run "xwin splat (its download cache is kept in $(Join-Path $MsvcCache 'xwin-cache'); re-run to resume)" $XwinCmd $xargv $null
    if (-not (Splat-HasArches $tmpSplat)) { Die "xwin's splat in $tmpSplat lacks the SDK headers or a requested arch" }
    if (Test-Path -LiteralPath $MsSplat) { Remove-Item -LiteralPath $MsSplat -Recurse -Force }
    Move-Item -LiteralPath $tmpSplat -Destination $MsSplat
    # The unpacked packages are moved into the splat and the rest is scratch;
    # the downloads stay for a later re-splat.
    $unpack = Join-Path $MsvcCache 'xwin-cache/unpack'
    if (Test-Path -LiteralPath $unpack) { Remove-Item -LiteralPath $unpack -Recurse -Force }
    $Xwin = (Resolve-Path -LiteralPath $MsSplat).Path
    $From = "new xwin splat $Xwin"
}

$Stage = Env 'OUT' (Join-Path $Kairo 'sysroot')
$Work = Env 'WORK' (Join-Path $Kairo '.sysroot-work/msvc')
$Jobs = [int](Env 'JOBS' ([Math]::Min([Environment]::ProcessorCount, 8)))
# kcc looks for <install>/sysroot/<target> on its own; pointing it at an empty
# root keeps the build hermetic (only the flags below reach the compiles).
$NoRoot = Join-Path $Work 'noroot'

function Copy-Tree([string]$from, [string]$to) {
    if (-not (Test-Path -LiteralPath $from)) { Die "missing $from" }
    New-Item -ItemType Directory -Force -Path (Split-Path -Parent $to) | Out-Null
    if ($OnWindows) { Copy-Item -LiteralPath $from -Destination $to -Recurse -Force }
    # cp -a keeps xwin's case-variant symlinks (Windows.h -> windows.h).
    else { Run "copy $from" 'cp' @('-a', $from, $to) $null }
}

# Microsoft's half: headers for every arch, libs for this arch only. $xa is the
# xwin arch name (x86_64, aarch64, x86); $ms the VC/Kits one (x64, arm64, x86).
function Stage-Msvc([string]$xa, [string]$ms, [string]$dst) {
    $m = Join-Path $dst 'msvc'
    if ($Xwin) {
        if (-not (Test-Path -LiteralPath (Join-Path $Xwin "crt/lib/$xa"))) { Die "$Xwin has no crt/lib/$xa`: re-run xwin with --arch including $xa" }
        Copy-Tree (Join-Path $Xwin 'crt/include') (Join-Path $m 'crt/include')
        Copy-Tree (Join-Path $Xwin "crt/lib/$xa") (Join-Path $m "crt/lib/$xa")
        foreach ($d in 'ucrt', 'um', 'shared', 'winrt') {
            $s = Join-Path $Xwin "sdk/include/$d"
            if (Test-Path -LiteralPath $s) { Copy-Tree $s (Join-Path $m "sdk/include/$d") }
        }
        Copy-Tree (Join-Path $Xwin "sdk/lib/um/$xa") (Join-Path $m "sdk/lib/um/$xa")
        Copy-Tree (Join-Path $Xwin "sdk/lib/ucrt/$xa") (Join-Path $m "sdk/lib/ucrt/$xa")
    } else {
        if (-not (Test-Path -LiteralPath (Join-Path $VC "lib\$ms"))) { Die "$VC has no lib\$ms`: add the VC tools for $ms in the Visual Studio Installer" }
        Copy-Tree (Join-Path $VC 'include') (Join-Path $m 'crt/include')
        Copy-Tree (Join-Path $VC "lib\$ms") (Join-Path $m "crt/lib/$xa")
        foreach ($d in 'ucrt', 'um', 'shared', 'winrt') {
            $s = Join-Path $Kits "Include\$SdkVer\$d"
            if (Test-Path -LiteralPath $s) { Copy-Tree $s (Join-Path $m "sdk/include/$d") }
        }
        Copy-Tree (Join-Path $Kits "Lib\$SdkVer\um\$ms") (Join-Path $m "sdk/lib/um/$xa")
        Copy-Tree (Join-Path $Kits "Lib\$SdkVer\ucrt\$ms") (Join-Path $m "sdk/lib/ucrt/$xa")
    }
}

# The CRT/SDK headers go AFTER clang's resource headers (see the top). --target
# is spelled out: CMake identifies an ASM compiler as clang by its --version
# banner (kcc's is its own), so it would not add one for .S files.
function Cc-Flags([string]$dst, [string]$triple) {
    $m = Join-Path $dst 'msvc'
    # -ffile-prefix-map: the builtins embed __FILE__, and a shipped overlay must
    # not carry the build machine's paths.
    $f = @("--target=$triple", "--sysroot=$NoRoot", '-fms-runtime-lib=static', "-ffile-prefix-map=$(Fwd $Src)=kairo-runtimes")
    foreach ($d in 'crt/include', 'sdk/include/ucrt', 'sdk/include/um', 'sdk/include/shared') {
        $f += @('-idirafter', (Join-Path $m $d))
    }
    return $f
}

# The settings go through an initial-cache file, not -D: Windows PowerShell
# mangles native arguments that hold quotes, and a flags string with a path
# containing spaces needs them.
function Cmake-Quote([string]$s) { return '"' + $s.Replace('\', '/').Replace('"', '\"') + '"' }
function Configure-Build([string]$label, [string]$b, [string]$source, [hashtable]$vars) {
    if (Test-Path -LiteralPath $b) { Remove-Item -LiteralPath $b -Recurse -Force }
    New-Item -ItemType Directory -Force -Path $b | Out-Null
    $init = foreach ($k in ($vars.Keys | Sort-Object)) { "set($k $(Cmake-Quote $vars[$k]) CACHE STRING `"`" FORCE)" }
    $initFile = Join-Path $b 'kairo-init.cmake'
    [IO.File]::WriteAllText($initFile, (($init -join "`n") + "`n"))
    Write-Host ">> [$label] configuring"
    Run "[$label] configure" $CMake @('-G', 'Ninja', '-S', $source, '-B', $b, '-C', $initFile) (Join-Path $b 'configure.log')
    Write-Host ">> [$label] building (-j$Jobs)"
    Run "[$label] build" $Ninja @('-C', $b, '-j', "$Jobs", 'install') (Join-Path $b 'build.log')
}

# The full build writes the second layer into its own directory (the overlay,
# $dst), never straight into the root: the fast path then installs a shipped
# overlay with the very same copy, so the two paths cannot drift apart.
function Build-Runtimes([string]$triple, [string]$root, [string]$rtarch, [string]$dst) {
    $out = Join-Path $Work "$triple-out"
    if (Test-Path -LiteralPath $out) { Remove-Item -LiteralPath $out -Recurse -Force }
    $flags = (Cc-Flags $root $triple | ForEach-Object { if ($_ -match ' ') { '"' + (Fwd $_) + '"' } else { Fwd $_ } }) -join ' '
    # kcc is a GNU-style driver, so CMake drives it like clang targeting MSVC
    # (Windows-Clang, GNU front end). try_compile stays compile-only: there is
    # no libc++ or builtins to link until this build makes them. Nothing here
    # links an executable, so no linker, rc or mt is configured.
    $common = @{
        CMAKE_BUILD_TYPE = 'Release'; CMAKE_INSTALL_PREFIX = (Fwd $out)
        CMAKE_SYSTEM_NAME = 'Windows'; CMAKE_SYSTEM_VERSION = '10.0'
        CMAKE_SYSTEM_PROCESSOR = $triple.Split('-')[0]
        CMAKE_C_COMPILER = (Fwd $KCC); CMAKE_CXX_COMPILER = (Fwd $KCC); CMAKE_ASM_COMPILER = (Fwd $KCC)
        CMAKE_C_COMPILER_TARGET = $triple; CMAKE_CXX_COMPILER_TARGET = $triple; CMAKE_ASM_COMPILER_TARGET = $triple
        CMAKE_AR = (Fwd $LLVM_AR); CMAKE_RANLIB = (Fwd $LLVM_RANLIB)
        CMAKE_C_FLAGS = $flags; CMAKE_CXX_FLAGS = $flags; CMAKE_ASM_FLAGS = $flags
        CMAKE_C_STANDARD_LIBRARIES = ''; CMAKE_CXX_STANDARD_LIBRARIES = ''
        CMAKE_TRY_COMPILE_TARGET_TYPE = 'STATIC_LIBRARY'
        CMAKE_POLICY_DEFAULT_CMP0091 = 'NEW'; CMAKE_MSVC_RUNTIME_LIBRARY = 'MultiThreaded'
        LLVM_ENABLE_PER_TARGET_RUNTIME_DIR = 'OFF'
        CMAKE_MAKE_PROGRAM = (Fwd $Ninja)
    }
    # compiler-rt builtins, standalone. The fork picks its MSVC source list
    # (no x87 long double, no MinGW __chkstk/_alloca, TF via clang's
    # __float128) by CMake's MSVC variable, which only a cl front end sets;
    # MSVC=ON selects it with kcc's GNU spelling.
    $bt = $common.Clone()
    $bt.MSVC = 'ON'; $bt.COMPILER_RT_DEFAULT_TARGET_ONLY = 'ON'
    $bt.COMPILER_RT_ENABLE_SOFTWARE_INT128 = 'ON'; $bt.COMPILER_RT_INCLUDE_TESTS = 'OFF'
    $b = Join-Path $Work "$triple-builtins"
    Configure-Build "$triple builtins" $b (Join-Path $Src 'compiler-rt/lib/builtins') $bt
    # libc++ (vcruntime ABI, static only) through the runtimes glue.
    $cx = $common.Clone()
    $cx.LLVM_ENABLE_RUNTIMES = 'libcxx'; $cx.LLVM_DEFAULT_TARGET_TRIPLE = $triple
    $cx.LLVM_INCLUDE_TESTS = 'OFF'; $cx.LLVM_INCLUDE_DOCS = 'OFF'
    $cx.LIBCXX_CXX_ABI = 'vcruntime'; $cx.LIBCXX_ENABLE_SHARED = 'OFF'; $cx.LIBCXX_ENABLE_STATIC = 'ON'
    $cx.LIBCXX_INCLUDE_TESTS = 'OFF'; $cx.LIBCXX_INCLUDE_BENCHMARKS = 'OFF'; $cx.LIBCXX_INCLUDE_DOCS = 'OFF'
    Configure-Build "$triple libc++" (Join-Path $Work "$triple-libcxx") (Join-Path $Src 'runtimes') $cx

    # The GNU front end may name the archives lib*.a; the root's names are the
    # ones SYSROOT.toml and the driver expect.
    $files = Get-ChildItem -LiteralPath $out -Recurse -File
    $cxx = $files | Where-Object { $_.Name -in 'libc++.lib', 'c++.lib', 'libc++.a' } | Select-Object -First 1
    $rt = $files | Where-Object { $_.Name -like 'clang_rt.builtins*.lib' -or $_.Name -like 'libclang_rt.builtins*.a' } | Select-Object -First 1
    if (-not $cxx -or -not $rt) { Die "[$triple] runtimes incomplete (libc++: '$cxx', builtins: '$rt')" }
    if (-not (Test-Path -LiteralPath (Join-Path $out 'include/c++/v1'))) { Die "[$triple] no libc++ headers installed" }
    New-Item -ItemType Directory -Force -Path (Join-Path $dst 'lib'), (Join-Path $dst 'compiler-rt/lib/windows') | Out-Null
    Copy-Tree (Join-Path $out 'include/c++') (Join-Path $dst 'include/c++')
    Copy-Item -LiteralPath $cxx.FullName -Destination (Join-Path $dst 'lib/libc++.lib')
    $rtLib = Join-Path $dst "compiler-rt/lib/windows/clang_rt.builtins-$rtarch.lib"
    Copy-Item -LiteralPath $rt.FullName -Destination $rtLib
    Add-TfCompareAliases $triple $root $rtLib $b
    Probe-Builtins $triple $rtLib $b @('__addtf3', '__trunctfbf2', '__truncsfbf2', '__eqtf2', '__netf2', '__lttf2', '__gttf2', '__cmptf2')
}

# The overlay's three trees into a root that holds only msvc/ so far, so each
# target is new: Copy-Item -Recurse into an existing directory would nest it.
function Copy-Overlay([string]$ov, [string]$root) {
    foreach ($d in 'include', 'lib', 'compiler-rt') { Copy-Tree (Join-Path $ov $d) (Join-Path $root $d) }
}

# comparetf2.c makes __eqtf2, __lttf2, __netf2, __gttf2 and __cmptf2 aliases of
# __letf2 / __getf2, but COMPILER_RT_ALIAS expands to nothing on _WIN32 (COFF
# has no symbol aliases), so any f128 comparison would fail to link. Add them
# as forwarding functions into the builtins archive.
function Add-TfCompareAliases([string]$triple, [string]$dst, [string]$lib, [string]$b) {
    $w = Join-Path $b 'tf-compare-aliases'
    New-Item -ItemType Directory -Force -Path $w | Out-Null
    $c = @(
        '#define QUAD_PRECISION'
        '#include "fp_lib.h"'
        '#if defined(CRT_HAS_TF_MODE)'
        '#include "fp_compare_impl.inc"'
        'COMPILER_RT_ABI CMP_RESULT __letf2(fp_t a, fp_t b);'
        'COMPILER_RT_ABI CMP_RESULT __getf2(fp_t a, fp_t b);'
        'COMPILER_RT_ABI CMP_RESULT __cmptf2(fp_t a, fp_t b) { return __letf2(a, b); }'
        'COMPILER_RT_ABI CMP_RESULT __eqtf2(fp_t a, fp_t b) { return __letf2(a, b); }'
        'COMPILER_RT_ABI CMP_RESULT __lttf2(fp_t a, fp_t b) { return __letf2(a, b); }'
        'COMPILER_RT_ABI CMP_RESULT __netf2(fp_t a, fp_t b) { return __letf2(a, b); }'
        'COMPILER_RT_ABI CMP_RESULT __gttf2(fp_t a, fp_t b) { return __getf2(a, b); }'
        '#else'
        '#error "no TF mode: __float128 / int128 missing on this target"'
        '#endif'
    ) -join "`n"
    $srcFile = Join-Path $w 'tf_compare_aliases.c'; $obj = Join-Path $w 'tf_compare_aliases.obj'
    [IO.File]::WriteAllText($srcFile, $c + "`n")
    $argv = @(Cc-Flags $dst $triple) + @('-fforce-enable-int128', '-O2',
        "-I$(Join-Path $Src 'compiler-rt/lib/builtins')", '-c', $srcFile, '-o', $obj)
    Run "[$triple] tf_compare_aliases.c" $KCC $argv (Join-Path $w 'compile.log')
    $merged = Join-Path $w 'merged.lib'
    # From inside $w: llvm-lib names a member by the path it was given, and a
    # shipped overlay must not carry the build machine's paths.
    Push-Location -LiteralPath $w
    try { Run "[$triple] llvm-lib merge" $LLVM_LIB @('/nologo', '/out:merged.lib', $lib, 'tf_compare_aliases.obj') (Join-Path $w 'lib.log') }
    finally { Pop-Location }
    Move-Item -LiteralPath $merged -Destination $lib -Force
}

# Symbol check without nm: a probe that takes the address of every required
# builtin, linked by kld (lld-link flavor) against the builtins archive alone.
function Probe-Builtins([string]$triple, [string]$lib, [string]$b, [string[]]$syms) {
    $mach = switch -Wildcard ($triple) { 'x86_64-*' { 'x64' } 'aarch64-*' { 'arm64' } 'i686-*' { 'x86' } }
    $w = Join-Path $b 'probe'
    New-Item -ItemType Directory -Force -Path $w | Out-Null
    $c = @('int _fltused = 0;') + ($syms | ForEach-Object { "extern void $_(void);" }) +
         @('__declspec(dllexport) void *const kairo_probe[] = {') + ($syms | ForEach-Object { "  (void *)&$_," }) + @('};')
    $srcFile = Join-Path $w 'probe.c'; $obj = Join-Path $w 'probe.obj'
    [IO.File]::WriteAllText($srcFile, ($c -join "`n") + "`n")
    Run "[$triple] symbol probe compile" $KCC @("--target=$triple", "--sysroot=$NoRoot", '-O0', '-c', $srcFile, '-o', $obj) (Join-Path $w 'compile.log')
    Run "[$triple] builtins symbol probe (a required TF/bf16 symbol is missing)" $KLD @('-flavor', 'link', '/nologo', '/dll', '/noentry', '/nodefaultlib',
        "/machine:$mach", "/out:$(Join-Path $w 'probe.dll')", $obj, $lib) (Join-Path $w 'probe.log')
}

function Write-Toml([string]$name, [string]$xa, [string]$path) {
    $t = @(
        "triple        = `"$name`""
        'llvm_version  = "22.1.0"'
        'family        = "windows-msvc"'
        'sysroot       = "."'
        'include_dirs  = ["include/c++/v1", "msvc/crt/include", "msvc/sdk/include/ucrt", "msvc/sdk/include/um", "msvc/sdk/include/shared"]'
        "lib_dirs      = [`"lib`", `"msvc/crt/lib/$xa`", `"msvc/sdk/lib/um/$xa`", `"msvc/sdk/lib/ucrt/$xa`"]"
        'has_libcxx    = true'
        'static        = true'
        'crt_startup   = []'
        'crt_end       = []'
        'libc_link     = ["libcmt.lib", "libvcruntime.lib", "libucrt.lib", "oldnames.lib", "kernel32.lib", "user32.lib", "advapi32.lib", "shell32.lib", "uuid.lib"]'
        'libcxx_link   = ["libc++.lib", "libcpmt.lib"]'
        'rtlib         = "compiler-rt"'
        'linker        = "lld-link"'
        'resource_dir  = "compiler-rt"'
        'msvc_crt      = "static"'
        'local_only    = ["msvc"]'
        'cc_defines    = ["_CRT_STDIO_ISO_WIDE_SPECIFIERS"]'
        'cc_isolation  = ["-nostdlibinc", "-nostdinc++"]'
    )
    [IO.File]::WriteAllText($path, ($t -join "`n") + "`n")
}

# The Kairo-shaped check: C++ with a thrown and caught exception, compiled and
# linked by kcc from SYSROOT.toml alone (no include or library flags).
function Validate([string]$name, [string]$r) {
    $t = Join-Path $Work "$name-test"
    New-Item -ItemType Directory -Force -Path $t | Out-Null
    $c = @(
        '#include <cstdio>', '#include <stdexcept>', '#include <string>', '#include <vector>'
        'int main() {'
        '  std::vector<std::string> v{"a", "b"};'
        '  try { throw std::runtime_error(v[0] + v[1]); }'
        '  catch (const std::exception &e) { std::printf("%s\n", e.what()); }'
        '  return 0;'
        '}'
    ) -join "`n"
    [IO.File]::WriteAllText((Join-Path $t 't.cpp'), $c + "`n")
    Run "[$name] validation link (kcc --target=$name --sysroot=$r)" $KCC @("--target=$name", "--sysroot=$r", '-std=c++20', '-O1',
        (Join-Path $t 't.cpp'), '-o', (Join-Path $t 't.exe')) (Join-Path $t 'link.log')
    Write-Host "   validated: kcc linked a C++ program from SYSROOT.toml ($(Join-Path $t 't.exe'))"
}

Write-Host ">> install: $Kairo"
if ($NeedBuild) {
    $rev = Get-Content -LiteralPath (Join-Path $Src 'REVISION') -TotalCount 1 -ErrorAction SilentlyContinue
    Write-Host ">> runtimes source: $Src (rev $(if ($rev) { $rev } else { 'unknown' }))"
}
Write-Host ">> CRT + SDK: $From"
$name = 'x86_64-windows-msvc'
foreach ($a in $arches) {
    switch -Regex ($a) {
        '^(x86_64|amd64|x64)$' { $arch = 'x86_64'; $xa = 'x86_64'; $ms = 'x64'; $rtarch = 'x86_64'; break }
        '^(aarch64|arm64)$' { $arch = 'aarch64'; $xa = 'aarch64'; $ms = 'arm64'; $rtarch = 'aarch64'; break }
        '^(i686|i386|x86)$' { $arch = 'i686'; $xa = 'x86'; $ms = 'x86'; $rtarch = 'i386'; break }
        default { Die "unknown arch $a (x86_64, aarch64/arm64, i686/i386)" }
    }
    $triple = "$arch-pc-windows-msvc"
    $name = "$arch-windows-msvc"
    $dst = if ($OverlayOut) { Join-Path $Work $name } else { Join-Path $Stage $name }
    Write-Host ">> [$name] staging -> $dst"
    # Assembled under WORK and moved into place only when complete: kcc picks
    # up <install>/sysroot/<name> by itself (ahead of --sysroot), so neither an
    # old root nor a half-built one may sit there during the build.
    $root = Join-Path $Work "$name-root"
    foreach ($p in $dst, $root) { if (Test-Path -LiteralPath $p) { Remove-Item -LiteralPath $p -Recurse -Force } }
    New-Item -ItemType Directory -Force -Path $root, $NoRoot, $Stage | Out-Null
    Stage-Msvc $xa $ms $root
    if (Use-Overlay $arch) {
        $ov = Join-Path $Overlays "msvc-$arch"
        $orev = Get-Content -LiteralPath (Join-Path $Overlays 'REVISION') -TotalCount 1 -ErrorAction SilentlyContinue
        Write-Host ">> [$name] prebuilt libc++ + builtins: $ov (rev $(if ($orev) { $orev } else { 'unknown' }))"
    } else {
        $ov = Join-Path $Work "overlay-$arch"
        if (Test-Path -LiteralPath $ov) { Remove-Item -LiteralPath $ov -Recurse -Force }
        New-Item -ItemType Directory -Force -Path $ov | Out-Null
        Build-Runtimes $triple $root $rtarch $ov
    }
    Copy-Overlay $ov $root
    if (-not (Select-String -LiteralPath (Join-Path $root 'include/c++/v1/__config_site') -Pattern '_LIBCPP_DISABLE_VISIBILITY_ANNOTATIONS' -Quiet)) {
        Die "[$name] __config_site is not static-only (would import __imp_ symbols)"
    }
    Write-Toml $name $xa (Join-Path $root 'SYSROOT.toml')
    try { Move-Item -LiteralPath $root -Destination $dst }
    catch { Copy-Tree $root $dst; Remove-Item -LiteralPath $root -Recurse -Force }   # across volumes
    Validate $name $dst
    if ($OverlayOut) {
        # Only the second layer leaves WORK; the CRT/SDK-bearing root is scratch.
        $o = Join-Path $OverlayOut "msvc-$arch"
        if (Test-Path -LiteralPath $o) { Remove-Item -LiteralPath $o -Recurse -Force }
        New-Item -ItemType Directory -Force -Path $o | Out-Null
        Copy-Overlay $ov $o
        Remove-Item -LiteralPath $dst -Recurse -Force
        Write-Host ">> [$name] overlay written: $o"
        continue
    }
    $size = (Get-ChildItem -LiteralPath $dst -Recurse -File | Measure-Object -Property Length -Sum).Sum
    Write-Host (">> [$name] staged ({0:N0} MiB)" -f ($size / 1MB))
}
if ((Env 'KEEP_WORK' '0') -ne '1') {
    Remove-Item -LiteralPath $Work -Recurse -Force -ErrorAction SilentlyContinue
    $parent = Split-Path -Parent $Work
    if ((Test-Path -LiteralPath $parent) -and -not (Get-ChildItem -LiteralPath $parent -Force)) {
        Remove-Item -LiteralPath $parent -Force
    }
}
Write-Host "msvc sysroots ready. Try: kairo --target $name main.k -o main.exe"
Write-Host "(They contain Microsoft's CRT and SDK: keep them local, never redistribute them.)"
exit 0
