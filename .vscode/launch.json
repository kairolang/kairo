{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kairo (Mac/CodeLLDB)",
      "type": "lldb",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/x86_64-linux-gnu/debug/bin/kairo",
      "args": ["test.k", "--print-ast"],
      "initCommands": [
        "command script import ${workspaceFolder}/Scripts/cppvsdbg.py",
        "settings set frame-format \"frame #${frame.index}: ${frame.pc}{ ${module.file.basename}`${script.frame:cppvsdbg.demangle_frame}}\\n\""
      ]
    },
    {
      "name": "Kairo (Linux/Windows GDB)",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/x86_64-linux-gnu/debug/bin/kairo",
      "args": ["Tests/Parser/ExprParse/chain_trailing_access_after_call_BUG.k", "--print-ast=tree"],
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Load GDB Kairo Script",
          "text": "source ${workspaceFolder}/Scripts/gdb_kairo.py",
          "ignoreFailures": false
        }
      ],
      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder}/build/.gen/test_run.exe"
      }
    }
  ]
}