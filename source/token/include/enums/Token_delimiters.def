#ifndef __DELIMITERS_DEF__
#define __DELIMITERS_DEF__

#define DELIMITER_TOKENS_COUNT 3

#define DELIMITER_TOKENS(GENERATE)    \
    GENERATE(DELIMITER_TAB,     "\t") \
    GENERATE(DELIMITER_NEWLINE, "\n") \
    GENERATE(DELIMITER_SPACE,   " " )

// NOTE: IF THIS GENERATION IS CHANGED DO NOT FORGET TO UPDATE COUNT

#endif  // __DELIMITERS_DEF__