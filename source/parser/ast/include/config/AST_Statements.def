#ifndef __AST_STATEMENTS_DEF__
#define __AST_STATEMENTS_DEF__

#define STATES(MACRO)            \
    MACRO(NamedVarSpecifier)     \
    MACRO(NamedVarSpecifierList) \
    MACRO(ForPyStatementCore)    \
    MACRO(ForCStatementCore)     \
    MACRO(ForState)              \
    MACRO(WhileState)            \
    MACRO(ElseState)             \
    MACRO(IfState)               \
    MACRO(SwitchCaseState)       \
    MACRO(SwitchState)           \
    MACRO(YieldState)            \
    MACRO(DeleteState)           \
    MACRO(ImportState)            \
    MACRO(ImportItems)     \
    MACRO(SingleImport)      \
    MACRO(SpecImport)           \
    MACRO(MultiImportState)           \
    MACRO(ReturnState)           \
    MACRO(BreakState)            \
    MACRO(BlockState)            \
    MACRO(SuiteState)            \
    MACRO(ContinueState)         \
    MACRO(CatchState)            \
    MACRO(FinallyState)          \
    MACRO(TryState)              \
    MACRO(PanicState)            \
    MACRO(ExprState)

#endif  // __AST_STATEMENTS_DEF__