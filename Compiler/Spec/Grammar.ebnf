// Kairo grammar, W3C-style EBNF.
//
// Generated from the tree-sitter grammar (Extras/LSPClients/tree-sitter-kairo/grammar.js,
// via its src/grammar.json) by Scripts/gen_grammar_ebnf.py. Do not edit by hand:
// change grammar.js, run `tree-sitter generate`, then rerun the script.
//
// The parser in Compiler/Parser/ remains the authority for syntax (see
// Compiler/Spec/Parsing.md), and the language reference for meaning. This grammar
// describes the same language for tooling; where they disagree, the parser wins.
//
// Notation: `::=` defines, `|` separates alternatives, `?` `*` `+` are optional,
// zero-or-more and one-or-more, `( )` groups, quoted text is literal, /.../ is a
// regular expression over characters, and ε is the empty sequence.
//
// Not expressed here: operator precedence and associativity, which the tree-sitter
// grammar encodes with prec annotations; and its 63 declared GLR conflicts.
// The start symbol is `source_file`. Keywords are lexed as the word token
// `identifier`.
//
// Allowed between any two tokens (tree-sitter extras): /\s/, line_comment, block_comment.
//
// Produced by the external scanner (src/scanner.c), not defined below:
//   _newline, block_comment, raw_block, _init_open, _dot_float, _fstring, _error_sentinel.

source_file ::= ( _item _terminator | _item | _terminator )*

_item ::= _declaration | _statement

_terminator ::= _newline | ";"

annotation ::= "@" _annotation_name argument_list?

_annotation_name ::= identifier
                   | ( "inline" | "const" | "unsafe" | "static" | "final" | "override" | "virtual" | "eval" | "type" )

hash_attribute ::= "#[" identifier argument_list? "]"

visibility ::= "pub" | "priv" | "prot"

decl_modifiers ::= _decl_modifier+

_decl_modifier ::= annotation
                 | hash_attribute
                 | visibility
                 | "static"
                 | "virtual"
                 | "override"
                 | "final"
                 | "inline"
                 | "eval"
                 | "const"
                 | "async"
                 | "unsafe"
                 | "mutable"

_declaration ::= function_decl
               | class_decl
               | struct_decl
               | union_decl
               | interface_decl
               | enum_decl
               | extend_decl
               | type_alias_decl
               | module_decl
               | module_pin
               | test_decl
               | macro_decl
               | import_decl
               | ffi_decl
               | visibility_block
               | eval_block
               | variable_decl
               | destructuring_decl

declaration_list ::= "{" ( _member _terminator | _member | _terminator )* "}"

_member ::= _declaration | _statement

visibility_block ::= visibility declaration_list

eval_block ::= "eval" declaration_list

module_pin ::= decl_modifiers? "module" path

module_decl ::= decl_modifiers? "module" path? declaration_list

test_decl ::= decl_modifiers? "test" string? block

path ::= "::"? identifier ( "::" identifier )*

generic_params ::= "<" generic_param ( "," generic_param )* ","?? ">"

generic_param ::= ( "eval" | "const" ) identifier ":" _type ( "=" _generic_arg )?
                | "..."? identifier ( ":" kind_bound )? heritage* ( "=" _generic_arg )?

kind_bound ::= "class" | "struct" | "enum" | "union" | "type"

heritage ::= ( "derives" | "impl" ) heritage_edge ( "," heritage_edge )*

heritage_edge ::= "virtual"? visibility? _type

requires_clause ::= "requires" _expression

where_clause ::= "where" _expression

function_decl ::= decl_modifiers? "fn" generic_params? _fn_name parameter_list fn_modifiers? ( "->" _return_type )? requires_clause? where_clause? _fn_body?

_fn_name ::= ( ( identifier | "Self" ) generic_args? "::" )* ( "op" operator_name | ( identifier | "self" | "Self" ) generic_args? )

operator_name ::= "(" ")"
                | "[" "]"
                | "<" ">"
                | ">" ">"
                | ">" ">" "="
                | ">" "="
                | "+"
                | "-"
                | "*"
                | "/"
                | "%"
                | "^^"
                | "<"
                | ">"
                | "<<"
                | "and"
                | "or"
                | "xor"
                | "bitand"
                | "bitor"
                | "not"
                | "compl"
                | "not_eq"
                | "and_eq"
                | "or_eq"
                | "xor_eq"
                | "^"
                | "|"
                | "&"
                | "~"
                | "!"
                | "=="
                | "!="
                | "<=>"
                | "==="
                | "&&"
                | "||"
                | "<="
                | ">="
                | "++"
                | "--"
                | "l++"
                | "r++"
                | "l--"
                | "r--"
                | "="
                | "+="
                | "-="
                | "*="
                | "/="
                | "%="
                | "&="
                | "|="
                | "^="
                | "<<="
                | ">>="
                | "->"
                | "?"
                | ".."
                | "..="
                | "..."
                | "??"
                | "in"
                | "as"
                | "await"
                | "spawn"
                | "thread"
                | "delete"
                | "yield"
                | "panic"
                | "new"

_return_type ::= "!" | _type

parameter_list ::= "(" ( param ( "," param )* ","? )? ")"

param ::= annotation* _binding_const? "self"
        | annotation* _binding_const? "..."? ( identifier "?"? ":" )? _type ( "=" _expression )?
        | annotation* "..."

fn_modifiers ::= ( "const" | "volatile" | "unsafe" | "eval" | "async" | "final" | "inline" | "override" | "virtual" | "static" | panic_clause )+

panic_clause ::= "panic" panic_set?

panic_set ::= "(" ( _type ( "," _type )* ","? )? ")"

_fn_body ::= block | "=" ( ( "default" | "delete" | "virtual" ) | _expression )

class_decl ::= decl_modifiers? "class" _type_head type_body?

struct_decl ::= decl_modifiers? "struct" _type_head type_body?

union_decl ::= decl_modifiers? "union" _type_head type_body?

interface_decl ::= decl_modifiers? "interface" generic_params? identifier generic_args? ( "derives" _expression ( "," _expression )* )? requires_clause? type_body?

_type_head ::= generic_params? identifier generic_args? heritage* requires_clause?

extend_decl ::= decl_modifiers? "extend" generic_params? _type heritage* requires_clause? type_body

type_body ::= declaration_list

enum_decl ::= decl_modifiers? "enum" generic_params? identifier generic_args? ( "derives" _type )? requires_clause? enum_body?

enum_body ::= "{" _newline* ( enum_variant ( ( "," | _newline ) _newline* enum_variant )* ","? _newline* )? "}"

enum_variant ::= annotation* identifier ( "{" ( field_spec ( "," field_spec )* ","? )? "}" | "(" ( _type ( "," _type )* ","? )? ")" | "=" _expression )?

field_spec ::= identifier ":" _type

type_alias_decl ::= decl_modifiers? "type" generic_params? identifier generic_args? ( "impl" _type ( "," _type )* ","? )? ( "=" _type )?

macro_decl ::= decl_modifiers? "macro" identifier "!" ( "(" ( macro_param ( "," macro_param )* ","? )? ")" )? block
             | decl_modifiers? "macro" "@" identifier parameter_list? ( "->" _type )? block

macro_param ::= "..." identifier?
              | identifier "..."
              | identifier ( ":" _type )? ( "=" _expression )?

import_decl ::= decl_modifiers? "import" "module"? import_path ( "as" identifier "!"? )?

import_path ::= "::"? _import_segment ( "::" _import_segment )* ( "::" ( "*" | import_list ) )?

_import_segment ::= identifier "!"?

import_list ::= "{" ( import_item ( "," import_item )* ","? )? "}"

import_item ::= "*"
              | _import_segment ( "::" _import_segment )* ( "::" ( "*" | import_list ) )? ( "as" identifier "!"? )?

ffi_decl ::= decl_modifiers? "ffi" string ( "import" string ( "as" identifier )? | declaration_list | _declaration )

variable_decl ::= decl_modifiers? storage_head pointer_shorthand? identifier "?"? ( ":" _type )? ( "=" _expression )?

storage_head ::= "var"
               | "const" ( "static" "thread"? | "thread" | "eval" )?
               | "static" "thread"? "const"?
               | "thread" "const"?
               | "eval" "const"?

pointer_shorthand ::= "unsafe"? "*"+

destructuring_decl ::= decl_modifiers? ( "var" | "const" ) ( "(" binding ( "," binding )* ","? ")" | "{" binding ( "," binding )* ","? "}" ) ( ":" _type )? "=" _expression

binding ::= ( "var" | _binding_const )? ( "unsafe"? "*" )? ( identifier | "_" ) "?"? ( ":" _type )?

binding_spec ::= ( "var" | _binding_const ) ( binding | "(" binding ( "," binding )* ","? ")" )

_statement ::= expression_stmt
             | block
             | if_stmt
             | while_stmt
             | loop_stmt
             | for_stmt
             | match_stmt
             | return_stmt
             | break_stmt
             | continue_stmt
             | panic_stmt
             | yield_stmt
             | assert_stmt
             | try_stmt
             | finally_stmt
             | unsafe_block
             | inline_block
             | labeled_stmt
             | context_binding_stmt

block ::= "{" ( _member _terminator | _member | _terminator )* "}"

expression_stmt ::= _expression

if_stmt ::= ( "eval" | annotation )? "if" _expression block ( annotation? "else" ( if_stmt | block ) )?

while_stmt ::= "while" _expression block

loop_stmt ::= "loop" block

for_stmt ::= "eval"? "for" ( ( "var" | _binding_const )? ( binding | "(" binding ( "," binding )* ","? ")" ) "in" _expression | for_init ";" _expression? ";" _expression? ) block

for_init ::= ( "var" | "const" ) binding ( "=" _expression )?

labeled_stmt ::= identifier ":" ( while_stmt | loop_stmt | for_stmt )

match_stmt ::= "match" _expression match_body

match_body ::= "{" ( match_arm | _terminator | "," )* "}"

match_arm ::= ( "case" _pattern ( "," _pattern )* ","? where_clause? | "default" ) ( block | "=>" _expression )

return_stmt ::= "return" _expression?

break_stmt ::= "break" identifier?

continue_stmt ::= "continue" identifier?

panic_stmt ::= "panic" _expression?

yield_stmt ::= "yield" _expression?

assert_stmt ::= "assert" "static"? _expression ( "," _expression )?

try_stmt ::= "try" block catch_clause+ finally_clause?

catch_clause ::= "catch" ( "var" | _binding_const )? ( ( identifier | "_" ) ( ":" _type )? )? block

finally_clause ::= "finally" block

finally_stmt ::= "finally" block

unsafe_block ::= "unsafe" block

inline_block ::= "inline" string raw_block

context_binding_stmt ::= _expression "as" binding_spec block

_expression ::= assignment_expr
              | binary_expr
              | range_expr
              | cast_expr
              | unary_expr
              | attributed_expr
              | postfix_expr
              | call_expr
              | index_expr
              | member_expr
              | scope_expr
              | initializer_expr
              | identifier_expr
              | generic_path_expr
              | global_expr
              | dotted_variant_expr
              | macro_invocation
              | sizeof_expr
              | typeof_expr
              | number
              | float
              | string
              | char
              | boolean
              | null
              | paren_expr
              | tuple_expr
              | stmt_expr
              | list_expr
              | set_expr
              | map_expr
              | anon_initializer_expr
              | closure_expr
              | if_expr
              | try_expr
              | match_expr
              | unsafe_expr
              | builtin

assignment_expr ::= _expression ( "and_eq" | "or_eq" | "xor_eq" | "=" | "+=" | "-=" | "*=" | "/=" | "%=" | "&=" | "|=" | "^=" | "<<=" | "@=" | ">" ">" "=" ) _expression

binary_expr ::= _expression "??" _expression
              | _expression ( "||" | "or" ) _expression
              | _expression ( "&&" | "and" ) _expression
              | _expression ( "|" | "bitor" ) _expression
              | _expression ( "^" | "xor" ) _expression
              | _expression ( "&" | "bitand" ) _expression
              | _expression ( "==" | "!=" | "===" | "not_eq" ) _expression
              | _expression ( "<" | ">" | "<=" | ">" "=" | "<=>" | "in" | "not" "in" ) _expression
              | _expression ( "<<" | ">" ">" ) _expression
              | _expression ( "+" | "-" ) _expression
              | _expression ( "*" | "/" | "%" ) _expression
              | _expression "^^" _expression
              | _expression ( ".*" | "->*" | "?.*" | "?->*" ) _expression
              | _expression ( "impl" | "derives" ) _type

range_expr ::= _expression ( ".." | "..=" ) _expression? | ( ".." | "..=" ) _expression | ".."

cast_expr ::= _expression "as" "static"? _type

unary_expr ::= ( "!" | "not" | "+" | "-" | "~" | "compl" | "&" | "*" | "++" | "--" | "..." | "await" | "spawn" | "thread" | "eval" | "yield" ) _expression
             | "delete" ( "[" "]" )? _expression

unsafe_expr ::= "unsafe" _expression

sizeof_expr ::= ( "sizeof" | "alignof" ) ( "(" ( _type | _expression ) ")" | _expression | _type_only )

typeof_expr ::= "typeof" _expression

attributed_expr ::= "@" _annotation_name generic_args? argument_list? _expression?

postfix_expr ::= _expression ( "++" | "--" | "..." | "?" | "!" )

call_expr ::= _expression argument_list

argument_list ::= "(" ( _call_arg ( "," _call_arg )* ","? )? ")"

_call_arg ::= named_argument | _expression | _type_only

named_argument ::= identifier ":" _expression

index_expr ::= _expression "[" ( _expression ( "," _expression )* ","? )? "]"

member_expr ::= _expression ( "." | "->" | "?." | "?->" ) _member_target

scope_expr ::= _expression "::" ( _member_target | generic_args )

_member_target ::= "op" operator_name generic_args?
                 | ( _decimal | _tuple_float )
                 | _member_name generic_args?

_member_name ::= identifier | ( "self" | "Self" | "type" | "delete" ) | builtin

initializer_expr ::= ( identifier_expr | generic_path_expr | scope_expr | global_expr | dotted_variant_expr ) initializer_list

initializer_list ::= _init_open field_initializer ( "," field_initializer )* ","? "}" | "{" "}"

field_initializer ::= ( identifier | "." identifier ) ":" _expression

identifier_expr ::= identifier | "self" | "Self"

generic_path_expr ::= identifier_expr generic_args

global_expr ::= "::" _member_name generic_args?

dotted_variant_expr ::= "." identifier

macro_invocation ::= identifier "!" macro_arguments?

macro_arguments ::= "(" ( ( _expression | _type_only | named_argument | block ) ( "," ( _expression | _type_only | named_argument | block ) )* ","? )? ")"

paren_expr ::= "(" _expression ")"

tuple_expr ::= "(" ( _expression "," | _expression ( "," _expression )+ ","? ) ")"

stmt_expr ::= "(" block ")"

list_expr ::= "[" ( _expression ( "," _expression )* ","? )? "]"

set_expr ::= "{" ( _expression ( "," _expression )* ","? )? "}"

map_expr ::= "{" map_entry ( "," map_entry )* ","? "}"

map_entry ::= _expression ":" _expression

anon_initializer_expr ::= "{" "." field_initializer_tail ( "," "." field_initializer_tail )* ","? "}"

field_initializer_tail ::= identifier ":" _expression

closure_expr ::= "fn" generic_params? parameter_list? capture_list? fn_modifiers? ( "->" _return_type )? ( block | "=" _expression )

capture_list ::= "||" | "|" ( capture ( "," capture )* ","? )? "|"

capture ::= _binding_const? "*"? ( identifier | "self" ) | _binding_const? "*" | "="

if_expr ::= "if" _expression "=>" _expression ( "else" "if" _expression "=>" _expression )* ( "else" "=>" _expression )?

try_expr ::= "try" _expression catch_arm+

catch_arm ::= "catch" ( "var" | _binding_const )? ( ( identifier | "_" ) ( ":" _type )? )? "=>" ( _expression | block | return_stmt | break_stmt | continue_stmt | panic_stmt )

match_expr ::= "match" _expression match_body

builtin ::= "__file__" | "__line__" | "__column__" | "__function__" | "__module__"

_type ::= qualified_type | _type_atom

qualified_type ::= annotation* type_qualifiers _type_atom

type_qualifiers ::= _type_qualifier+

_binding_const ::= "const"

_type_qualifier ::= "const"
                  | "volatile"
                  | "atomic"
                  | "unsafe"
                  | "eval"
                  | "mutable"
                  | "yield"
                  | "async"
                  | "thread"

_type_only ::= qualified_type | pointer_type | nullable_type | array_type | map_type | function_type

_type_atom ::= path_type
             | macro_type
             | pointer_type
             | nullable_type
             | pack_type
             | tuple_type
             | paren_type
             | list_type
             | array_type
             | set_type
             | map_type
             | function_type
             | typeof_type
             | annotated_type

annotated_type ::= annotation _type_atom

path_type ::= "::"? path_type_segment ( "::" ( path_type_segment | generic_args ) )*

path_type_segment ::= ( identifier | "Self" | "self" ) generic_args?

macro_type ::= identifier "!" macro_arguments

pointer_type ::= ( "*" | "&" ) _type

nullable_type ::= _type_atom "?"

pack_type ::= _type_atom "..."

paren_type ::= "(" _type ")"

tuple_type ::= "(" ( _type "," ( _type ( "," _type )* ","? )? )? ")"

list_type ::= "[" _type "]"

array_type ::= "[" _type ";" _expression? "]"

set_type ::= "{" _type "}"

map_type ::= "{" _type ":" _type "}"

function_type ::= "fn" "(" ( annotation* ( identifier ":" )? _type ( "," annotation* ( identifier ":" )? _type )* ","? )? ")" ( annotation | "const" | "volatile" | "unsafe" | "eval" | "async" | panic_clause )* ( "->" _return_type )?

typeof_type ::= "typeof" _expression

generic_args ::= "<" ( _generic_arg_entry ( "," _generic_arg_entry )* ","? )? ">"

_generic_arg_entry ::= _generic_arg | identifier ":" _generic_arg

_generic_arg ::= _type | _expression

_pattern ::= wildcard_pattern
           | binding_pattern
           | tuple_pattern
           | slice_pattern
           | dotted_pattern
           | range_pattern
           | constructor_pattern
           | literal_pattern

wildcard_pattern ::= "_"

binding_pattern ::= ( "var" | _binding_const ) ( "unsafe"? "*" )? ( identifier | "_" ) "?"? ( ":" _type )?

tuple_pattern ::= "(" ( _pattern ( "," _pattern )* ","? )? ")"

slice_pattern ::= "[" ( ( ".." identifier? | _pattern ) ( "," ( ".." identifier? | _pattern ) )* ","? )? "]"

dotted_pattern ::= "." identifier ( "(" ( _pattern ( "," _pattern )* ","? )? ")" )?

range_pattern ::= _pattern_lead ( ".." | "..=" ) _expression? | ( ".." | "..=" ) _expression

constructor_pattern ::= _pattern_lead ( "(" ( _pattern ( "," _pattern )* ","? )? ")" )?

literal_pattern ::= "-"? ( number | float ) | string | char | boolean | null

_pattern_lead ::= "-"? ( number | float )
                | string
                | char
                | boolean
                | null
                | identifier_expr
                | generic_path_expr
                | scope_expr
                | global_expr

identifier ::= /[\p{XID_Start}_#][\p{XID_Continue}#]*/

boolean ::= "true" | "false"

null ::= "null"

number ::= _decimal | _radix_int

_decimal ::= /[0-9][0-9_]*/ /[a-zA-Z][a-zA-Z0-9_]*/?

_radix_int ::= ( /0[xX][0-9a-fA-F_]+(\.[0-9a-fA-F_]*)?[pP][+-]?[0-9_]+/ /[a-zA-Z][a-zA-Z0-9_]*/? | /0[xX][0-9a-fA-F_]+/ /[g-zG-Z_][a-zA-Z0-9_]*/? | /0[bB][01_]+/ /[a-zA-Z][a-zA-Z0-9_]*/? | /0[oO][0-7_]+/ /[a-zA-Z][a-zA-Z0-9_]*/? )

float ::= _tuple_float | _dot_float

_tuple_float ::= /[0-9][0-9_]*\.[0-9][0-9_]*/ /[eE][+-]?[0-9_]+/? /[a-zA-Z][a-zA-Z0-9_]*/?
               | /[0-9][0-9_]*[eE][+-]?[0-9_]+/ /[a-zA-Z][a-zA-Z0-9_]*/?

string ::= _string_piece+

_string_piece ::= string_literal | _fstring | raw_string_literal | multiline_string_literal

multiline_string_literal ::= ( "f" | "r" | "b" | "rf" | "fr" | "rb" | "br" )? '"""' ( /[^"\\]/ | /\\(.|\n)/ | /"[^"]/ | /""[^"]/ )* '"""'

string_literal ::= "b"? '"' ( /[^"\\\n]+/ | /\\(.|\n)/ )* '"' /[a-zA-Z_][a-zA-Z0-9_]*/?

raw_string_literal ::= ( "r" | "rf" | "fr" | "rb" | "br" ) '"' /[^"]*/ '"'

char ::= ( "f" | "r" | "b" )? "'" ( /[^'\\\n]/ | /\\./ | /\\[xuU]\{?[0-9a-fA-F]+\}?/ )+ "'"

line_comment ::= "//" /[^\n]*/
