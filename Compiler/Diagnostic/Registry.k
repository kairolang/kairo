    case DiagID::C0001E { return "Clang emitted this configurable diagnostic as an error, usually because warning escalation promoted it. This diagnostic is controlled by Clang\'s \'-W#pragma-messages\' warning option. Consult the Clang diagnostics documentation for the exact meaning and triggering conditions of \'#pragma-messages\'."; }
