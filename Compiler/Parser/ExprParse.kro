import ASTNode::Base::*;
import Lexer::Token::*;

class <T> ExprParse {
    priv inline fn dyn(self) -> *T {
        return static_cast::<*T>(&self);
    }

    fn parse_expr(self)                          -> *Expr { return &null; } // entry
    fn parse_expr_prec(self, min_prec: u32)      -> *Expr { return &null; } // Pratt
}