/// Sync-set enum. Each parse_* function declares which tokens terminate
/// error recovery when a parse failure occurs inside it.
enum SyncSet derives u32 {
    None        = 0,
    TopLevel    = 1 << 0,   // fn, class, struct, enum, module, ...
    StmtStart   = 1 << 1,   // var, const, return, if, while, ...
    ExprEnd     = 1 << 2,   // ;, ,, ), ]
    BlockEnd    = 1 << 3,   // }
    GenericEnd  = 1 << 4,   // >
    ParenEnd    = 1 << 5,   // )
    BracketEnd  = 1 << 6,   // ]
    LineEnd     = 1 << 7,   // newline
}


/*
--syntax-only
--type-check-only
-E / --preprocess
--no-prelude
--no-modules
--no-generics
--no-eval
--no-yield
--no-unsafe
--no-exceptions / -f[no-]exceptions
--no-ffi / --no-cxx
--no-assert
--no-finally
--edition
--force-include
--prelude

--no-prelude + --prelude
--cmax-macro-depth / --cmax-macro-expansions
--macro-search-path
-D / --cfg
*/

enum ScopeKind derives u8 {
    Function,      // function body
    Block,         // { ... }
    GenericParams, // <T, U: Foo>
    ForLoop,       // for-binding scope
    MatchArm,      // match-pattern bindings
    Lambda,        // lambda captures + params
}

/// A single entry bound at parse time. Refers to the Decl or parameter
/// that introduced the name. Populated only once the parser has decided
/// on the binding; never speculative.
class LocalBinding {
    pub var name:      string;
    pub var decl:      obs::<Decl>;     // VarDecl, ParamDecl, TypeParamDecl, etc.
    pub var range:     SourceRange;     // where the name was introduced
    pub var is_param:  bool = false;
    pub var is_tparam: bool = false;    // type parameter
}

class LexicalScope {
    pub var kind:       ScopeKind;
    pub var parent:     obs::<LexicalScope>;
    pub var bindings:   libcxx::unordered_map::<string, LocalBinding>;
    pub var dc:         obs::<DeclContext>;    // decl context this scope lives inside

    fn LexicalScope(self, kind: ScopeKind, parent: *LexicalScope, dc: *DeclContext) {
        self.kind   = kind;
        self.parent = parent;
        self.dc     = dc;
        self.bindings.reserve(8);
    }

    fn bind(self, name: string, decl: *Decl, range: SourceRange) {
        var b = LocalBinding{};
        b.name  = name;
        b.decl  = decl;
        b.range = range;
        self.bindings.insert(libcxx::make_pair(name, b));
    }

    fn lookup_local(self, name: string) -> *LocalBinding {
        var it = self.bindings.find(name);
        if it == self.bindings.end() { return &null; }
        return &(it->second);
    }
}

class ScopeStack {
    pub var _top: obs::<LexicalScope>;
    pub var ctx: obs::<ASTContext>;

    fn ScopeStack(self) {
        self.ctx = &null;
        self._top = &null;
    }

    fn set_ctx(self, ctx: *ASTContext) {
        self.ctx = ctx;
    }

    fn push(self, kind: ScopeKind, dc: *DeclContext) -> *LexicalScope {
        var s = self.ctx->alloc_init::<LexicalScope>(kind, self._top, dc);
        self._top = s;
        return s;
    }

    fn pop(self) {
        assert((self._top != &null) && r"ScopeStack::pop on empty stack");
        self._top = self._top->parent;
    }

    fn top(self) -> *LexicalScope { return self._top; }

    fn bind(self, name: string, decl: *Decl, range: SourceRange) {
        assert((self._top != &null) && r"ScopeStack::bind with no active scope");
        self._top->bind(name, decl, range);
    }

    /// Walks the lexical stack bottom-up. Returns the innermost binding,
    /// or null if not found. Caller falls back to HoistedScope.
    fn lookup(self, name: string) -> *LocalBinding {
        var s = self._top;
        while s != &null {
            var b = s->lookup_local(name);
            if b != &null { return b; }
            s = s->parent;
        }
        return &null;
    }

    /// Current decl context (from the top of stack).
    fn current_dc(self) -> *DeclContext {
        if self._top == &null { return &null; }
        return self._top->dc;
    }
}

// ---------------------------------------------------------------------------
//  PendingAnnotations accumulator for leading annotations/comments
//  consumed before a decl, stmt, expr, or type. The parser fills this,
//  then stamps it onto the AST node via apply_annotations().
// ---------------------------------------------------------------------------

class PendingAnnotations {
    inline "c++" {
        using VisAnnotation = VisibilityAnnotation<Decl>;
    }

    pub var visibility:  VisAnnotation::VisibilityKind = VisAnnotation::VisibilityKind::None;
    pub var vis_range:   SourceRange = SourceRange::invalid();
    pub var entries:     vec::<AnnotationEntry>;

    fn PendingAnnotations(self) {
        self.entries.reserve(4);
    }

    fn empty(self) -> bool {
        return self.entries.empty()
            && self.visibility == VisAnnotation::VisibilityKind::None;
    }

    fn add(self, kind: AnnotationKind, name: InternedStr, range: SourceRange) {
        self.entries.push_back(AnnotationEntry(kind, name, range));
    }

    fn set_visibility(self, kind: VisAnnotation::VisibilityKind, range: SourceRange) {
        self.visibility = kind;
        self.vis_range  = range;
    }

    fn clear(self) {
        self.entries.clear();
        self.visibility = VisAnnotation::VisibilityKind::None;
        self.vis_range  = SourceRange::invalid();
    }
}

// ---------------------------------------------------------------------------
//  PendingQuals accumulator for type qualifier keywords consumed before
//  the core type production. The parser fills this, then stamps it onto the
//  Type node via apply_quals().
// ---------------------------------------------------------------------------

class PendingQuals {
    type TypeQualifier = TypeQual::<Type>;
    pub var flags: TypeQualifier::Flags = TypeQualifier::Flags::None;
    pub var spans: vec::<QualSpan>;

    fn PendingQuals(self) {
        self.spans.reserve(4);
    }

    fn empty(self) -> bool {
        return self.flags == TypeQualifier::Flags::None;
    }

    fn add(self, flag: TypeQualifier::Flags, range: SourceRange) {
        self.flags |= flag;
        self.spans.push_back(QualSpan(static_cast::<u16>(flag), range));
    }

    fn clear(self) {
        self.flags = TypeQualifier::Flags::None;
        self.spans.clear();
    }
}


class ASTParse
  derives ExprParse::<ASTParse>,
          StmtParse::<ASTParse>,
          DeclParse::<ASTParse>,
          TypeParse::<ASTParse> {
    inline "c++" {
        using PendingAnnotations = PendingAnnotations;
        using PendingQuals = PendingQuals;
    }
            
    // --- Context handles ----------------------------------------------------
    pub var ctx:     obs::<ASTContext>;
    pub var diag:    obs::<DiagEngine>;
    pub var scope:   ScopeStack;
    pub var cc:      obs::<CodeCompleteConsumer>;  // null for batch compile

    // --- Token state --------------------------------------------------------
    pub var span:    TokenSpan;
    pub var c_idx:   usize = 0;
    pub var imm:     obs::<ImmediateTable>;

    // Source-of-truth pointers into span private
    var _prev:    obs::<Token> = &null;
    var _current: obs::<Token> = &null;
    var _peek:    obs::<Token> = &null;

    // --- Output -------------------------------------------------------------
    pub var tu: obs::<TranslationUnit>;

    // --- Recovery state -----------------------------------------------------
    pub var depth:            u32 = 0;           // recursion depth guard
    pub var max_depth:        u32 = 256;
    pub var error_count_base: u32 = 0;           // diag count at parse start
    pub var in_recovery:      bool = false;      // cascading-suppression flag


    fn ASTParse(self, ctx: *ASTContext, cc: *CodeCompleteConsumer, g_scope: *GlobalHoistedScope) {
        self.ctx   = ctx;
        self.diag  = ctx->diags;
        self.imm   = ctx->get_imm_table();
        self.cc    = cc;
        self.span  = ctx->get_tokens();
        self.tu    = ctx->alloc_init::<TranslationUnit>(ctx, ctx->fid, ctx->hoisted, g_scope);
        self.scope.set_ctx(ctx);

        self._prev    = &null;
        self._current = (self.span.get(0)) if (self.span.size() > 0) else (&null);
        self._peek    = (self.span.get(1)) if (self.span.size() > 1) else (&null);

        self.max_depth        = ctx->ci->frontend.max_scope_depth;
        self.error_count_base = self.diag->error_count();
    }

    fn parse(self) -> *TranslationUnit {
        var program = self.ctx->alloc_init::<Program>(self.ctx->fid, self.ctx);
        self.tu->program = program;           // direct assignment, not set_program()

        self.scope.push(ScopeKind::Function, self.tu);

        var iterations: usize = 0;
        var max_iter = self.span.size() << 2;

        // while !self.is_eof() {
        //     ++iterations;
        //     if iterations > max_iter { break; }

        //     var item = self.dispatch_top_level();
        //     if item.kind == TopLevelKind::Decl && item.as_decl() == &null {
        //         break;
        //     }

        //     program->add_item(item);
        // }

        while !self.is_eof() {
            if self.check(TokenKind::TkNewLine) {
                self.advance();
                continue;
            }
            var ty = self.parse_type();
            std::print(TypePrinter::print(ty, PrintStyle::Debug));
            if ty == &null { break; }
        }
        self.scope.pop();

        self.tu->error_count = self.diag->error_count() - self.error_count_base;
        return self.tu;
    }

    pub fn dispatch_top_level(self) -> TopLevelItem {
        self.advance();
        return TopLevelItem::from_decl(&null);
    }

    // ========================================================================
    //  Token accessors return 16-byte copies (trivial)
    // ========================================================================

    inline pub fn current(self) -> Token {
        if self._current == &null { return Token(); }
        return *self._current;
    }

    inline pub fn prev(self) -> Token {
        if self._prev == &null { return Token(); }
        return *self._prev;
    }

    inline pub fn peek(self) -> Token {
        if self._peek == &null { return Token(); }
        return *self._peek;
    }

    /// Raw pointer access only for resolve_deep, diag range attachment,
    /// macro expansion chain walking. Not for general use.
    inline pub fn current_ptr(self) -> *Token { return self._current; }
    inline pub fn prev_ptr(self)    -> *Token { return self._prev; }
    inline pub fn peek_ptr(self)    -> *Token { return self._peek; }

    // ========================================================================
    //  Cursor movement
    // ========================================================================
    
    enum SkipNL derives u8 {
        None,           // don't skip newlines at all
        Before,         // skip newlines, then move
        After,          // move, then skip newlines
        Only,           // skip only newlines, and don't move
    }

    // --- private helpers ---

    inline fn _skip_nl_fwd(self) {
        while self.current().kind == TokenKind::TkNewLine {
            self.advance();
        }
    }

    inline fn _skip_nl_bwd(self) {
        while self.current().kind == TokenKind::TkNewLine {
            self.retreat();
        }
    }

    // --- public API ---

    inline pub fn advance(self, const skip: SkipNL = SkipNL::None) {
        switch skip {
            case SkipNL::Before {
                self._skip_nl_fwd();
                self._advance();
            } case SkipNL::After {
                self._advance();
                self._skip_nl_fwd();
            } case SkipNL::Only {
                self._skip_nl_fwd();
            } default {
                self._advance();
            }
        }
    }

    inline pub fn retreat(self, const skip: SkipNL = SkipNL::None) {
        switch skip {
            case SkipNL::Before {
                self._skip_nl_bwd();
                self._retreat();
            } case SkipNL::After {
                self._retreat();
                self._skip_nl_bwd();
            } case SkipNL::Only {
                self._skip_nl_bwd();
            } default {
                self._retreat();
            }
        }
    }

    // --- cursor primitives (renamed to avoid collision) ---

    inline fn _advance(self) {
        self._prev = self._current;

        if (self.c_idx + 1) < self.span.size() {
            self.c_idx += 1;
        } else {
            self._current = &null;
            self._peek    = &null;
            return;
        }

        self._sync_cursor();
    }

    inline fn _retreat(self) {
        if self.c_idx == 0 { return; }

        self._peek    = self._current;
        self.c_idx   -= 1;
        self._current = (self.span.get(self.c_idx));
        self._prev    = (self.span.get(self.c_idx - 1)) if (self.c_idx > 0) else (&null);
    }

    /// Sync _current and _peek from c_idx. Used after any direct c_idx mutation.
    inline fn _sync_cursor(self) {
        self._current = (self.span.get(self.c_idx))     if (self.c_idx     < self.span.size()) else (&null);
        self._peek    = (self.span.get(self.c_idx + 1)) if (self.c_idx + 1 < self.span.size()) else (&null);
    }

    // ========================================================================
    //  Token resolution
    // ========================================================================

    /// Resolves through macro expansion chains to the underlying token kind
    /// and imm. Returns a copy with the resolved kind/imm and the original
    /// source range. Guards against infinite expansion loops.
    inline pub fn resolve_deep(self, tok: *Token) -> Token {
        var kind = tok->kind;
        var imm  = tok->imm;
        var iter: u32 = 0;

        while static_cast::<u32>(kind) == static_cast::<u32>(TokenKind::TkMacroExpand) {
            if (iter) >= (self.ctx->ci->pp.max_depth) {
                self.diag->report(DiagID::I002F, tok->range.start,
                    "excessive iterations during AST indexing token kind resolution, aborting to prevent infinite loop"
                ).first(tok->range)
                 .note(DiagID::S045N, tok->range.start, f"token kind resolution chain truncated after {iter} levels")
                 .emit();
                return Token(tok->range, TokenKind::TkUnknown, 0);
            }

            if imm >= static_cast::<u32>(MacroSentinel::Threshold) {
                return Token(tok->range, TokenKind::TkMacroExpand, imm);
            }

            var info = self.imm->get::<Immediate::MacroExpansionInfo>(imm);
            kind     = info->original_kind;
            imm      = info->original_imm;
            iter    += 1;
        }

        return Token(tok->range, kind, imm);
    }

    inline pub fn resolve_kind_deep(self, tok: *Token) -> TokenKind {
        return self.resolve_deep(tok).kind;
    }

    inline pub fn resolve_kind_shallow(self, tok: *Token) -> TokenKind {
        if tok == &null {
            return TokenKind::TkUnknown;
        }

        if static_cast::<u32>(tok->kind) != static_cast::<u32>(TokenKind::TkMacroExpand) {
            return tok->kind;
        }

        if tok->imm >= static_cast::<u32>(MacroSentinel::Threshold) {
            return TokenKind::TkMacroExpand;
        }

        if self.imm == &null {
            return TokenKind::TkUnknown;
        }

        var info = self.imm->get::<Immediate::MacroExpansionInfo>(tok->imm);
        return info->original_kind;
    }

    /// Resolves a token fully, skipping past AtComment tokens (advancing
    /// the cursor when encountered). Returns a resolved copy.
    inline pub fn resolve_fully(self, tok: *Token) -> Token {
        if tok == &null {
            return Token();
        }

        var resolved = self.resolve_deep(tok);

        if resolved.kind == TokenKind::AtComment {
            // we should be accumulating these into attributes, but for now
            // just brush them off so they don't interfere with parsing
            self.advance();
            return self.resolve_fully(self._current);
        }

        return resolved;
    }

    // ========================================================================
    //  Token checking unified core + convenience wrappers
    // ========================================================================

    /// Core check implementation. Resolves the token at `tok`, skips AtComment
    /// (advancing cursor if `is_current`), handles TkError recovery, and
    /// compares against `kind`. `is_current` controls whether AtComment skip
    /// advances the cursor (true for check/check_peek on current/peek) or
    /// falls through to current (for check_prev).
    inline fn _resolve_and_check(self, tok: *Token, kind: TokenKind, advance_on_at: bool) -> bool {
        if tok == &null { return false; }

        var resolved = self.resolve_deep(tok);
        var resolved_kind = resolved.kind;

        if resolved_kind == TokenKind::AtComment {
            // we should be accumulating these into attributes, but for now
            // just brush them off so they don't interfere with parsing
            if advance_on_at { self.advance(); }
            return self.check(kind);
        }

        if resolved_kind == TokenKind::TkError {
            // the imm of this token stores the expected kind from recovery
            self.diag->report(DiagID::S045E, tok->range.start,
                f"unexpected token found where '{token_kind_to_readable_string(static_cast::<TokenKind>(resolved.imm))}' expected"
            ).first(tok->range).emit();
            resolved_kind = static_cast::<TokenKind>(resolved.imm);
        }

        return resolved_kind == kind;
    }

    inline pub fn check(self, kind: TokenKind) -> bool {
        return self._resolve_and_check(self._current, kind, true);
    }

    inline pub fn check(self, pre: fn (TokenKind) -> bool) -> bool {
        if self._current == &null { return false; }
        var resolved = self.resolve_deep(self._current);
        var resolved_kind = resolved.kind;

        while resolved_kind == TokenKind::AtComment {
            // we should be accumulating these into attributes, but for now
            // just brush them off so they don't interfere with parsing
            self.advance();
            return self.check(pre);
        }

        if resolved_kind == TokenKind::TkError {
            if !self.in_recovery {
                self.diag->report(DiagID::S045E, self._current->range.start,
                    f"unexpected token found where '{token_kind_to_readable_string(static_cast::<TokenKind>(resolved.imm))}' expected"
                ).first(self._current->range).emit();
            }
            resolved_kind = static_cast::<TokenKind>(resolved.imm);
        }

        return pre(resolved_kind);
    }

    inline pub fn check_prev(self, kind: TokenKind) -> bool {
        return self._resolve_and_check(self._prev, kind, false);
    }

    inline pub fn check_peek(self, kind: TokenKind) -> bool {
        return self._resolve_and_check(self._peek, kind, true);
    }

    inline pub fn match_tok(self, kind: TokenKind) -> bool {
        if self.check(kind) {
            self.advance();
            return true;
        }

        return false;
    }

    inline pub fn expect(self, kind: TokenKind) -> Token {
        var tok = self._current;
        if tok == &null {
            // unexpected EOF emit diag with best available location
            var eof_range = (self._prev->range) if (self._prev != &null) else SourceRange::invalid();
            self.diag->report(DiagID::S045E, eof_range.start,
                f"expected '{token_kind_to_readable_string(kind)}', found end of file"
            ).first(eof_range).emit();

            var err   = Token();
            err.kind  = TokenKind::TkError;
            err.range = eof_range;
            err.imm   = static_cast::<u32>(kind);
            return err;
        }

        var resolved = self.resolve_deep(tok);
        var resolved_kind = resolved.kind;

        if resolved_kind == TokenKind::AtComment {
            // brush off
            self.advance();
            return self.expect(kind);
        }

        if resolved_kind == TokenKind::TkError {
            // recovery token extract what was expected
            resolved_kind = static_cast::<TokenKind>(resolved.imm);
        }

        if resolved_kind == kind {
            self.advance();
            return resolved;
        }

        self.diag->report(DiagID::S045E, tok->range.start,
            f"expected '{token_kind_to_readable_string(kind)}', found '{token_kind_to_readable_string(resolved_kind)}' "
        ).first(tok->range).emit();

        if tok->kind == TokenKind::TkMacroExpand {
            var builder = self.diag->report(DiagID::S045N, tok->range.start,
                f"expected '{token_kind_to_readable_string(kind)}', found '{token_kind_to_readable_string(resolved_kind)}' "
            ).first(tok->range);
            self.attach_macro_expansion_chain(&builder, tok);
            builder.emit();
        }

        var err     = Token();
        err.kind    = TokenKind::TkError;
        err.range   = tok->range;
        err.imm     = static_cast::<u32>(kind);
        return err;
    }

    // ========================================================================
    //  Macro expansion chain diagnostics
    // ========================================================================

    inline pub fn attach_macro_expansion_chain(self, builder: *DiagBuilder, tok: *Token) {
        if tok == &null { return; }
        if static_cast::<u32>(tok->kind) != static_cast::<u32>(TokenKind::TkMacroExpand) { return; }

        var kind = tok->kind;
        var imm  = tok->imm;
        var depth: u32 = 0;

        while static_cast::<u32>(kind) == static_cast::<u32>(TokenKind::TkMacroExpand) {
            if depth >= static_cast::<u32>(self.ctx->ci->pp.max_backtrace) {
                builder->note(DiagID::S045N, tok->range.start,
                    f"macro expansion chain truncated after {depth} levels"
                );
                return;
            }

            if imm >= static_cast::<u32>(MacroSentinel::Threshold) {
                builder->note(DiagID::S045N, tok->range.start,
                    f"expanded from compiler-internal macro sentinel"
                );
                return;
            }

            if self.imm == &null { return; }

            var info = self.imm->get::<Immediate::MacroExpansionInfo>(imm);

            builder->note(DiagID::S045N, info->def_range.start,
                f"expanded from macro defined here (depth {depth})"
            );

            kind  = info->original_kind;
            imm   = info->original_imm;
            depth += 1;
        }
    }

    // ========================================================================
    //  EOF / first-token queries
    // ========================================================================

    inline pub fn is_eof(self) -> bool {
        return (self._current == &null)
            || (self._current->kind == TokenKind::TkEof);
    }

    inline pub fn first(self) -> *Token {
        if (self.span.size()) > 0 {
            return self.span.get(0);
        }

        return &null;
    }

    // ========================================================================
    //  Annotation consumption
    //
    //  Eats leading @attr tokens, doc-comments (///), line-comments (//),
    //  block-comments (/* */), and visibility keywords (pub, priv, protected,
    //  internal) before the next syntactic production. Fills _pending_annot
    //  which is then stamped onto the resulting AST node.
    //
    //  AtComment tokens may be raw or macro-expanded. The resolve path
    //  handles expansions transparently.
    // ========================================================================

    /// Consume all leading annotations and visibility keywords before a
    /// decl/stmt/expr/type. Returns a reference to the internal accumulator.
    /// Caller must apply or discard before the next call.
    pub fn consume_leading_annotations(self, out: *PendingAnnotations) {
        out->clear();

        while !self.is_eof() {
            var tok = self._current;
            if tok == &null { break; }

            var resolved = self.resolve_deep(tok);

            if resolved.kind == TokenKind::AtComment {
                out->add(AnnotationKind::DocComment, InternedStr::invalid(), tok->range);
                self.advance();
                continue;
            }

            if resolved.kind == TokenKind::KwPub {
                out->set_visibility(
                    PendingAnnotations::VisAnnotation::VisibilityKind::Public, tok->range);
                self.advance();
                continue;
            }

            if resolved.kind == TokenKind::KwPriv {
                out->set_visibility(
                    PendingAnnotations::VisAnnotation::VisibilityKind::Private, tok->range);
                self.advance();
                continue;
            }

            if resolved.kind == TokenKind::KwProt {
                out->set_visibility(
                    PendingAnnotations::VisAnnotation::VisibilityKind::Protected, tok->range);
                self.advance();
                continue;
            }

            break;
        }
    }

    /// Stamp accumulated annotations onto a Decl node (which derives both
    /// Annotation<Decl> and VisibilityAnnotation<Decl>).
    pub fn apply_annotations_to_decl(self, decl: *Decl, annot: *PendingAnnotations) {
        if annot->empty() { return; }

        for var i: usize = 0; i < annot->entries.size(); ++i {
            var e = &annot->entries[i];
            decl->add_annotation(e->kind, e->name, e->range);
        }

        if annot->visibility != PendingAnnotations::VisAnnotation::VisibilityKind::None {
            decl->set_visibility(annot->visibility, annot->vis_range);
        }
    }

    /// Stamp accumulated annotations onto any node that derives Annotation<T>
    /// (Expr, Stmt, Type). These don't have visibility, so it's ignored;
    /// if visibility was present and we're applying to a non-decl, that's a
    /// semantic error the caller should diagnose.
    pub fn apply_annotations_to_node(self, node: *Expr, annot: *PendingAnnotations) {
        if annot->empty() { return; }
        for var i: usize = 0; i < annot->entries.size(); ++i {
            var e = &annot->entries[i];
            node->add_annotation(e->kind, e->name, e->range);
        }
    }

    pub fn apply_annotations_to_node(self, node: *Stmt, annot: *PendingAnnotations) {
        if annot->empty() { return; }
        for var i: usize = 0; i < annot->entries.size(); ++i {
            var e = &annot->entries[i];
            node->add_annotation(e->kind, e->name, e->range);
        }
    }

    pub fn apply_annotations_to_node(self, node: *Type, annot: *PendingAnnotations) {
        if annot->empty() { return; }
        for var i: usize = 0; i < annot->entries.size(); ++i {
            var e = &annot->entries[i];
            node->add_annotation(e->kind, e->name, e->range);
        }
    }

    // ========================================================================
    //  Type qualifier consumption
    //
    //  Eats leading qualifier keywords (const, volatile, restrict, atomic,
    //  unsafe, eval, async, yield) before the core type production. Fills
    //  _pending_quals which the type parser stamps onto the resulting Type.
    //
    //  Qualifier keywords may be macro-expanded; resolve_deep handles this.
    // ========================================================================

    /// Consume all leading type qualifier keywords. Returns a reference to
    /// the internal accumulator. Caller must apply or discard before the
    /// next call.
    pub fn consume_leading_quals(self, out: *PendingQuals) {
        out->clear();

        while !self.is_eof() {
            var tok = self._current;
            if tok == &null { break; }

            var resolved = self.resolve_deep(tok);
            var rk = resolved.kind;

            if      rk == TokenKind::KwConst    { out->add(PendingQuals::TypeQualifier::Flags::IsConst,    tok->range); }
            else if rk == TokenKind::KwVolatile { out->add(PendingQuals::TypeQualifier::Flags::IsVolatile, tok->range); }
            else if rk == TokenKind::KwAtomic   { out->add(PendingQuals::TypeQualifier::Flags::IsAtomic,   tok->range); }
            else if rk == TokenKind::KwUnsafe   { out->add(PendingQuals::TypeQualifier::Flags::IsUnsafe,   tok->range); }
            else if rk == TokenKind::KwEval     { out->add(PendingQuals::TypeQualifier::Flags::IsEval,     tok->range); }
            else if rk == TokenKind::KwAsync    { out->add(PendingQuals::TypeQualifier::Flags::IsAsync,    tok->range); }
            else if rk == TokenKind::KwYield    { out->add(PendingQuals::TypeQualifier::Flags::IsYield,    tok->range); }
            else { break; }

            self.advance();
        }
    }

    pub fn apply_quals(self, ty: *Type, quals: *PendingQuals) {
        if quals->empty() { return; }

        ty->flags |= quals->flags;
        for var i: usize = 0; i < quals->spans.size(); ++i {
            ty->spans.push(*(&quals->spans[i]));
        }
    }

    // ========================================================================
    //  Recovery primitives
    // ========================================================================

    /// Tentative parse save/restore. Used for ambiguity: Foo<T>(x), etc.
    /// Returns an opaque state; pass to commit() or rollback().
    fn tentative_begin(self) -> usize {
        return self.c_idx;
    }

    fn tentative_commit(self, state: usize) {
        // no-op currently parse proceeds. State was just a saved cursor.
    }

    fn tentative_rollback(self, state: usize) {
        self.c_idx = state;
        self._prev = (self.span.get(self.c_idx - 1)) if (self.c_idx > 0) else (&null);
        self._sync_cursor();
    }

    /// Skip tokens until one in the sync set or EOF. Returns the matched set
    /// or SyncSet::None if hit EOF.
    fn skip_until(self, set: SyncSet) -> SyncSet {
        // TODO
        return SyncSet::None;
    }

    /// Recursion depth guard. Call before descending into a recursive parse.
    /// Returns false if max depth exceeded emit a diag and bail.
    fn enter_depth(self) -> bool {
        if self.depth >= self.max_depth {
            // TODO: diag
            return false;
        }
        ++self.depth;
        return true;
    }

    fn exit_depth(self) {
        if self.depth > 0 { --self.depth; }
    }

    // ========================================================================
    //  Scope primitives
    // ========================================================================

    fn enter_scope(self, kind: ScopeKind, dc: *DeclContext) -> *LexicalScope {
        return self.scope.push(kind, dc);
    }

    fn exit_scope(self) {
        self.scope.pop();
    }

    // ========================================================================
    //  Unified lookup (lexical -> hoisted -> global)
    // ========================================================================

    /// Looks up a name with full scope walking.
    /// Not used by parser hot paths (parser uses HoistedScope directly for
    /// disambiguation); provided for completion and hover consumers.
    fn lookup(self, name: string) -> ParentRef {
        var local = self.scope.lookup(name);
        if local != &null {
            return ParentRef::from_decl(local->decl);
        }

        var hr = self.ctx->hoisted->lookup(name);
        if hr.found() {
            return ParentRef::from_hoisted(hr.first());
        }

        return ParentRef::none();
    }

    // ========================================================================
    //  Completion hooks
    // ========================================================================

    /// Called by mixins when the parser reaches a completion-relevant point.
    /// No-op if no consumer is attached.
    fn maybe_complete(self, kind: CompletionContextKind) {
        if self.cc == &null { return; }

        // TODO: only fire if self._current is at/past cc.cursor_loc.
        self.cc->on_completion(kind, self.scope.current_dc());
    }

    fn maybe_complete_member(self, base: *Expr, is_arrow: bool) {
        if self.cc == &null { return; }
        self.cc->on_member_access(base, is_arrow);
    }

    fn maybe_complete_qualified(self, scope: *ScopeNode) {
        if self.cc == &null { return; }
        self.cc->on_qualified_name(scope);
    }

    fn maybe_complete_sighelp(self, callee: *Expr, arg_index: u32) {
        if self.cc == &null { return; }
        self.cc->on_signature_help(callee, arg_index);
    }
}