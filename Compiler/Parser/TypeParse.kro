[-] NamedType
[ ] DependentNameType
[ ] GenericParamType
[ ] SubstGenericParamType
[ ] GenericInstanceType
[ ] TypeOfType
[ ] VariadicPackType
[ ] PackExpansionType
[x] PointerType
[x] TupleType
