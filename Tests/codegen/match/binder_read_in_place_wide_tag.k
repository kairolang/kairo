    V299 { x: i32 },
}

fn pick(p: *[Wide; 3], i: i32, k: i32) -> i32 = match (*p)[i] {
    case .V0(var x) => if x > k => x else => k
    case .V299(var x) => if x < k => x else => k
    default => -1
}

fn main() -> i32 {
    var p: [Wide; 3] = [.V0 { x: 5 }, .V299 { x: 1 }, .V7 { x: 3 }]

    println(
        f"{pick(&p, 0, 2)} {pick(&p, 1, 2)} {pick(&p, 2, 2)} {pick(&p, 0, 9)} {pick(&p, 1, 0)}",
    )

    return 0
}

// --- lit wiring -----------------------------------------------------------
// REQUIRES: clang
// RUN: { %kairo %s --type-check-only 2>&1 || true; } | %FileCheck %s --check-prefix=DIAG --allow-empty
// DIAG-NOT: {{error|warning}}
// RUN: { %kairo %s --print-ir 2>&1 || true; } | %FileCheck %s --check-prefix=IR
// IR:      enum class __kairo_Tag: unsigned short
// IR:      const signed int & x = __kairo_m0_s.__kairo_V0.x;
// IR:      const signed int & x = __kairo_m0_s.__kairo_V299.x;
// RUN: rm -rf %t.d
// RUN: rm -f %t.exe
// RUN: %kairo %s -O0 -o %t.exe --cache-dir %t.d/o0
// RUN: %t.exe | %FileCheck %s --check-prefix=OUT
// RUN: rm -f %t.exe
// RUN: %kairo %s -O2 -o %t.exe --cache-dir %t.d/o2
// RUN: %t.exe | %FileCheck %s --check-prefix=OUT
// OUT: 5 1 -1 9 0
