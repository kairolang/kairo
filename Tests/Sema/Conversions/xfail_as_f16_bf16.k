import std::c_char
import std::io::println

fn one_f16(k: i32) -> f16 { return 1 as f16; }
fn one_bf16(k: i32) -> bf16 { return 1 as bf16; }

fn main() -> i32 {
    var bad = 0;
    var x_f16 = one_f16(0);
    var x_bf16 = one_bf16(0);
    if ((x_f16 as bf16) as f16) != x_f16 { println("f16 -> bf16"); bad += 1; }
    if ((x_bf16 as f16) as bf16) != x_bf16 { println("bf16 -> f16"); bad += 1; }
    println(f"checked {bad}");
    return bad;
}

