// RUN: { %kairo %s --type-check-only 2>&1 || true; } | %FileCheck %s
// An integer literal wider than 128 bits fits a 256-bit type when its
// value does, and a rejection quotes the literal as written, not its low word.
// CHECK-NOT: error [SC075E]: literal '0'
// CHECK: error [SC075E]: literal '1606938044258990275541962092341162602522202993782792835301376' does not fit in 'u128'
// CHECK-NEXT: error [SC075E]: literal '340282366920938463463374607431768211456' does not fit in 'u128'
// CHECK-NEXT: error [SC075E]: literal '57896044618658097711785492504343953926634992332820282019728792003956564819968' does not fit in 'i256'
// CHECK-NEXT: error [SC075E]: literal '115792089237316195423570985008687907853269984665640564039457584007913129639936' does not fit in 'u256'
// CHECK-NEXT: error [SC075E]: literal '0x1_0000_0000_0000_0000_0000_0000_0000_0000' does not fit in 'u128'
// CHECK-NOT: error
fn main() -> i32 {
    var a: u256 = 1606938044258990275541962092341162602522202993782792835301376
    var b: i256 = 1606938044258990275541962092341162602522202993782792835301376
    var c: u128 = 1606938044258990275541962092341162602522202993782792835301376
    var d: u128 = 340282366920938463463374607431768211455
    var e: u128 = 340282366920938463463374607431768211456
    var f: i256 = 57896044618658097711785492504343953926634992332820282019728792003956564819968
    var g: i256 = -57896044618658097711785492504343953926634992332820282019728792003956564819968
    var h: u256 = 115792089237316195423570985008687907853269984665640564039457584007913129639936
    var i: u256 = 115792089237316195423570985008687907853269984665640564039457584007913129639935
    var j: u128 = 0x1_0000_0000_0000_0000_0000_0000_0000_0000
    return 0
}
