fn main() -> i32 {
    var blob       = texts()
    var off: usize = 0
    var bad        = 0
    for var i: usize = 0; i < 21538; ++i {
        var end = off
        while blob[end] != ';' {
            end += 1
        }

        var want = blob[off..end]
        var v    = __builtin_bitcast<f64, u64>(BITS[i])
        var got  = v as string
        var fs   = f"{v}"
        var neg_nan = want == "nan" && (BITS[i] >> 63) != 0
        var fs_ok   = fs == want || (neg_nan && fs == "-nan")
        var app  = string()
        v.append_to(&app)
        if got != want || app != want || !fs_ok {
            bad += 1
            if bad <= 20 {
                io::println(f"FAIL case {i}: bits {BITS[i]:#x} printed {got} / {app} / {fs}, want {want}")
            }
        } else {
            var r?  = f64::from_str(got)
            var err = reason_of<f64>(got)
            var nan = (BITS[i] & 0x7FFFFFFFFFFFFFFFu64) > 0x7FF0000000000000u64
            if !(r?) || err.kind != ParseErrorKind::None || (!nan && r.to_bits() != BITS[i]) {
                bad += 1
                if bad <= 20 {
                    io::println(f"FAIL case {i}: {got} read back as {if r? => r.to_bits() else => 0}, want bits {BITS[i]:#x}")
                }
            }
        }

        off = end + 1
    }

    if bad != 0 {
        io::println(f"{bad} of 21538 cases failed")
        return 1
    }

    io::println("ok 21538 cases")
    return 0
}

