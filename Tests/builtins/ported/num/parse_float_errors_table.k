fn main() -> i32 {
    var blob       = texts()
    var off: usize = 0
    var bad        = 0
    for var i: usize = 0; i < 13060; ++i {
        var t = blob[off..(off + (LEN[i] as usize))]
        off += LEN[i] as usize
        var want = KIND[i]

        var r64? = f64::from_str(t)
        var e64  = reason_of<f64>(t)
        var ok64 = (e64.kind as u8) == want
        if want == 0 {
            var nan64 = W64[i] == 0xFFFFFFFFFFFFFFFFu64
            ok64 = ok64 && r64? && e64.at == 0 && (if nan64 => r64.is_nan() else => r64.to_bits() == W64[i])
        } else {
            ok64 = ok64 && !(r64?) && e64.at == (AT[i] as u32)
        }

        var r32? = f32::from_str(t)
        var e32  = reason_of<f32>(t)
        var ok32 = (e32.kind as u8) == want
        if want == 0 {
            var nan32 = W32[i] == 0xFFFFFFFFu32
            ok32 = ok32 && r32? && e32.at == 0 && (if nan32 => r32.is_nan() else => r32.to_bits() == W32[i])
        } else {
            ok32 = ok32 && !(r32?) && e32.at == (AT[i] as u32)
        }

        if !ok64 || !ok32 {
            bad += 1
            if bad <= 20 {
                io::println(f"FAIL case {i} (f64 ok {ok64}, f32 ok {ok32}): want kind {want} at {AT[i]}; f64 gave kind {e64.kind as u8} at {e64.at}, f32 gave kind {e32.kind as u8} at {e32.at}")
            }
        }
    }

    if bad != 0 {
        io::println(f"{bad} of 13060 cases failed")
        return 1
    }

    io::println("ok 13060 cases")
    return 0
}

// --- lit wiring ---
// RUN: rm -rf %t.d %t.exe %t.o2.exe
// RUN: %kairo %s -o %t.exe --cache-dir %t.d
// RUN: %kairo %s -O2 -o %t.o2.exe --cache-dir %t.d
// RUN: %t.exe | %FileCheck %s
// RUN: %t.o2.exe | %FileCheck %s
// CHECK: ok 13060 cases
