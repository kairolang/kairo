// Text to f64 and f32: 13060 generated texts, most of them not numbers, each with the error
// kind and byte offset it must report (or the value it must give).
//
// Generated by a table generator; do not edit by hand. The expectations come from the
// grammar documented on parse_f64: the number is the longest prefix of the form
// [+-](digits[.digits] | .digits)[(e|E)[+-]digits], or [+-]inf, [+-]infinity, [+-]nan in any
// case; text with no such prefix is InvalidChar at its first byte after the sign, bytes after
// the prefix are Trailing at the first of them (an exponent mark with no digit after it is such
// a byte), empty text is Empty and a lone sign is InvalidChar at offset 0. An accepted text
// gives the value of the exact decimal (nearest float, ties to even), an infinity, or a NaN.
// The texts: every string of up to four bytes over the alphabet + - 0 7 . e E _ space x;
// every letter case of inf, infinity and nan, signed and with a trailing byte; hex floats,
// underscores, a trailing type letter, other whitespace, non-ASCII digits; one invalid byte
// inserted at every position of valid texts; random strings.
// Cases from Rust library/coretests/tests/num/dec2flt/mod.rs (lonely_dot, exponentiated_dot,
// lonely_sign, whitespace) and dec2flt/parse.rs (missing_pieces, invalid_chars)
// Cases from Rust library/coretests/tests/num/float_ieee754_flt2dec_dec2flt.rs (inf and nan spellings)

import std::io

// The reason `t.try_parse<T>()` raises: kind None at 0 when it accepts `t`.
fn <T impl FromStr> reason_of(const t: string) -> ParseError {
    try {
        var v = t.try_parse<T>()
        return ParseError { at: 0, kind: ParseErrorKind::None }
    } catch e: ParseError {
        return e
    }
}

