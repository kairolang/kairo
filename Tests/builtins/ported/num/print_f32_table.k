// f32 to text: 20800 generated bit patterns, each with its shortest round-trip text.
//
// Generated by a table generator with a fixed seed; do not edit by hand. The expected
// digits are the shortest decimal that reads back as the same value, closest to it among
// the shortest (an exact search over integer arithmetic, checked against repr on f64 samples); the layout is the documented one:
// plain notation when the first digit has decimal exponent e with -4 <= e < 9, otherwise
// d[.ddd]e[+-]XX with at least two exponent digits; a whole number has no point; zero is
// 0 or -0, infinities inf and -inf, every NaN nan. The bit patterns cover every exponent
// with an empty, a one-bit, a full and 77 random mantissas and either sign, plus
// k * 10^j values. Each value is printed by `as string`, by append_to and by an f-string
// hole (the same text, except that an f-string hole keeps the sign of a NaN and prints
// -nan: documented on put_f64 / put_f32). Each text is also read back and must give the
// same bits.
// Cases from Rust library/coretests/tests/num/flt2dec/ (shortest printing) and
// library/coretests/tests/num/float_ieee754_flt2dec_dec2flt.rs (round trip)

import std::io

// The reason `t.try_parse<T>()` raises: kind None at 0 when it accepts `t`.
fn <T impl FromStr> reason_of(const t: string) -> ParseError {
    try {
        var v = t.try_parse<T>()
        return ParseError { at: 0, kind: ParseErrorKind::None }
    } catch e: ParseError {
        return e
    }
}

