fn shown(const t: string) -> string {
    if t.size() > 90 {
        return f"{t[0..90]}...({t.size()} bytes)"
    }

    return t.copy()
}

fn main() -> i32 {
    var blob   = texts()
    var off: usize = 0
    var bad    = 0
    var over   = 0
    for var i: usize = 0; i < 23442; ++i {
        var end = off
        while blob[end] != ';' {
            end += 1
        }

        var t   = blob[off..end]
        var r?  = f64::from_str(t)
        var err = reason_of<f64>(t)
        var want = WANT[i]
        var ok   = false
        if want == 0xFFFFFFFFFFFFFFFFu64 {
            ok = !(r?) && err.kind == ParseErrorKind::Overflow
            over += 1
        } else {
            ok = r? && err.kind == ParseErrorKind::None && r.to_bits() == want
        }

        if !ok {
            bad += 1
            if bad <= 20 {
                io::println(f"FAIL case {i}: {shown(t)} want {want:#x} (kind {err.kind as u8})")
            }
        }

        off = end + 1
    }

    if bad != 0 {
        io::println(f"{bad} of 23442 cases failed")
        return 1
    }

    io::println(f"ok 23442 cases, {over} overflow")
    return 0
}

