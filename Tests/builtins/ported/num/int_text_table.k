fn check_i32() -> i32 {
    var blob        = i32_texts()
    var canon       = i32_canon()
    var off: usize  = 0
    var coff: usize = 0
    var bad         = 0
    for var i: usize = 0; i < 1702; ++i {
        var t = blob[off..(off + (i32_LEN[i] as usize))]
        off += i32_LEN[i] as usize
        var want = i32_KIND[i]
        var r?   = i32::from_str(t)
        var err  = reason_of<i32>(t)
        var ok   = (err.kind as u8) == want
        if want == 0 {
            var c = canon[coff..(coff + (i32_CLEN[i] as usize))]
            coff += i32_CLEN[i] as usize
            if r? && ok && err.at == 0 {
                var v: i32 = r ?? 0
                var a = string()
                v.append_to(&a)
                var fs = f"{v}"
                var by = v as string
                ok = a == c && fs == c && by == c
            } else {
                ok = false
            }
        } else {
            ok = ok && !(r?) && err.at == (i32_AT[i] as u32)
        }

        if !ok {
            bad += 1
            if bad <= 10 {
                io::println(f"FAIL i32 case {i}: want kind {want} at {i32_AT[i]}, got kind {err.kind as u8} at {err.at}")
            }
        }
    }

    return bad
}

