fn check_i8() -> i32 {
    var blob        = i8_texts()
    var canon       = i8_canon()
    var off: usize  = 0
    var coff: usize = 0
    var bad         = 0
    for var i: usize = 0; i < 1327; ++i {
        var t = blob[off..(off + (i8_LEN[i] as usize))]
        off += i8_LEN[i] as usize
        var want = i8_KIND[i]
        var r?   = i8::from_str(t)
        var err  = reason_of<i8>(t)
        var ok   = (err.kind as u8) == want
        if want == 0 {
            var c = canon[coff..(coff + (i8_CLEN[i] as usize))]
            coff += i8_CLEN[i] as usize
            if r? && ok && err.at == 0 {
                var v: i8 = r ?? 0
                var a = string()
                v.append_to(&a)
                var fs = f"{v}"
                var by = v as string
                ok = a == c && fs == c && by == c
            } else {
                ok = false
            }
        } else {
            ok = ok && !(r?) && err.at == (i8_AT[i] as u32)
        }

        if !ok {
            bad += 1
            if bad <= 10 {
                io::println(f"FAIL i8 case {i}: want kind {want} at {i8_AT[i]}, got kind {err.kind as u8} at {err.at}")
            }
        }
    }

    return bad
}

