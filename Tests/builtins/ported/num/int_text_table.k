fn check_u32() -> i32 {
    var blob        = u32_texts()
    var canon       = u32_canon()
    var off: usize  = 0
    var coff: usize = 0
    var bad         = 0
    for var i: usize = 0; i < 1759; ++i {
        var t = blob[off..(off + (u32_LEN[i] as usize))]
        off += u32_LEN[i] as usize
        var want = u32_KIND[i]
        var r?   = u32::from_str(t)
        var err  = reason_of<u32>(t)
        var ok   = (err.kind as u8) == want
        if want == 0 {
            var c = canon[coff..(coff + (u32_CLEN[i] as usize))]
            coff += u32_CLEN[i] as usize
            if r? && ok && err.at == 0 {
                var v: u32 = r ?? 0
                var a = string()
                v.append_to(&a)
                var fs = f"{v}"
                var by = v as string
                ok = a == c && fs == c && by == c
            } else {
                ok = false
            }
        } else {
            ok = ok && !(r?) && err.at == (u32_AT[i] as u32)
        }

        if !ok {
            bad += 1
            if bad <= 10 {
                io::println(f"FAIL u32 case {i}: want kind {want} at {u32_AT[i]}, got kind {err.kind as u8} at {err.at}")
            }
        }
    }

    return bad
}

