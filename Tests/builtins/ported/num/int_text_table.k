fn check_usize() -> i32 {
    var blob        = usize_texts()
    var canon       = usize_canon()
    var off: usize  = 0
    var coff: usize = 0
    var bad         = 0
    for var i: usize = 0; i < 2152; ++i {
        var t = blob[off..(off + (usize_LEN[i] as usize))]
        off += usize_LEN[i] as usize
        var want = usize_KIND[i]
        var r?   = usize::from_str(t)
        var err  = reason_of<usize>(t)
        var ok   = (err.kind as u8) == want
        if want == 0 {
            var c = canon[coff..(coff + (usize_CLEN[i] as usize))]
            coff += usize_CLEN[i] as usize
            if r? && ok && err.at == 0 {
                var v: usize = r ?? 0
                var a = string()
                v.append_to(&a)
                var fs = f"{v}"
                var by = v as string
                ok = a == c && fs == c && by == c
            } else {
                ok = false
            }
        } else {
            ok = ok && !(r?) && err.at == (usize_AT[i] as u32)
        }

        if !ok {
            bad += 1
            if bad <= 10 {
                io::println(f"FAIL usize case {i}: want kind {want} at {usize_AT[i]}, got kind {err.kind as u8} at {err.at}")
            }
        }
    }

    return bad
}

fn main() -> i32 {
    var bad = 0
    var b_i8 = check_i8()
    bad += b_i8
    var b_i16 = check_i16()
    bad += b_i16
    var b_i32 = check_i32()
    bad += b_i32
    var b_i64 = check_i64()
    bad += b_i64
    var b_isize = check_isize()
    bad += b_isize
    var b_u8 = check_u8()
    bad += b_u8
    var b_u16 = check_u16()
    bad += b_u16
    var b_u32 = check_u32()
    bad += b_u32
    var b_u64 = check_u64()
    bad += b_u64
    var b_usize = check_usize()
    bad += b_usize
    if bad != 0 {
        io::println(f"{bad} cases failed")
        return 1
    }

    io::println("ok 17609 cases")
    return 0
}

