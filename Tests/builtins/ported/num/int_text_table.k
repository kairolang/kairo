fn check_u64() -> i32 {
    var blob        = u64_texts()
    var canon       = u64_canon()
    var off: usize  = 0
    var coff: usize = 0
    var bad         = 0
    for var i: usize = 0; i < 2156; ++i {
        var t = blob[off..(off + (u64_LEN[i] as usize))]
        off += u64_LEN[i] as usize
        var want = u64_KIND[i]
        var r?   = u64::from_str(t)
        var err  = reason_of<u64>(t)
        var ok   = (err.kind as u8) == want
        if want == 0 {
            var c = canon[coff..(coff + (u64_CLEN[i] as usize))]
            coff += u64_CLEN[i] as usize
            if r? && ok && err.at == 0 {
                var v: u64 = r ?? 0
                var a = string()
                v.append_to(&a)
                var fs = f"{v}"
                var by = v as string
                ok = a == c && fs == c && by == c
            } else {
                ok = false
            }
        } else {
            ok = ok && !(r?) && err.at == (u64_AT[i] as u32)
        }

        if !ok {
            bad += 1
            if bad <= 10 {
                io::println(f"FAIL u64 case {i}: want kind {want} at {u64_AT[i]}, got kind {err.kind as u8} at {err.at}")
            }
        }
    }

    return bad
}

