fn check_isize() -> i32 {
    var blob        = isize_texts()
    var canon       = isize_canon()
    var off: usize  = 0
    var coff: usize = 0
    var bad         = 0
    for var i: usize = 0; i < 1993; ++i {
        var t = blob[off..(off + (isize_LEN[i] as usize))]
        off += isize_LEN[i] as usize
        var want = isize_KIND[i]
        var r?   = isize::from_str(t)
        var err  = reason_of<isize>(t)
        var ok   = (err.kind as u8) == want
        if want == 0 {
            var c = canon[coff..(coff + (isize_CLEN[i] as usize))]
            coff += isize_CLEN[i] as usize
            if r? && ok && err.at == 0 {
                var v: isize = r ?? 0
                var a = string()
                v.append_to(&a)
                var fs = f"{v}"
                var by = v as string
                ok = a == c && fs == c && by == c
            } else {
                ok = false
            }
        } else {
            ok = ok && !(r?) && err.at == (isize_AT[i] as u32)
        }

        if !ok {
            bad += 1
            if bad <= 10 {
                io::println(f"FAIL isize case {i}: want kind {want} at {isize_AT[i]}, got kind {err.kind as u8} at {err.at}")
            }
        }
    }

    return bad
}

