fn check_u16() -> i32 {
    var blob        = u16_texts()
    var canon       = u16_canon()
    var off: usize  = 0
    var coff: usize = 0
    var bad         = 0
    for var i: usize = 0; i < 1599; ++i {
        var t = blob[off..(off + (u16_LEN[i] as usize))]
        off += u16_LEN[i] as usize
        var want = u16_KIND[i]
        var r?   = u16::from_str(t)
        var err  = reason_of<u16>(t)
        var ok   = (err.kind as u8) == want
        if want == 0 {
            var c = canon[coff..(coff + (u16_CLEN[i] as usize))]
            coff += u16_CLEN[i] as usize
            if r? && ok && err.at == 0 {
                var v: u16 = r ?? 0
                var a = string()
                v.append_to(&a)
                var fs = f"{v}"
                var by = v as string
                ok = a == c && fs == c && by == c
            } else {
                ok = false
            }
        } else {
            ok = ok && !(r?) && err.at == (u16_AT[i] as u32)
        }

        if !ok {
            bad += 1
            if bad <= 10 {
                io::println(f"FAIL u16 case {i}: want kind {want} at {u16_AT[i]}, got kind {err.kind as u8} at {err.at}")
            }
        }
    }

    return bad
}

