// Unsigned integers (u8, u16, u32, u64, usize) in decimal: zero, one, the maximum and its neighbour, every sign / width / fill / alignment / zero-padding combination on the maximum.
// Rules asserted (library docs): an integer hole prints in decimal or, with `x`, `X`, `o`, `b`, in that base; `#` adds the
// 0x / 0o / 0b prefix, `+` a sign, `0` pads with zeros after the sign and prefix, width and fill pad in code points and numbers
// default to right alignment (website library/core/formatting.mdx, FmtBuf.put_i8 .. put_u512; Lib/builtin/fmt/fmt_buf.k
// number_). The spec grammar is the one in the comment above `_parse_spec` in Compiler/Sema/Type/LiteralTyping.k.
// Expected texts come from a Python oracle that applies those rules to exact Python integers.
// Not asserted because the docs do not state them: negative values in a base, `#X`, `#` on decimal, `0` together with an
// explicit alignment, and the split of an odd amount of padding by `^` (centred cases use an even amount).
// Cases from Rust library/coretests/tests/fmt/num.rs (test_format_int_limits, test_format_int_flags, test_format_int_sign_padding)
// Cases from Rust library/coretests/tests/fmt/mod.rs (the integer flag cases)
// Cases from the {fmt} library test/format-test.cc (integer width, fill, alignment, sign, # and 0 cases)

import std::io::*

var CODE: i32 = 0

fn ck(const got: string, const want: string, id: i32, const name: string) {
    if !(got == want) {
        println(f"FAIL {name}: got [{got}] want [{want}]")
        if CODE == 0 {
            CODE = id
        }
    }
}

fn decimal_u8() {
    var v0: u8 = 0
    var v1: u8 = 1
    var v2: u8 = 42
    var v3: u8 = u8::MAX
    var v4: u8 = 254
    ck(f"{v0}", "0", 5, "u8 0 {}")
    ck(f"{v0:+}", "+0", 5, "u8 0 {+}")
    ck(f"{v0:3}", "  0", 5, "u8 0 {3}")
    ck(f"{v0:12}", "           0", 5, "u8 0 {12}")
    ck(f"{v0:<12}", "0           ", 5, "u8 0 {<12}")
    ck(f"{v0:>12}", "           0", 5, "u8 0 {>12}")
    ck(f"{v0:*<12}", "0***********", 5, "u8 0 {*<12}")
    ck(f"{v0:0>12}", "000000000000", 5, "u8 0 {0>12}")
    ck(f"{v0:→>12}", "→→→→→→→→→→→0", 5, "u8 0 {→>12}")
    ck(f"{v0:日<12}", "0日日日日日日日日日日日", 5, "u8 0 {日<12}")
    ck(f"{v0:+12}", "          +0", 5, "u8 0 {+12}")
    ck(f"{v0:012}", "000000000000", 5, "u8 0 {012}")
    ck(f"{v0:+012}", "+00000000000", 5, "u8 0 {+012}")
    ck(f"{v1}", "1", 5, "u8 1 {}")
    ck(f"{v1:+}", "+1", 5, "u8 1 {+}")
    ck(f"{v2}", "42", 5, "u8 42 {}")
    ck(f"{v2:+}", "+42", 5, "u8 42 {+}")
    ck(f"{v2:3}", " 42", 5, "u8 42 {3}")
    ck(f"{v2:12}", "          42", 5, "u8 42 {12}")
    ck(f"{v3}", "255", 5, "u8 255 {}")
    ck(f"{v3:+}", "+255", 5, "u8 255 {+}")
    ck(f"{v3:3}", "255", 5, "u8 255 {3}")
    ck(f"{v3:12}", "         255", 5, "u8 255 {12}")
    ck(f"{v3:<12}", "255         ", 5, "u8 255 {<12}")
    ck(f"{v3:>12}", "         255", 5, "u8 255 {>12}")
    ck(f"{v3:*<12}", "255*********", 5, "u8 255 {*<12}")
    ck(f"{v3:0>12}", "000000000255", 5, "u8 255 {0>12}")
    ck(f"{v3:→>12}", "→→→→→→→→→255", 5, "u8 255 {→>12}")
    ck(f"{v3:日<12}", "255日日日日日日日日日", 5, "u8 255 {日<12}")
    ck(f"{v3:+12}", "        +255", 5, "u8 255 {+12}")
    ck(f"{v3:012}", "000000000255", 5, "u8 255 {012}")
    ck(f"{v3:+012}", "+00000000255", 5, "u8 255 {+012}")
    ck(f"{v4}", "254", 5, "u8 254 {}")
    ck(f"{v4:+}", "+254", 5, "u8 254 {+}")
}

fn decimal_u16() {
    var v0: u16 = 0
    var v1: u16 = 1
    var v2: u16 = 42
    var v3: u16 = u16::MAX
    var v4: u16 = 65534
    ck(f"{v0}", "0", 6, "u16 0 {}")
    ck(f"{v0:+}", "+0", 6, "u16 0 {+}")
    ck(f"{v0:3}", "  0", 6, "u16 0 {3}")
    ck(f"{v0:12}", "           0", 6, "u16 0 {12}")
    ck(f"{v0:<12}", "0           ", 6, "u16 0 {<12}")
    ck(f"{v0:>12}", "           0", 6, "u16 0 {>12}")
    ck(f"{v0:*<12}", "0***********", 6, "u16 0 {*<12}")
    ck(f"{v0:0>12}", "000000000000", 6, "u16 0 {0>12}")
    ck(f"{v0:→>12}", "→→→→→→→→→→→0", 6, "u16 0 {→>12}")
    ck(f"{v0:日<12}", "0日日日日日日日日日日日", 6, "u16 0 {日<12}")
    ck(f"{v0:+12}", "          +0", 6, "u16 0 {+12}")
    ck(f"{v0:012}", "000000000000", 6, "u16 0 {012}")
    ck(f"{v0:+012}", "+00000000000", 6, "u16 0 {+012}")
    ck(f"{v1}", "1", 6, "u16 1 {}")
    ck(f"{v1:+}", "+1", 6, "u16 1 {+}")
    ck(f"{v2}", "42", 6, "u16 42 {}")
    ck(f"{v2:+}", "+42", 6, "u16 42 {+}")
    ck(f"{v2:3}", " 42", 6, "u16 42 {3}")
    ck(f"{v2:12}", "          42", 6, "u16 42 {12}")
    ck(f"{v3}", "65535", 6, "u16 65535 {}")
    ck(f"{v3:+}", "+65535", 6, "u16 65535 {+}")
    ck(f"{v3:3}", "65535", 6, "u16 65535 {3}")
    ck(f"{v3:12}", "       65535", 6, "u16 65535 {12}")
    ck(f"{v3:<12}", "65535       ", 6, "u16 65535 {<12}")
    ck(f"{v3:>12}", "       65535", 6, "u16 65535 {>12}")
    ck(f"{v3:*<12}", "65535*******", 6, "u16 65535 {*<12}")
    ck(f"{v3:0>12}", "000000065535", 6, "u16 65535 {0>12}")
    ck(f"{v3:→>12}", "→→→→→→→65535", 6, "u16 65535 {→>12}")
    ck(f"{v3:日<12}", "65535日日日日日日日", 6, "u16 65535 {日<12}")
    ck(f"{v3:+12}", "      +65535", 6, "u16 65535 {+12}")
    ck(f"{v3:012}", "000000065535", 6, "u16 65535 {012}")
    ck(f"{v3:+012}", "+00000065535", 6, "u16 65535 {+012}")
    ck(f"{v4}", "65534", 6, "u16 65534 {}")
    ck(f"{v4:+}", "+65534", 6, "u16 65534 {+}")
}

fn decimal_u32() {
    var v0: u32 = 0
    var v1: u32 = 1
    var v2: u32 = 42
    var v3: u32 = u32::MAX
    var v4: u32 = 4294967294
    ck(f"{v0}", "0", 7, "u32 0 {}")
    ck(f"{v0:+}", "+0", 7, "u32 0 {+}")
    ck(f"{v0:3}", "  0", 7, "u32 0 {3}")
    ck(f"{v0:12}", "           0", 7, "u32 0 {12}")
    ck(f"{v0:<12}", "0           ", 7, "u32 0 {<12}")
    ck(f"{v0:>12}", "           0", 7, "u32 0 {>12}")
    ck(f"{v0:*<12}", "0***********", 7, "u32 0 {*<12}")
    ck(f"{v0:0>12}", "000000000000", 7, "u32 0 {0>12}")
    ck(f"{v0:→>12}", "→→→→→→→→→→→0", 7, "u32 0 {→>12}")
    ck(f"{v0:日<12}", "0日日日日日日日日日日日", 7, "u32 0 {日<12}")
    ck(f"{v0:+12}", "          +0", 7, "u32 0 {+12}")
    ck(f"{v0:012}", "000000000000", 7, "u32 0 {012}")
    ck(f"{v0:+012}", "+00000000000", 7, "u32 0 {+012}")
    ck(f"{v1}", "1", 7, "u32 1 {}")
    ck(f"{v1:+}", "+1", 7, "u32 1 {+}")
    ck(f"{v2}", "42", 7, "u32 42 {}")
    ck(f"{v2:+}", "+42", 7, "u32 42 {+}")
    ck(f"{v2:3}", " 42", 7, "u32 42 {3}")
    ck(f"{v2:12}", "          42", 7, "u32 42 {12}")
    ck(f"{v3}", "4294967295", 7, "u32 big {}")
    ck(f"{v3:+}", "+4294967295", 7, "u32 big {+}")
    ck(f"{v3:3}", "4294967295", 7, "u32 big {3}")
    ck(f"{v3:12}", "  4294967295", 7, "u32 big {12}")
    ck(f"{v3:<12}", "4294967295  ", 7, "u32 big {<12}")
    ck(f"{v3:>12}", "  4294967295", 7, "u32 big {>12}")
    ck(f"{v3:*<12}", "4294967295**", 7, "u32 big {*<12}")
    ck(f"{v3:0>12}", "004294967295", 7, "u32 big {0>12}")
    ck(f"{v3:→>12}", "→→4294967295", 7, "u32 big {→>12}")
    ck(f"{v3:日<12}", "4294967295日日", 7, "u32 big {日<12}")
    ck(f"{v3:😀^12}", "😀4294967295😀", 7, "u32 big {😀^12}")
    ck(f"{v3:+12}", " +4294967295", 7, "u32 big {+12}")
    ck(f"{v3:012}", "004294967295", 7, "u32 big {012}")
    ck(f"{v3:+012}", "+04294967295", 7, "u32 big {+012}")
    ck(f"{v4}", "4294967294", 7, "u32 big {}")
    ck(f"{v4:+}", "+4294967294", 7, "u32 big {+}")
}

fn decimal_u64() {
    var v0: u64 = 0
    var v1: u64 = 1
    var v2: u64 = 42
    var v3: u64 = u64::MAX
    var v4: u64 = 18446744073709551614
    ck(f"{v0}", "0", 8, "u64 0 {}")
    ck(f"{v0:+}", "+0", 8, "u64 0 {+}")
    ck(f"{v0:3}", "  0", 8, "u64 0 {3}")
    ck(f"{v0:12}", "           0", 8, "u64 0 {12}")
    ck(f"{v0:<12}", "0           ", 8, "u64 0 {<12}")
    ck(f"{v0:>12}", "           0", 8, "u64 0 {>12}")
    ck(f"{v0:*<12}", "0***********", 8, "u64 0 {*<12}")
    ck(f"{v0:0>12}", "000000000000", 8, "u64 0 {0>12}")
    ck(f"{v0:→>12}", "→→→→→→→→→→→0", 8, "u64 0 {→>12}")
    ck(f"{v0:日<12}", "0日日日日日日日日日日日", 8, "u64 0 {日<12}")
    ck(f"{v0:+12}", "          +0", 8, "u64 0 {+12}")
    ck(f"{v0:012}", "000000000000", 8, "u64 0 {012}")
    ck(f"{v0:+012}", "+00000000000", 8, "u64 0 {+012}")
    ck(f"{v1}", "1", 8, "u64 1 {}")
    ck(f"{v1:+}", "+1", 8, "u64 1 {+}")
    ck(f"{v2}", "42", 8, "u64 42 {}")
    ck(f"{v2:+}", "+42", 8, "u64 42 {+}")
    ck(f"{v2:3}", " 42", 8, "u64 42 {3}")
    ck(f"{v2:12}", "          42", 8, "u64 42 {12}")
    ck(f"{v3}", "18446744073709551615", 8, "u64 big {}")
    ck(f"{v3:+}", "+18446744073709551615", 8, "u64 big {+}")
    ck(f"{v3:3}", "18446744073709551615", 8, "u64 big {3}")
    ck(f"{v3:12}", "18446744073709551615", 8, "u64 big {12}")
    ck(f"{v3:<12}", "18446744073709551615", 8, "u64 big {<12}")
    ck(f"{v3:>12}", "18446744073709551615", 8, "u64 big {>12}")
    ck(f"{v3:*<12}", "18446744073709551615", 8, "u64 big {*<12}")
    ck(f"{v3:0>12}", "18446744073709551615", 8, "u64 big {0>12}")
    ck(f"{v3:→>12}", "18446744073709551615", 8, "u64 big {→>12}")
    ck(f"{v3:日<12}", "18446744073709551615", 8, "u64 big {日<12}")
    ck(f"{v3:😀^12}", "18446744073709551615", 8, "u64 big {😀^12}")
    ck(f"{v3:+12}", "+18446744073709551615", 8, "u64 big {+12}")
    ck(f"{v3:012}", "18446744073709551615", 8, "u64 big {012}")
    ck(f"{v3:+012}", "+18446744073709551615", 8, "u64 big {+012}")
    ck(f"{v4}", "18446744073709551614", 8, "u64 big {}")
    ck(f"{v4:+}", "+18446744073709551614", 8, "u64 big {+}")
}

fn decimal_usize() {
    var v0: usize = 0
    var v1: usize = 1
    var v2: usize = 42
    var v3: usize = 1000000
    ck(f"{v0}", "0", 10, "usize 0 {}")
    ck(f"{v0:+}", "+0", 10, "usize 0 {+}")
    ck(f"{v0:3}", "  0", 10, "usize 0 {3}")
    ck(f"{v0:12}", "           0", 10, "usize 0 {12}")
    ck(f"{v0:<12}", "0           ", 10, "usize 0 {<12}")
    ck(f"{v0:+12}", "          +0", 10, "usize 0 {+12}")
    ck(f"{v0:012}", "000000000000", 10, "usize 0 {012}")
    ck(f"{v0:+012}", "+00000000000", 10, "usize 0 {+012}")
    ck(f"{v1}", "1", 10, "usize 1 {}")
    ck(f"{v1:+}", "+1", 10, "usize 1 {+}")
    ck(f"{v1:3}", "  1", 10, "usize 1 {3}")
    ck(f"{v1:12}", "           1", 10, "usize 1 {12}")
    ck(f"{v1:<12}", "1           ", 10, "usize 1 {<12}")
    ck(f"{v1:+12}", "          +1", 10, "usize 1 {+12}")
    ck(f"{v1:012}", "000000000001", 10, "usize 1 {012}")
    ck(f"{v1:+012}", "+00000000001", 10, "usize 1 {+012}")
    ck(f"{v2}", "42", 10, "usize 42 {}")
    ck(f"{v2:+}", "+42", 10, "usize 42 {+}")
    ck(f"{v2:3}", " 42", 10, "usize 42 {3}")
    ck(f"{v2:12}", "          42", 10, "usize 42 {12}")
    ck(f"{v2:<12}", "42          ", 10, "usize 42 {<12}")
    ck(f"{v2:😀^12}", "😀😀😀😀😀42😀😀😀😀😀", 10, "usize 42 {😀^12}")
    ck(f"{v2:+12}", "         +42", 10, "usize 42 {+12}")
    ck(f"{v2:012}", "000000000042", 10, "usize 42 {012}")
    ck(f"{v2:+012}", "+00000000042", 10, "usize 42 {+012}")
    ck(f"{v3}", "1000000", 10, "usize big {}")
    ck(f"{v3:+}", "+1000000", 10, "usize big {+}")
    ck(f"{v3:3}", "1000000", 10, "usize big {3}")
    ck(f"{v3:12}", "     1000000", 10, "usize big {12}")
    ck(f"{v3:<12}", "1000000     ", 10, "usize big {<12}")
    ck(f"{v3:+12}", "    +1000000", 10, "usize big {+12}")
    ck(f"{v3:012}", "000001000000", 10, "usize big {012}")
    ck(f"{v3:+012}", "+00001000000", 10, "usize big {+012}")
}

fn main() -> i32 {
    decimal_u8()
    decimal_u16()
    decimal_u32()
    decimal_u64()
    decimal_usize()
    if CODE == 0 {
        println("ok")
    }

    return CODE
}

// --- lit wiring ---
// RUN: rm -rf %t.d %t.exe %t.o2.exe
// RUN: %kairo %s -o %t.exe --cache-dir %t.d
// RUN: %t.exe | %FileCheck %s
// RUN: %kairo %s -O2 -o %t.o2.exe --cache-dir %t.d
// RUN: %t.o2.exe | %FileCheck %s
// CHECK-NOT: FAIL
// CHECK: ok
