    ck(f"{v7:14e}", "           inf", 1, "f64 inf {14e}")
    ck(f"{v7:+14E}", "          +INF", 1, "f64 inf {+14E}")
    ck(f"{v7:_<14.3e}", "inf___________", 1, "f64 inf {_<14.3e}")
    ck(f"{v8:1}", "-inf", 1, "f64 -inf {1}")
    ck(f"{v8:10}", "      -inf", 1, "f64 -inf {10}")
    ck(f"{v8:<10}", "-inf      ", 1, "f64 -inf {<10}")
    ck(f"{v8:>10}", "      -inf", 1, "f64 -inf {>10}")
    ck(f"{v8:^10}", "   -inf   ", 1, "f64 -inf {^10}")
    ck(f"{v8:*>10}", "******-inf", 1, "f64 -inf {*>10}")
    ck(f"{v8:→<10}", "-inf→→→→→→", 1, "f64 -inf {→<10}")
    ck(f"{v8:+}", "-inf", 1, "f64 -inf {+}")
    ck(f"{v8:+10}", "      -inf", 1, "f64 -inf {+10}")
    ck(f"{v8:0>+10}", "000000-inf", 1, "f64 -inf {0>+10}")
    ck(f"{v8:10.2}", "      -inf", 1, "f64 -inf {10.2}")
    ck(f"{v8:14e}", "          -inf", 1, "f64 -inf {14e}")
    ck(f"{v8:+14E}", "          -INF", 1, "f64 -inf {+14E}")
    ck(f"{v8:_<14.3e}", "-inf__________", 1, "f64 -inf {_<14.3e}")
    ck(f"{nan:1}", "nan", 1, "f64 nan {1}")
    ck(f"{nan:10}", "       nan", 1, "f64 nan {10}")
    ck(f"{nan:<10}", "nan       ", 1, "f64 nan {<10}")
