    ck(f"{v3:1}", "-0", 2, "f32 -0.0 {1}")
    ck(f"{v3:10}", "        -0", 2, "f32 -0.0 {10}")
    ck(f"{v3:<10}", "-0        ", 2, "f32 -0.0 {<10}")
