}

fn flags_f32() {
    var v0: f32 = 1.5e0
    var v1: f32 = -1.5e0
    var v2: f32 = 0.0e0
    var v3: f32 = -0.0e0
    var v4: f32 = 1.2345e3
    var v5: f32 = 5.0e-5
    var v6: f32 = 1.0e20
    var v7: f32 = f32::INFINITY
    var v8: f32 = (-f32::INFINITY)
    var nan: f32 = f32::NAN
    ck(f"{v0:1}", "1.5", 2, "f32 1.5 {1}")
    ck(f"{v0:10}", "       1.5", 2, "f32 1.5 {10}")
    ck(f"{v0:<10}", "1.5       ", 2, "f32 1.5 {<10}")
    ck(f"{v0:>10}", "       1.5", 2, "f32 1.5 {>10}")
    ck(f"{v0:*>10}", "*******1.5", 2, "f32 1.5 {*>10}")
    ck(f"{v0:→<10}", "1.5→→→→→→→", 2, "f32 1.5 {→<10}")
    ck(f"{v0:😀^11}", "😀😀😀😀1.5😀😀😀😀", 2, "f32 1.5 {😀^11}")
    ck(f"{v0:+}", "+1.5", 2, "f32 1.5 {+}")
    ck(f"{v0:+10}", "      +1.5", 2, "f32 1.5 {+10}")
    ck(f"{v0:0>+10}", "000000+1.5", 2, "f32 1.5 {0>+10}")
    ck(f"{v0:10.2}", "       1.5", 2, "f32 1.5 {10.2}")
    ck(f"{v0:14e}", "       1.5e+00", 2, "f32 1.5 {14e}")
    ck(f"{v0:+14E}", "      +1.5E+00", 2, "f32 1.5 {+14E}")
    ck(f"{v0:_<14.3e}", "1.500e+00_____", 2, "f32 1.5 {_<14.3e}")
    ck(f"{v1:1}", "-1.5", 2, "f32 -1.5 {1}")
    ck(f"{v1:10}", "      -1.5", 2, "f32 -1.5 {10}")
    ck(f"{v1:<10}", "-1.5      ", 2, "f32 -1.5 {<10}")
    ck(f"{v1:>10}", "      -1.5", 2, "f32 -1.5 {>10}")
    ck(f"{v1:^10}", "   -1.5   ", 2, "f32 -1.5 {^10}")
    ck(f"{v1:*>10}", "******-1.5", 2, "f32 -1.5 {*>10}")
    ck(f"{v1:→<10}", "-1.5→→→→→→", 2, "f32 -1.5 {→<10}")
    ck(f"{v1:+}", "-1.5", 2, "f32 -1.5 {+}")
    ck(f"{v1:+10}", "      -1.5", 2, "f32 -1.5 {+10}")
    ck(f"{v1:0>+10}", "000000-1.5", 2, "f32 -1.5 {0>+10}")
    ck(f"{v1:10.2}", "      -1.5", 2, "f32 -1.5 {10.2}")
    ck(f"{v1:14e}", "      -1.5e+00", 2, "f32 -1.5 {14e}")
    ck(f"{v1:+14E}", "      -1.5E+00", 2, "f32 -1.5 {+14E}")
    ck(f"{v1:_<14.3e}", "-1.500e+00____", 2, "f32 -1.5 {_<14.3e}")
    ck(f"{v2:1}", "0", 2, "f32 0.0 {1}")
    ck(f"{v2:10}", "         0", 2, "f32 0.0 {10}")
    ck(f"{v2:<10}", "0         ", 2, "f32 0.0 {<10}")
    ck(f"{v2:>10}", "         0", 2, "f32 0.0 {>10}")
    ck(f"{v2:*>10}", "*********0", 2, "f32 0.0 {*>10}")
    ck(f"{v2:→<10}", "0→→→→→→→→→", 2, "f32 0.0 {→<10}")
    ck(f"{v2:😀^11}", "😀😀😀😀😀0😀😀😀😀😀", 2, "f32 0.0 {😀^11}")
    ck(f"{v2:+}", "+0", 2, "f32 0.0 {+}")
    ck(f"{v2:+10}", "        +0", 2, "f32 0.0 {+10}")
    ck(f"{v2:0>+10}", "00000000+0", 2, "f32 0.0 {0>+10}")
    ck(f"{v2:10.2}", "         0", 2, "f32 0.0 {10.2}")
    ck(f"{v2:14e}", "         0e+00", 2, "f32 0.0 {14e}")
