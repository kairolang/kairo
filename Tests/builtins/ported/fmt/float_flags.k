    ck(f"{v3:_<14.3e}", "-0.000e+00____", 1, "f64 -0.0 {_<14.3e}")
    ck(f"{v4:1}", "1234.5", 1, "f64 1234.5 {1}")
    ck(f"{v4:10}", "    1234.5", 1, "f64 1234.5 {10}")
    ck(f"{v4:<10}", "1234.5    ", 1, "f64 1234.5 {<10}")
    ck(f"{v4:>10}", "    1234.5", 1, "f64 1234.5 {>10}")
    ck(f"{v4:^10}", "  1234.5  ", 1, "f64 1234.5 {^10}")
    ck(f"{v4:*>10}", "****1234.5", 1, "f64 1234.5 {*>10}")
    ck(f"{v4:→<10}", "1234.5→→→→", 1, "f64 1234.5 {→<10}")
    ck(f"{v4:+}", "+1234.5", 1, "f64 1234.5 {+}")
    ck(f"{v4:+10}", "   +1234.5", 1, "f64 1234.5 {+10}")
    ck(f"{v4:0>+10}", "000+1234.5", 1, "f64 1234.5 {0>+10}")
    ck(f"{v4:10.2}", "   1.2e+03", 1, "f64 1234.5 {10.2}")
    ck(f"{v4:14e}", "    1.2345e+03", 1, "f64 1234.5 {14e}")
    ck(f"{v4:+14E}", "   +1.2345E+03", 1, "f64 1234.5 {+14E}")
    ck(f"{v4:_<14.3e}", "1.234e+03_____", 1, "f64 1234.5 {_<14.3e}")
    ck(f"{v5:1}", "5e-05", 1, "f64 5e-05 {1}")
    ck(f"{v5:10}", "     5e-05", 1, "f64 5e-05 {10}")
    ck(f"{v5:<10}", "5e-05     ", 1, "f64 5e-05 {<10}")
    ck(f"{v5:>10}", "     5e-05", 1, "f64 5e-05 {>10}")
    ck(f"{v5:*>10}", "*****5e-05", 1, "f64 5e-05 {*>10}")
    ck(f"{v5:→<10}", "5e-05→→→→→", 1, "f64 5e-05 {→<10}")
    ck(f"{v5:😀^11}", "😀😀😀5e-05😀😀😀", 1, "f64 5e-05 {😀^11}")
    ck(f"{v5:+}", "+5e-05", 1, "f64 5e-05 {+}")
    ck(f"{v5:+10}", "    +5e-05", 1, "f64 5e-05 {+10}")
    ck(f"{v5:0>+10}", "0000+5e-05", 1, "f64 5e-05 {0>+10}")
    ck(f"{v5:10.2}", "     5e-05", 1, "f64 5e-05 {10.2}")
    ck(f"{v5:14e}", "         5e-05", 1, "f64 5e-05 {14e}")
    ck(f"{v5:+14E}", "        +5E-05", 1, "f64 5e-05 {+14E}")
    ck(f"{v5:_<14.3e}", "5.000e-05_____", 1, "f64 5e-05 {_<14.3e}")
    ck(f"{v6:1}", "1e+20", 1, "f64 1e+20 {1}")
    ck(f"{v6:10}", "     1e+20", 1, "f64 1e+20 {10}")
    ck(f"{v6:<10}", "1e+20     ", 1, "f64 1e+20 {<10}")
    ck(f"{v6:>10}", "     1e+20", 1, "f64 1e+20 {>10}")
    ck(f"{v6:*>10}", "*****1e+20", 1, "f64 1e+20 {*>10}")
    ck(f"{v6:→<10}", "1e+20→→→→→", 1, "f64 1e+20 {→<10}")
    ck(f"{v6:😀^11}", "😀😀😀1e+20😀😀😀", 1, "f64 1e+20 {😀^11}")
    ck(f"{v6:+}", "+1e+20", 1, "f64 1e+20 {+}")
