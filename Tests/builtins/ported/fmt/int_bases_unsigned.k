// u8, u16, u32 and u64 in base 16, 8 and 2 (`x`, `X`, `o`, `b`) with `#`, `+`, width, fill, alignment and zero padding.
// Rules asserted (library docs): an integer hole prints in decimal or, with `x`, `X`, `o`, `b`, in that base; `#` adds the
// 0x / 0o / 0b prefix, `+` a sign, `0` pads with zeros after the sign and prefix, width and fill pad in code points and numbers
// default to right alignment (website library/core/formatting.mdx, FmtBuf.put_i8 .. put_u512; Lib/builtin/fmt/fmt_buf.k
// number_). The spec grammar is the one in the comment above `_parse_spec` in Compiler/Sema/Type/LiteralTyping.k.
// Expected texts come from a Python oracle that applies those rules to exact Python integers.
// Not asserted because the docs do not state them: negative values in a base, `#X`, `#` on decimal, `0` together with an
// explicit alignment, and the split of an odd amount of padding by `^` (centred cases use an even amount).
// Cases from Rust library/coretests/tests/fmt/num.rs (test_format_int_limits, test_format_int_flags, test_format_int_sign_padding)
// Cases from Rust library/coretests/tests/fmt/mod.rs (the integer flag cases)
// Cases from the {fmt} library test/format-test.cc (integer width, fill, alignment, sign, # and 0 cases)

import std::io::*

var CODE: i32 = 0

fn ck(const got: string, const want: string, id: i32, const name: string) {
    if !(got == want) {
        println(f"FAIL {name}: got [{got}] want [{want}]")
        if CODE == 0 {
            CODE = id
        }
    }
}

fn bases_u8() {
    var v0: u8 = 0
    var v1: u8 = 1
    var v2: u8 = 10
    var v3: u8 = 42
    var v4: u8 = 165
    var v5: u8 = u8::MAX
    ck(f"{v0:x}", "0", 1, "u8 0 {x}")
    ck(f"{v0:X}", "0", 1, "u8 0 {X}")
    ck(f"{v0:o}", "0", 1, "u8 0 {o}")
    ck(f"{v0:b}", "0", 1, "u8 0 {b}")
    ck(f"{v0:#x}", "0x0", 1, "u8 0 {#x}")
    ck(f"{v0:#o}", "0o0", 1, "u8 0 {#o}")
    ck(f"{v0:#b}", "0b0", 1, "u8 0 {#b}")
    ck(f"{v1:x}", "1", 1, "u8 1 {x}")
    ck(f"{v1:X}", "1", 1, "u8 1 {X}")
    ck(f"{v1:o}", "1", 1, "u8 1 {o}")
    ck(f"{v1:b}", "1", 1, "u8 1 {b}")
    ck(f"{v1:#x}", "0x1", 1, "u8 1 {#x}")
    ck(f"{v1:#o}", "0o1", 1, "u8 1 {#o}")
    ck(f"{v1:#b}", "0b1", 1, "u8 1 {#b}")
    ck(f"{v2:x}", "a", 1, "u8 10 {x}")
    ck(f"{v2:X}", "A", 1, "u8 10 {X}")
    ck(f"{v2:o}", "12", 1, "u8 10 {o}")
    ck(f"{v2:b}", "1010", 1, "u8 10 {b}")
    ck(f"{v2:#x}", "0xa", 1, "u8 10 {#x}")
    ck(f"{v2:#o}", "0o12", 1, "u8 10 {#o}")
    ck(f"{v2:#b}", "0b1010", 1, "u8 10 {#b}")
    ck(f"{v3:x}", "2a", 1, "u8 42 {x}")
    ck(f"{v3:X}", "2A", 1, "u8 42 {X}")
    ck(f"{v3:o}", "52", 1, "u8 42 {o}")
    ck(f"{v3:b}", "101010", 1, "u8 42 {b}")
    ck(f"{v3:#x}", "0x2a", 1, "u8 42 {#x}")
    ck(f"{v3:#o}", "0o52", 1, "u8 42 {#o}")
    ck(f"{v3:#b}", "0b101010", 1, "u8 42 {#b}")
    ck(f"{v4:x}", "a5", 1, "u8 165 {x}")
    ck(f"{v4:X}", "A5", 1, "u8 165 {X}")
    ck(f"{v4:o}", "245", 1, "u8 165 {o}")
    ck(f"{v4:b}", "10100101", 1, "u8 165 {b}")
    ck(f"{v4:#x}", "0xa5", 1, "u8 165 {#x}")
    ck(f"{v4:#o}", "0o245", 1, "u8 165 {#o}")
    ck(f"{v4:#b}", "0b10100101", 1, "u8 165 {#b}")
    ck(f"{v4:20x}", "                  a5", 1, "u8 165 {20x}")
    ck(f"{v4:<20x}", "a5                  ", 1, "u8 165 {<20x}")
    ck(f"{v4:*>20x}", "******************a5", 1, "u8 165 {*>20x}")
    ck(f"{v4:→<20X}", "A5→→→→→→→→→→→→→→→→→→", 1, "u8 165 {→<20X}")
    ck(f"{v4:020x}", "000000000000000000a5", 1, "u8 165 {020x}")
    ck(f"{v4:#020x}", "0x0000000000000000a5", 1, "u8 165 {#020x}")
    ck(f"{v4:#030o}", "0o0000000000000000000000000245", 1, "u8 165 {#030o}")
    ck(f"{v4:#040b}", "0b00000000000000000000000000000010100101", 1, "u8 165 {#040b}")
    ck(f"{v4:日>#40b}", "日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日0b10100101", 1, "u8 165 {日>#40b}")
    ck(f"{v4:😀^#24x}", "😀😀😀😀😀😀😀😀😀😀0xa5😀😀😀😀😀😀😀😀😀😀", 1, "u8 165 {😀^#24x}")
    ck(f"{v4:+x}", "+a5", 1, "u8 165 {+x}")
    ck(f"{v4:+#12x}", "       +0xa5", 1, "u8 165 {+#12x}")
    ck(f"{v4:+#012b}", "+0b010100101", 1, "u8 165 {+#012b}")
    ck(f"{v4:_<+12o}", "+245________", 1, "u8 165 {_<+12o}")
    ck(f"{v5:x}", "ff", 1, "u8 255 {x}")
    ck(f"{v5:X}", "FF", 1, "u8 255 {X}")
    ck(f"{v5:o}", "377", 1, "u8 255 {o}")
    ck(f"{v5:b}", "11111111", 1, "u8 255 {b}")
    ck(f"{v5:#x}", "0xff", 1, "u8 255 {#x}")
    ck(f"{v5:#o}", "0o377", 1, "u8 255 {#o}")
    ck(f"{v5:#b}", "0b11111111", 1, "u8 255 {#b}")
    ck(f"{v5:20x}", "                  ff", 1, "u8 255 {20x}")
    ck(f"{v5:<20x}", "ff                  ", 1, "u8 255 {<20x}")
    ck(f"{v5:*>20x}", "******************ff", 1, "u8 255 {*>20x}")
    ck(f"{v5:→<20X}", "FF→→→→→→→→→→→→→→→→→→", 1, "u8 255 {→<20X}")
    ck(f"{v5:020x}", "000000000000000000ff", 1, "u8 255 {020x}")
    ck(f"{v5:#020x}", "0x0000000000000000ff", 1, "u8 255 {#020x}")
    ck(f"{v5:#030o}", "0o0000000000000000000000000377", 1, "u8 255 {#030o}")
    ck(f"{v5:#040b}", "0b00000000000000000000000000000011111111", 1, "u8 255 {#040b}")
    ck(f"{v5:日>#40b}", "日日日日日日日日日日日日日日日日日日日日日日日日日日日日日日0b11111111", 1, "u8 255 {日>#40b}")
    ck(f"{v5:😀^#24x}", "😀😀😀😀😀😀😀😀😀😀0xff😀😀😀😀😀😀😀😀😀😀", 1, "u8 255 {😀^#24x}")
    ck(f"{v5:+x}", "+ff", 1, "u8 255 {+x}")
    ck(f"{v5:+#12x}", "       +0xff", 1, "u8 255 {+#12x}")
    ck(f"{v5:+#012b}", "+0b011111111", 1, "u8 255 {+#012b}")
    ck(f"{v5:_<+12o}", "+377________", 1, "u8 255 {_<+12o}")
}

fn bases_u16() {
    var v0: u16 = 0
    var v1: u16 = 1
    var v2: u16 = 10
    var v3: u16 = 42
    var v4: u16 = 57005
    var v5: u16 = u16::MAX
    ck(f"{v0:x}", "0", 2, "u16 0 {x}")
    ck(f"{v0:X}", "0", 2, "u16 0 {X}")
    ck(f"{v0:o}", "0", 2, "u16 0 {o}")
    ck(f"{v0:b}", "0", 2, "u16 0 {b}")
    ck(f"{v0:#x}", "0x0", 2, "u16 0 {#x}")
    ck(f"{v0:#o}", "0o0", 2, "u16 0 {#o}")
    ck(f"{v0:#b}", "0b0", 2, "u16 0 {#b}")
    ck(f"{v1:x}", "1", 2, "u16 1 {x}")
    ck(f"{v1:X}", "1", 2, "u16 1 {X}")
    ck(f"{v1:o}", "1", 2, "u16 1 {o}")
    ck(f"{v1:b}", "1", 2, "u16 1 {b}")
    ck(f"{v1:#x}", "0x1", 2, "u16 1 {#x}")
    ck(f"{v1:#o}", "0o1", 2, "u16 1 {#o}")
    ck(f"{v1:#b}", "0b1", 2, "u16 1 {#b}")
    ck(f"{v2:x}", "a", 2, "u16 10 {x}")
    ck(f"{v2:X}", "A", 2, "u16 10 {X}")
    ck(f"{v2:o}", "12", 2, "u16 10 {o}")
    ck(f"{v2:b}", "1010", 2, "u16 10 {b}")
    ck(f"{v2:#x}", "0xa", 2, "u16 10 {#x}")
    ck(f"{v2:#o}", "0o12", 2, "u16 10 {#o}")
    ck(f"{v2:#b}", "0b1010", 2, "u16 10 {#b}")
    ck(f"{v3:x}", "2a", 2, "u16 42 {x}")
    ck(f"{v3:X}", "2A", 2, "u16 42 {X}")
    ck(f"{v3:o}", "52", 2, "u16 42 {o}")
    ck(f"{v3:b}", "101010", 2, "u16 42 {b}")
    ck(f"{v3:#x}", "0x2a", 2, "u16 42 {#x}")
    ck(f"{v3:#o}", "0o52", 2, "u16 42 {#o}")
    ck(f"{v3:#b}", "0b101010", 2, "u16 42 {#b}")
    ck(f"{v4:x}", "dead", 2, "u16 57005 {x}")
    ck(f"{v4:X}", "DEAD", 2, "u16 57005 {X}")
    ck(f"{v4:o}", "157255", 2, "u16 57005 {o}")
    ck(f"{v4:b}", "1101111010101101", 2, "u16 57005 {b}")
    ck(f"{v4:#x}", "0xdead", 2, "u16 57005 {#x}")
    ck(f"{v4:#o}", "0o157255", 2, "u16 57005 {#o}")
    ck(f"{v4:#b}", "0b1101111010101101", 2, "u16 57005 {#b}")
    ck(f"{v4:20x}", "                dead", 2, "u16 57005 {20x}")
    ck(f"{v4:<20x}", "dead                ", 2, "u16 57005 {<20x}")
    ck(f"{v4:*>20x}", "****************dead", 2, "u16 57005 {*>20x}")
    ck(f"{v4:→<20X}", "DEAD→→→→→→→→→→→→→→→→", 2, "u16 57005 {→<20X}")
    ck(f"{v4:020x}", "0000000000000000dead", 2, "u16 57005 {020x}")
    ck(f"{v4:#020x}", "0x00000000000000dead", 2, "u16 57005 {#020x}")
    ck(f"{v4:#030o}", "0o0000000000000000000000157255", 2, "u16 57005 {#030o}")
    ck(f"{v4:#040b}", "0b00000000000000000000001101111010101101", 2, "u16 57005 {#040b}")
    ck(f"{v4:日>#40b}", "日日日日日日日日日日日日日日日日日日日日日日0b1101111010101101", 2, "u16 57005 {日>#40b}")
    ck(f"{v4:😀^#24x}", "😀😀😀😀😀😀😀😀😀0xdead😀😀😀😀😀😀😀😀😀", 2, "u16 57005 {😀^#24x}")
    ck(f"{v4:+x}", "+dead", 2, "u16 57005 {+x}")
    ck(f"{v4:+#12x}", "     +0xdead", 2, "u16 57005 {+#12x}")
    ck(f"{v4:+#012b}", "+0b1101111010101101", 2, "u16 57005 {+#012b}")
    ck(f"{v4:_<+12o}", "+157255_____", 2, "u16 57005 {_<+12o}")
    ck(f"{v5:x}", "ffff", 2, "u16 65535 {x}")
    ck(f"{v5:X}", "FFFF", 2, "u16 65535 {X}")
    ck(f"{v5:o}", "177777", 2, "u16 65535 {o}")
    ck(f"{v5:b}", "1111111111111111", 2, "u16 65535 {b}")
    ck(f"{v5:#x}", "0xffff", 2, "u16 65535 {#x}")
    ck(f"{v5:#o}", "0o177777", 2, "u16 65535 {#o}")
    ck(f"{v5:#b}", "0b1111111111111111", 2, "u16 65535 {#b}")
    ck(f"{v5:20x}", "                ffff", 2, "u16 65535 {20x}")
    ck(f"{v5:<20x}", "ffff                ", 2, "u16 65535 {<20x}")
    ck(f"{v5:*>20x}", "****************ffff", 2, "u16 65535 {*>20x}")
    ck(f"{v5:→<20X}", "FFFF→→→→→→→→→→→→→→→→", 2, "u16 65535 {→<20X}")
    ck(f"{v5:020x}", "0000000000000000ffff", 2, "u16 65535 {020x}")
    ck(f"{v5:#020x}", "0x00000000000000ffff", 2, "u16 65535 {#020x}")
    ck(f"{v5:#030o}", "0o0000000000000000000000177777", 2, "u16 65535 {#030o}")
    ck(f"{v5:#040b}", "0b00000000000000000000001111111111111111", 2, "u16 65535 {#040b}")
    ck(f"{v5:日>#40b}", "日日日日日日日日日日日日日日日日日日日日日日0b1111111111111111", 2, "u16 65535 {日>#40b}")
    ck(f"{v5:😀^#24x}", "😀😀😀😀😀😀😀😀😀0xffff😀😀😀😀😀😀😀😀😀", 2, "u16 65535 {😀^#24x}")
    ck(f"{v5:+x}", "+ffff", 2, "u16 65535 {+x}")
    ck(f"{v5:+#12x}", "     +0xffff", 2, "u16 65535 {+#12x}")
    ck(f"{v5:+#012b}", "+0b1111111111111111", 2, "u16 65535 {+#012b}")
    ck(f"{v5:_<+12o}", "+177777_____", 2, "u16 65535 {_<+12o}")
}

fn bases_u32() {
    var v0: u32 = 0
    var v1: u32 = 1
    var v2: u32 = 10
    var v3: u32 = 42
    var v4: u32 = 57005
    var v5: u32 = u32::MAX
    ck(f"{v0:x}", "0", 3, "u32 0 {x}")
    ck(f"{v0:X}", "0", 3, "u32 0 {X}")
    ck(f"{v0:o}", "0", 3, "u32 0 {o}")
    ck(f"{v0:b}", "0", 3, "u32 0 {b}")
    ck(f"{v0:#x}", "0x0", 3, "u32 0 {#x}")
    ck(f"{v0:#o}", "0o0", 3, "u32 0 {#o}")
