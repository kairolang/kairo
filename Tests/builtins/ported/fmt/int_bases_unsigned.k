    ck(f"{v2:o}", "12", 4, "u64 10 {o}")
    ck(f"{v2:b}", "1010", 4, "u64 10 {b}")
    ck(f"{v2:#x}", "0xa", 4, "u64 10 {#x}")
    ck(f"{v2:#o}", "0o12", 4, "u64 10 {#o}")
    ck(f"{v2:#b}", "0b1010", 4, "u64 10 {#b}")
    ck(f"{v3:x}", "2a", 4, "u64 42 {x}")
    ck(f"{v3:X}", "2A", 4, "u64 42 {X}")
    ck(f"{v3:o}", "52", 4, "u64 42 {o}")
    ck(f"{v3:b}", "101010", 4, "u64 42 {b}")
    ck(f"{v3:#x}", "0x2a", 4, "u64 42 {#x}")
    ck(f"{v3:#o}", "0o52", 4, "u64 42 {#o}")
    ck(f"{v3:#b}", "0b101010", 4, "u64 42 {#b}")
    ck(f"{v4:x}", "dead", 4, "u64 57005 {x}")
    ck(f"{v4:X}", "DEAD", 4, "u64 57005 {X}")
    ck(f"{v4:o}", "157255", 4, "u64 57005 {o}")
    ck(f"{v4:b}", "1101111010101101", 4, "u64 57005 {b}")
    ck(f"{v4:#x}", "0xdead", 4, "u64 57005 {#x}")
    ck(f"{v4:#o}", "0o157255", 4, "u64 57005 {#o}")
    ck(f"{v4:#b}", "0b1101111010101101", 4, "u64 57005 {#b}")
    ck(f"{v4:20x}", "                dead", 4, "u64 57005 {20x}")
    ck(f"{v4:<20x}", "dead                ", 4, "u64 57005 {<20x}")
    ck(f"{v4:*>20x}", "****************dead", 4, "u64 57005 {*>20x}")
    ck(f"{v4:→<20X}", "DEAD→→→→→→→→→→→→→→→→", 4, "u64 57005 {→<20X}")
    ck(f"{v4:020x}", "0000000000000000dead", 4, "u64 57005 {020x}")
    ck(f"{v4:#020x}", "0x00000000000000dead", 4, "u64 57005 {#020x}")
    ck(f"{v4:#030o}", "0o0000000000000000000000157255", 4, "u64 57005 {#030o}")
    ck(f"{v4:#040b}", "0b00000000000000000000001101111010101101", 4, "u64 57005 {#040b}")
    ck(f"{v4:日>#40b}", "日日日日日日日日日日日日日日日日日日日日日日0b1101111010101101", 4, "u64 57005 {日>#40b}")
    ck(f"{v4:😀^#24x}", "😀😀😀😀😀😀😀😀😀0xdead😀😀😀😀😀😀😀😀😀", 4, "u64 57005 {😀^#24x}")
    ck(f"{v4:+x}", "+dead", 4, "u64 57005 {+x}")
    ck(f"{v4:+#12x}", "     +0xdead", 4, "u64 57005 {+#12x}")
    ck(f"{v4:+#012b}", "+0b1101111010101101", 4, "u64 57005 {+#012b}")
    ck(f"{v4:_<+12o}", "+157255_____", 4, "u64 57005 {_<+12o}")
    ck(f"{v5:x}", "ffffffffffffffff", 4, "u64 big {x}")
    ck(f"{v5:X}", "FFFFFFFFFFFFFFFF", 4, "u64 big {X}")
    ck(f"{v5:o}", "1777777777777777777777", 4, "u64 big {o}")
    ck(f"{v5:b}", "1111111111111111111111111111111111111111111111111111111111111111", 4, "u64 big {b}")
    ck(f"{v5:#x}", "0xffffffffffffffff", 4, "u64 big {#x}")
    ck(f"{v5:#o}", "0o1777777777777777777777", 4, "u64 big {#o}")
    ck(f"{v5:#b}", "0b1111111111111111111111111111111111111111111111111111111111111111", 4, "u64 big {#b}")
    ck(f"{v5:20x}", "    ffffffffffffffff", 4, "u64 big {20x}")
    ck(f"{v5:<20x}", "ffffffffffffffff    ", 4, "u64 big {<20x}")
    ck(f"{v5:*>20x}", "****ffffffffffffffff", 4, "u64 big {*>20x}")
    ck(f"{v5:→<20X}", "FFFFFFFFFFFFFFFF→→→→", 4, "u64 big {→<20X}")
    ck(f"{v5:020x}", "0000ffffffffffffffff", 4, "u64 big {020x}")
    ck(f"{v5:#020x}", "0x00ffffffffffffffff", 4, "u64 big {#020x}")
    ck(f"{v5:#030o}", "0o0000001777777777777777777777", 4, "u64 big {#030o}")
    ck(f"{v5:#040b}", "0b1111111111111111111111111111111111111111111111111111111111111111", 4, "u64 big {#040b}")
    ck(f"{v5:日>#40b}", "0b1111111111111111111111111111111111111111111111111111111111111111", 4, "u64 big {日>#40b}")
    ck(f"{v5:😀^#24x}", "😀😀😀0xffffffffffffffff😀😀😀", 4, "u64 big {😀^#24x}")
    ck(f"{v5:+x}", "+ffffffffffffffff", 4, "u64 big {+x}")
    ck(f"{v5:+#12x}", "+0xffffffffffffffff", 4, "u64 big {+#12x}")
    ck(f"{v5:+#012b}", "+0b1111111111111111111111111111111111111111111111111111111111111111", 4, "u64 big {+#012b}")
    ck(f"{v5:_<+12o}", "+1777777777777777777777", 4, "u64 big {_<+12o}")
}

fn main() -> i32 {
    bases_u8()
    bases_u16()
    bases_u32()
    bases_u64()
    if CODE == 0 {
        println("ok")
    }

    return CODE
}

