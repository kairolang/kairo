    ck(f"{v1:o}", "1", 3, "u32 1 {o}")
    ck(f"{v1:b}", "1", 3, "u32 1 {b}")
    ck(f"{v1:#x}", "0x1", 3, "u32 1 {#x}")
    ck(f"{v1:#o}", "0o1", 3, "u32 1 {#o}")
    ck(f"{v1:#b}", "0b1", 3, "u32 1 {#b}")
    ck(f"{v2:x}", "a", 3, "u32 10 {x}")
    ck(f"{v2:X}", "A", 3, "u32 10 {X}")
    ck(f"{v2:o}", "12", 3, "u32 10 {o}")
    ck(f"{v2:b}", "1010", 3, "u32 10 {b}")
    ck(f"{v2:#x}", "0xa", 3, "u32 10 {#x}")
    ck(f"{v2:#o}", "0o12", 3, "u32 10 {#o}")
    ck(f"{v2:#b}", "0b1010", 3, "u32 10 {#b}")
    ck(f"{v3:x}", "2a", 3, "u32 42 {x}")
    ck(f"{v3:X}", "2A", 3, "u32 42 {X}")
    ck(f"{v3:o}", "52", 3, "u32 42 {o}")
    ck(f"{v3:b}", "101010", 3, "u32 42 {b}")
    ck(f"{v3:#x}", "0x2a", 3, "u32 42 {#x}")
    ck(f"{v3:#o}", "0o52", 3, "u32 42 {#o}")
    ck(f"{v3:#b}", "0b101010", 3, "u32 42 {#b}")
    ck(f"{v4:x}", "dead", 3, "u32 57005 {x}")
    ck(f"{v4:X}", "DEAD", 3, "u32 57005 {X}")
    ck(f"{v4:o}", "157255", 3, "u32 57005 {o}")
    ck(f"{v4:b}", "1101111010101101", 3, "u32 57005 {b}")
    ck(f"{v4:#x}", "0xdead", 3, "u32 57005 {#x}")
    ck(f"{v4:#o}", "0o157255", 3, "u32 57005 {#o}")
    ck(f"{v4:#b}", "0b1101111010101101", 3, "u32 57005 {#b}")
    ck(f"{v4:20x}", "                dead", 3, "u32 57005 {20x}")
    ck(f"{v4:<20x}", "dead                ", 3, "u32 57005 {<20x}")
    ck(f"{v4:*>20x}", "****************dead", 3, "u32 57005 {*>20x}")
    ck(f"{v4:→<20X}", "DEAD→→→→→→→→→→→→→→→→", 3, "u32 57005 {→<20X}")
    ck(f"{v4:020x}", "0000000000000000dead", 3, "u32 57005 {020x}")
    ck(f"{v4:#020x}", "0x00000000000000dead", 3, "u32 57005 {#020x}")
    ck(f"{v4:#030o}", "0o0000000000000000000000157255", 3, "u32 57005 {#030o}")
    ck(f"{v4:#040b}", "0b00000000000000000000001101111010101101", 3, "u32 57005 {#040b}")
    ck(f"{v4:日>#40b}", "日日日日日日日日日日日日日日日日日日日日日日0b1101111010101101", 3, "u32 57005 {日>#40b}")
    ck(f"{v4:😀^#24x}", "😀😀😀😀😀😀😀😀😀0xdead😀😀😀😀😀😀😀😀😀", 3, "u32 57005 {😀^#24x}")
    ck(f"{v4:+x}", "+dead", 3, "u32 57005 {+x}")
    ck(f"{v4:+#12x}", "     +0xdead", 3, "u32 57005 {+#12x}")
    ck(f"{v4:+#012b}", "+0b1101111010101101", 3, "u32 57005 {+#012b}")
    ck(f"{v4:_<+12o}", "+157255_____", 3, "u32 57005 {_<+12o}")
    ck(f"{v5:x}", "ffffffff", 3, "u32 big {x}")
    ck(f"{v5:X}", "FFFFFFFF", 3, "u32 big {X}")
    ck(f"{v5:o}", "37777777777", 3, "u32 big {o}")
    ck(f"{v5:b}", "11111111111111111111111111111111", 3, "u32 big {b}")
    ck(f"{v5:#x}", "0xffffffff", 3, "u32 big {#x}")
    ck(f"{v5:#o}", "0o37777777777", 3, "u32 big {#o}")
    ck(f"{v5:#b}", "0b11111111111111111111111111111111", 3, "u32 big {#b}")
    ck(f"{v5:20x}", "            ffffffff", 3, "u32 big {20x}")
    ck(f"{v5:<20x}", "ffffffff            ", 3, "u32 big {<20x}")
    ck(f"{v5:*>20x}", "************ffffffff", 3, "u32 big {*>20x}")
    ck(f"{v5:→<20X}", "FFFFFFFF→→→→→→→→→→→→", 3, "u32 big {→<20X}")
    ck(f"{v5:020x}", "000000000000ffffffff", 3, "u32 big {020x}")
    ck(f"{v5:#020x}", "0x0000000000ffffffff", 3, "u32 big {#020x}")
    ck(f"{v5:#030o}", "0o0000000000000000037777777777", 3, "u32 big {#030o}")
    ck(f"{v5:#040b}", "0b00000011111111111111111111111111111111", 3, "u32 big {#040b}")
    ck(f"{v5:日>#40b}", "日日日日日日0b11111111111111111111111111111111", 3, "u32 big {日>#40b}")
    ck(f"{v5:😀^#24x}", "😀😀😀😀😀😀😀0xffffffff😀😀😀😀😀😀😀", 3, "u32 big {😀^#24x}")
    ck(f"{v5:+x}", "+ffffffff", 3, "u32 big {+x}")
    ck(f"{v5:+#12x}", " +0xffffffff", 3, "u32 big {+#12x}")
    ck(f"{v5:+#012b}", "+0b11111111111111111111111111111111", 3, "u32 big {+#012b}")
    ck(f"{v5:_<+12o}", "+37777777777", 3, "u32 big {_<+12o}")
}

fn bases_u64() {
    var v0: u64 = 0
    var v1: u64 = 1
    var v2: u64 = 10
    var v3: u64 = 42
    var v4: u64 = 57005
    var v5: u64 = u64::MAX
