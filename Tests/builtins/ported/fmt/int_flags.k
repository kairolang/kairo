}

fn zero_padding_with_prefix() {
    var u0: u32 = 7
    var u1: u32 = 7
    var u2: u32 = 12345
    ck(f"{u0:01}", "7", 2, "u32 7 {01}")
    ck(f"{u0:03}", "007", 2, "u32 7 {03}")
    ck(f"{u0:06}", "000007", 2, "u32 7 {06}")
    ck(f"{u0:012}", "000000000007", 2, "u32 7 {012}")
    ck(f"{u0:+01}", "+7", 2, "u32 7 {+01}")
    ck(f"{u0:+03}", "+07", 2, "u32 7 {+03}")
    ck(f"{u0:+06}", "+00007", 2, "u32 7 {+06}")
