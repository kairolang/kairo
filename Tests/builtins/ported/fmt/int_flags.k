    ck(f"{u0:+#06o}", "+0o007", 2, "u32 7 {+#06o}")
    ck(f"{u0:+#012o}", "+0o000000007", 2, "u32 7 {+#012o}")
    ck(f"{u0:#01b}", "0b111", 2, "u32 7 {#01b}")
    ck(f"{u0:#03b}", "0b111", 2, "u32 7 {#03b}")
    ck(f"{u0:#06b}", "0b0111", 2, "u32 7 {#06b}")
