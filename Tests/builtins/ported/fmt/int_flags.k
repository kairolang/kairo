    ck(f"{u0:06x}", "000007", 2, "u32 7 {06x}")
    ck(f"{u0:012x}", "000000000007", 2, "u32 7 {012x}")
    ck(f"{u0:+01x}", "+7", 2, "u32 7 {+01x}")
    ck(f"{u0:+03x}", "+07", 2, "u32 7 {+03x}")
    ck(f"{u0:+06x}", "+00007", 2, "u32 7 {+06x}")
    ck(f"{u0:+012x}", "+00000000007", 2, "u32 7 {+012x}")
    ck(f"{u0:#01x}", "0x7", 2, "u32 7 {#01x}")
    ck(f"{u0:#03x}", "0x7", 2, "u32 7 {#03x}")
    ck(f"{u0:#06x}", "0x0007", 2, "u32 7 {#06x}")
    ck(f"{u0:#012x}", "0x0000000007", 2, "u32 7 {#012x}")
    ck(f"{u0:+#01x}", "+0x7", 2, "u32 7 {+#01x}")
    ck(f"{u0:+#03x}", "+0x7", 2, "u32 7 {+#03x}")
    ck(f"{u0:+#06x}", "+0x007", 2, "u32 7 {+#06x}")
    ck(f"{u0:+#012x}", "+0x000000007", 2, "u32 7 {+#012x}")
    ck(f"{u0:#01o}", "0o7", 2, "u32 7 {#01o}")
