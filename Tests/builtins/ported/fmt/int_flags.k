fn negative_zero_padding() {
    var n0: i32 = -7
    var n1: i32 = -12345
    ck(f"{n0:01}", "-7", 3, "i32 -7 {01}")
    ck(f"{n0:+01}", "-7", 3, "i32 -7 {+01}")
    ck(f"{n0:03}", "-07", 3, "i32 -7 {03}")
    ck(f"{n0:+03}", "-07", 3, "i32 -7 {+03}")
    ck(f"{n0:06}", "-00007", 3, "i32 -7 {06}")
    ck(f"{n0:+06}", "-00007", 3, "i32 -7 {+06}")
    ck(f"{n0:012}", "-00000000007", 3, "i32 -7 {012}")
    ck(f"{n0:+012}", "-00000000007", 3, "i32 -7 {+012}")
    ck(f"{n1:01}", "-12345", 3, "i32 -12345 {01}")
    ck(f"{n1:+01}", "-12345", 3, "i32 -12345 {+01}")
    ck(f"{n1:03}", "-12345", 3, "i32 -12345 {03}")
    ck(f"{n1:+03}", "-12345", 3, "i32 -12345 {+03}")
    ck(f"{n1:06}", "-12345", 3, "i32 -12345 {06}")
    ck(f"{n1:+06}", "-12345", 3, "i32 -12345 {+06}")
    ck(f"{n1:012}", "-00000012345", 3, "i32 -12345 {012}")
    ck(f"{n1:+012}", "-00000012345", 3, "i32 -12345 {+012}")
}

fn main() -> i32 {
    alignment_fill_sign()
    zero_padding_with_prefix()
    negative_zero_padding()
    if CODE == 0 {
        println("ok")
    }

    return CODE
}

