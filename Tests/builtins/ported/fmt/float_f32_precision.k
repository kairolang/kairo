fn ties_f32() {
    // every value is a dyadic fraction: its last decimal digit is a 5, so each case below is an exact tie
    var v0: f32 = 5.0e-1
    var v1: f32 = 1.5e0
    var v2: f32 = 2.5e0
    var v3: f32 = 2.5e-1
    var v4: f32 = 7.5e-1
    var v5: f32 = 1.25e0
    var v6: f32 = 2.25e0
    var v7: f32 = 1.25e-1
    var v8: f32 = 3.75e-1
    var v9: f32 = 6.25e-1
    var v10: f32 = 2.125e0
    var v11: f32 = 6.25e-2
    var v12: f32 = 1.875e-1
    var v13: f32 = 3.125e-1
    var v14: f32 = 2.0625e0
    var v15: f32 = 3.125e-2
    var v16: f32 = 9.375e-2
    var v17: f32 = 1.5625e-1
    var v18: f32 = 2.03125e0
    var v19: f32 = 1.5625e-2
    var v20: f32 = 4.6875e-2
    var v21: f32 = 7.8125e-2
    var v22: f32 = 2.015625e0
    var v23: f32 = 1.275e2
    var v24: f32 = 1.285e2
    var v25: f32 = 1.0005e3
    var v26: f32 = 1.0015e3
    var v27: f32 = 9.95e1
    var v28: f32 = 1.0025e2
    ck(f"{v0:.0e}", "5e-01", 2, "f32 0.5 {.0e}")
    ck(f"{(-v0):.0e}", "-5e-01", 2, "f32 -0.5 {.0e}")
    ck(f"{v1:.0e}", "2e+00", 2, "f32 1.5 {.0e}")
    ck(f"{v1:.1e}", "1.5e+00", 2, "f32 1.5 {.1e}")
    ck(f"{v1:.1}", "2", 2, "f32 1.5 {.1}")
    ck(f"{v1:.2}", "1.5", 2, "f32 1.5 {.2}")
    ck(f"{v2:.0e}", "2e+00", 2, "f32 2.5 {.0e}")
    ck(f"{v2:.1e}", "2.5e+00", 2, "f32 2.5 {.1e}")
    ck(f"{v2:.1}", "2", 2, "f32 2.5 {.1}")
    ck(f"{v2:.2}", "2.5", 2, "f32 2.5 {.2}")
    ck(f"{v3:.0e}", "2e-01", 2, "f32 0.25 {.0e}")
    ck(f"{v3:.1e}", "2.5e-01", 2, "f32 0.25 {.1e}")
    ck(f"{v3:.1}", "0.2", 2, "f32 0.25 {.1}")
    ck(f"{v3:.2}", "0.25", 2, "f32 0.25 {.2}")
    ck(f"{(-v3):.0e}", "-2e-01", 2, "f32 -0.25 {.0e}")
    ck(f"{(-v3):.1e}", "-2.5e-01", 2, "f32 -0.25 {.1e}")
    ck(f"{(-v3):.1}", "-0.2", 2, "f32 -0.25 {.1}")
    ck(f"{(-v3):.2}", "-0.25", 2, "f32 -0.25 {.2}")
    ck(f"{v4:.0e}", "8e-01", 2, "f32 0.75 {.0e}")
    ck(f"{v4:.1e}", "7.5e-01", 2, "f32 0.75 {.1e}")
