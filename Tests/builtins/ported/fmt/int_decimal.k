// Signed integers (i8, i16, i32, i64, isize) in decimal: zero, one, both extremes and their neighbours, every sign / width / fill / alignment / zero-padding combination on the extremes.
// Rules asserted (library docs): an integer hole prints in decimal or, with `x`, `X`, `o`, `b`, in that base; `#` adds the
// 0x / 0o / 0b prefix, `+` a sign, `0` pads with zeros after the sign and prefix, width and fill pad in code points and numbers
// default to right alignment (website library/core/formatting.mdx, FmtBuf.put_i8 .. put_u512; Lib/builtin2/fmt/fmt_buf.k
// number_). The spec grammar is the one in the comment above `_parse_spec` in Compiler/Sema/Type/LiteralTyping.k.
// Expected texts come from a Python oracle that applies those rules to exact Python integers.
// Not asserted because the docs do not state them: negative values in a base, `#X`, `#` on decimal, `0` together with an
// explicit alignment, and the split of an odd amount of padding by `^` (centred cases use an even amount).
// Cases from Rust library/coretests/tests/fmt/num.rs (test_format_int_limits, test_format_int_flags, test_format_int_sign_padding)
// Cases from Rust library/coretests/tests/fmt/mod.rs (the integer flag cases)
// Cases from the {fmt} library test/format-test.cc (integer width, fill, alignment, sign, # and 0 cases)

import std::io::*

var CODE: i32 = 0

fn ck(const got: string, const want: string, id: i32, const name: string) {
    if !(got == want) {
        println(f"FAIL {name}: got [{got}] want [{want}]")
        if CODE == 0 {
            CODE = id
        }
    }
}

fn decimal_i8() {
    var v0: i8 = 0
    var v1: i8 = 1
    var v2: i8 = 42
    var v3: i8 = i8::MAX
    var v4: i8 = 126
    var v5: i8 = -1
    var v6: i8 = -42
    var v7: i8 = i8::MIN
    var v8: i8 = -127
    ck(f"{v0}", "0", 1, "i8 0 {}")
    ck(f"{v0:+}", "+0", 1, "i8 0 {+}")
    ck(f"{v1}", "1", 1, "i8 1 {}")
    ck(f"{v1:+}", "+1", 1, "i8 1 {+}")
    ck(f"{v2}", "42", 1, "i8 42 {}")
    ck(f"{v2:+}", "+42", 1, "i8 42 {+}")
    ck(f"{v2:3}", " 42", 1, "i8 42 {3}")
    ck(f"{v2:12}", "          42", 1, "i8 42 {12}")
    ck(f"{v3}", "127", 1, "i8 127 {}")
    ck(f"{v3:+}", "+127", 1, "i8 127 {+}")
    ck(f"{v3:3}", "127", 1, "i8 127 {3}")
    ck(f"{v3:12}", "         127", 1, "i8 127 {12}")
    ck(f"{v3:<12}", "127         ", 1, "i8 127 {<12}")
    ck(f"{v3:>12}", "         127", 1, "i8 127 {>12}")
    ck(f"{v3:*<12}", "127*********", 1, "i8 127 {*<12}")
    ck(f"{v3:0>12}", "000000000127", 1, "i8 127 {0>12}")
    ck(f"{v3:→>12}", "→→→→→→→→→127", 1, "i8 127 {→>12}")
    ck(f"{v3:日<12}", "127日日日日日日日日日", 1, "i8 127 {日<12}")
    ck(f"{v3:+12}", "        +127", 1, "i8 127 {+12}")
    ck(f"{v3:012}", "000000000127", 1, "i8 127 {012}")
    ck(f"{v3:+012}", "+00000000127", 1, "i8 127 {+012}")
    ck(f"{v4}", "126", 1, "i8 126 {}")
    ck(f"{v4:+}", "+126", 1, "i8 126 {+}")
    ck(f"{v5}", "-1", 1, "i8 -1 {}")
    ck(f"{v5:+}", "-1", 1, "i8 -1 {+}")
    ck(f"{v6}", "-42", 1, "i8 -42 {}")
    ck(f"{v6:+}", "-42", 1, "i8 -42 {+}")
    ck(f"{v7}", "-128", 1, "i8 -128 {}")
    ck(f"{v7:+}", "-128", 1, "i8 -128 {+}")
    ck(f"{v7:3}", "-128", 1, "i8 -128 {3}")
    ck(f"{v7:12}", "        -128", 1, "i8 -128 {12}")
    ck(f"{v7:<12}", "-128        ", 1, "i8 -128 {<12}")
    ck(f"{v7:>12}", "        -128", 1, "i8 -128 {>12}")
    ck(f"{v7:*<12}", "-128********", 1, "i8 -128 {*<12}")
    ck(f"{v7:0>12}", "00000000-128", 1, "i8 -128 {0>12}")
    ck(f"{v7:→>12}", "→→→→→→→→-128", 1, "i8 -128 {→>12}")
    ck(f"{v7:日<12}", "-128日日日日日日日日", 1, "i8 -128 {日<12}")
    ck(f"{v7:😀^12}", "😀😀😀😀-128😀😀😀😀", 1, "i8 -128 {😀^12}")
    ck(f"{v7:+12}", "        -128", 1, "i8 -128 {+12}")
    ck(f"{v7:012}", "-00000000128", 1, "i8 -128 {012}")
    ck(f"{v7:+012}", "-00000000128", 1, "i8 -128 {+012}")
    ck(f"{v8}", "-127", 1, "i8 -127 {}")
    ck(f"{v8:+}", "-127", 1, "i8 -127 {+}")
}

fn decimal_i16() {
    var v0: i16 = 0
    var v1: i16 = 1
    var v2: i16 = 42
    var v3: i16 = i16::MAX
    var v4: i16 = 32766
    var v5: i16 = -1
    var v6: i16 = -42
    var v7: i16 = i16::MIN
    var v8: i16 = -32767
    ck(f"{v0}", "0", 2, "i16 0 {}")
    ck(f"{v0:+}", "+0", 2, "i16 0 {+}")
    ck(f"{v1}", "1", 2, "i16 1 {}")
    ck(f"{v1:+}", "+1", 2, "i16 1 {+}")
    ck(f"{v2}", "42", 2, "i16 42 {}")
    ck(f"{v2:+}", "+42", 2, "i16 42 {+}")
    ck(f"{v2:3}", " 42", 2, "i16 42 {3}")
    ck(f"{v2:12}", "          42", 2, "i16 42 {12}")
    ck(f"{v3}", "32767", 2, "i16 32767 {}")
    ck(f"{v3:+}", "+32767", 2, "i16 32767 {+}")
    ck(f"{v3:3}", "32767", 2, "i16 32767 {3}")
    ck(f"{v3:12}", "       32767", 2, "i16 32767 {12}")
    ck(f"{v3:<12}", "32767       ", 2, "i16 32767 {<12}")
    ck(f"{v3:>12}", "       32767", 2, "i16 32767 {>12}")
    ck(f"{v3:*<12}", "32767*******", 2, "i16 32767 {*<12}")
    ck(f"{v3:0>12}", "000000032767", 2, "i16 32767 {0>12}")
    ck(f"{v3:→>12}", "→→→→→→→32767", 2, "i16 32767 {→>12}")
    ck(f"{v3:日<12}", "32767日日日日日日日", 2, "i16 32767 {日<12}")
    ck(f"{v3:+12}", "      +32767", 2, "i16 32767 {+12}")
    ck(f"{v3:012}", "000000032767", 2, "i16 32767 {012}")
    ck(f"{v3:+012}", "+00000032767", 2, "i16 32767 {+012}")
    ck(f"{v4}", "32766", 2, "i16 32766 {}")
    ck(f"{v4:+}", "+32766", 2, "i16 32766 {+}")
    ck(f"{v5}", "-1", 2, "i16 -1 {}")
    ck(f"{v5:+}", "-1", 2, "i16 -1 {+}")
    ck(f"{v6}", "-42", 2, "i16 -42 {}")
    ck(f"{v6:+}", "-42", 2, "i16 -42 {+}")
    ck(f"{v7}", "-32768", 2, "i16 -32768 {}")
    ck(f"{v7:+}", "-32768", 2, "i16 -32768 {+}")
    ck(f"{v7:3}", "-32768", 2, "i16 -32768 {3}")
    ck(f"{v7:12}", "      -32768", 2, "i16 -32768 {12}")
    ck(f"{v7:<12}", "-32768      ", 2, "i16 -32768 {<12}")
    ck(f"{v7:>12}", "      -32768", 2, "i16 -32768 {>12}")
    ck(f"{v7:*<12}", "-32768******", 2, "i16 -32768 {*<12}")
    ck(f"{v7:0>12}", "000000-32768", 2, "i16 -32768 {0>12}")
    ck(f"{v7:→>12}", "→→→→→→-32768", 2, "i16 -32768 {→>12}")
    ck(f"{v7:日<12}", "-32768日日日日日日", 2, "i16 -32768 {日<12}")
    ck(f"{v7:😀^12}", "😀😀😀-32768😀😀😀", 2, "i16 -32768 {😀^12}")
    ck(f"{v7:+12}", "      -32768", 2, "i16 -32768 {+12}")
    ck(f"{v7:012}", "-00000032768", 2, "i16 -32768 {012}")
    ck(f"{v7:+012}", "-00000032768", 2, "i16 -32768 {+012}")
    ck(f"{v8}", "-32767", 2, "i16 -32767 {}")
    ck(f"{v8:+}", "-32767", 2, "i16 -32767 {+}")
}

fn decimal_i32() {
    var v0: i32 = 0
    var v1: i32 = 1
    var v2: i32 = 42
    var v3: i32 = i32::MAX
    var v4: i32 = 2147483646
    var v5: i32 = -1
    var v6: i32 = -42
    var v7: i32 = i32::MIN
    var v8: i32 = -2147483647
    ck(f"{v0}", "0", 3, "i32 0 {}")
    ck(f"{v0:+}", "+0", 3, "i32 0 {+}")
    ck(f"{v1}", "1", 3, "i32 1 {}")
    ck(f"{v1:+}", "+1", 3, "i32 1 {+}")
    ck(f"{v2}", "42", 3, "i32 42 {}")
    ck(f"{v2:+}", "+42", 3, "i32 42 {+}")
    ck(f"{v2:3}", " 42", 3, "i32 42 {3}")
    ck(f"{v2:12}", "          42", 3, "i32 42 {12}")
    ck(f"{v3}", "2147483647", 3, "i32 big {}")
    ck(f"{v3:+}", "+2147483647", 3, "i32 big {+}")
    ck(f"{v3:3}", "2147483647", 3, "i32 big {3}")
    ck(f"{v3:12}", "  2147483647", 3, "i32 big {12}")
    ck(f"{v3:<12}", "2147483647  ", 3, "i32 big {<12}")
    ck(f"{v3:>12}", "  2147483647", 3, "i32 big {>12}")
    ck(f"{v3:*<12}", "2147483647**", 3, "i32 big {*<12}")
    ck(f"{v3:0>12}", "002147483647", 3, "i32 big {0>12}")
    ck(f"{v3:→>12}", "→→2147483647", 3, "i32 big {→>12}")
    ck(f"{v3:日<12}", "2147483647日日", 3, "i32 big {日<12}")
    ck(f"{v3:😀^12}", "😀2147483647😀", 3, "i32 big {😀^12}")
    ck(f"{v3:+12}", " +2147483647", 3, "i32 big {+12}")
    ck(f"{v3:012}", "002147483647", 3, "i32 big {012}")
    ck(f"{v3:+012}", "+02147483647", 3, "i32 big {+012}")
    ck(f"{v4}", "2147483646", 3, "i32 big {}")
    ck(f"{v4:+}", "+2147483646", 3, "i32 big {+}")
    ck(f"{v5}", "-1", 3, "i32 -1 {}")
    ck(f"{v5:+}", "-1", 3, "i32 -1 {+}")
    ck(f"{v6}", "-42", 3, "i32 -42 {}")
    ck(f"{v6:+}", "-42", 3, "i32 -42 {+}")
    ck(f"{v7}", "-2147483648", 3, "i32 big {}")
    ck(f"{v7:+}", "-2147483648", 3, "i32 big {+}")
    ck(f"{v7:3}", "-2147483648", 3, "i32 big {3}")
    ck(f"{v7:12}", " -2147483648", 3, "i32 big {12}")
    ck(f"{v7:<12}", "-2147483648 ", 3, "i32 big {<12}")
    ck(f"{v7:>12}", " -2147483648", 3, "i32 big {>12}")
    ck(f"{v7:*<12}", "-2147483648*", 3, "i32 big {*<12}")
    ck(f"{v7:0>12}", "0-2147483648", 3, "i32 big {0>12}")
    ck(f"{v7:→>12}", "→-2147483648", 3, "i32 big {→>12}")
    ck(f"{v7:日<12}", "-2147483648日", 3, "i32 big {日<12}")
    ck(f"{v7:+12}", " -2147483648", 3, "i32 big {+12}")
    ck(f"{v7:012}", "-02147483648", 3, "i32 big {012}")
    ck(f"{v7:+012}", "-02147483648", 3, "i32 big {+012}")
    ck(f"{v8}", "-2147483647", 3, "i32 big {}")
    ck(f"{v8:+}", "-2147483647", 3, "i32 big {+}")
}

fn decimal_i64() {
    var v0: i64 = 0
    var v1: i64 = 1
    var v2: i64 = 42
    var v3: i64 = i64::MAX
    var v4: i64 = 9223372036854775806
    var v5: i64 = -1
    var v6: i64 = -42
    var v7: i64 = i64::MIN
    var v8: i64 = -9223372036854775807
    ck(f"{v0}", "0", 4, "i64 0 {}")
    ck(f"{v0:+}", "+0", 4, "i64 0 {+}")
    ck(f"{v1}", "1", 4, "i64 1 {}")
    ck(f"{v1:+}", "+1", 4, "i64 1 {+}")
    ck(f"{v2}", "42", 4, "i64 42 {}")
    ck(f"{v2:+}", "+42", 4, "i64 42 {+}")
    ck(f"{v2:3}", " 42", 4, "i64 42 {3}")
    ck(f"{v2:12}", "          42", 4, "i64 42 {12}")
    ck(f"{v3}", "9223372036854775807", 4, "i64 big {}")
    ck(f"{v3:+}", "+9223372036854775807", 4, "i64 big {+}")
    ck(f"{v3:3}", "9223372036854775807", 4, "i64 big {3}")
    ck(f"{v3:12}", "9223372036854775807", 4, "i64 big {12}")
    ck(f"{v3:<12}", "9223372036854775807", 4, "i64 big {<12}")
    ck(f"{v3:>12}", "9223372036854775807", 4, "i64 big {>12}")
    ck(f"{v3:*<12}", "9223372036854775807", 4, "i64 big {*<12}")
    ck(f"{v3:0>12}", "9223372036854775807", 4, "i64 big {0>12}")
    ck(f"{v3:→>12}", "9223372036854775807", 4, "i64 big {→>12}")
    ck(f"{v3:日<12}", "9223372036854775807", 4, "i64 big {日<12}")
    ck(f"{v3:😀^12}", "9223372036854775807", 4, "i64 big {😀^12}")
    ck(f"{v3:+12}", "+9223372036854775807", 4, "i64 big {+12}")
    ck(f"{v3:012}", "9223372036854775807", 4, "i64 big {012}")
    ck(f"{v3:+012}", "+9223372036854775807", 4, "i64 big {+012}")
    ck(f"{v4}", "9223372036854775806", 4, "i64 big {}")
    ck(f"{v4:+}", "+9223372036854775806", 4, "i64 big {+}")
    ck(f"{v5}", "-1", 4, "i64 -1 {}")
    ck(f"{v5:+}", "-1", 4, "i64 -1 {+}")
    ck(f"{v6}", "-42", 4, "i64 -42 {}")
    ck(f"{v6:+}", "-42", 4, "i64 -42 {+}")
    ck(f"{v7}", "-9223372036854775808", 4, "i64 big {}")
    ck(f"{v7:+}", "-9223372036854775808", 4, "i64 big {+}")
    ck(f"{v7:3}", "-9223372036854775808", 4, "i64 big {3}")
    ck(f"{v7:12}", "-9223372036854775808", 4, "i64 big {12}")
    ck(f"{v7:<12}", "-9223372036854775808", 4, "i64 big {<12}")
    ck(f"{v7:>12}", "-9223372036854775808", 4, "i64 big {>12}")
    ck(f"{v7:*<12}", "-9223372036854775808", 4, "i64 big {*<12}")
    ck(f"{v7:0>12}", "-9223372036854775808", 4, "i64 big {0>12}")
    ck(f"{v7:→>12}", "-9223372036854775808", 4, "i64 big {→>12}")
    ck(f"{v7:日<12}", "-9223372036854775808", 4, "i64 big {日<12}")
    ck(f"{v7:😀^12}", "-9223372036854775808", 4, "i64 big {😀^12}")
    ck(f"{v7:+12}", "-9223372036854775808", 4, "i64 big {+12}")
    ck(f"{v7:012}", "-9223372036854775808", 4, "i64 big {012}")
    ck(f"{v7:+012}", "-9223372036854775808", 4, "i64 big {+012}")
    ck(f"{v8}", "-9223372036854775807", 4, "i64 big {}")
    ck(f"{v8:+}", "-9223372036854775807", 4, "i64 big {+}")
}

fn decimal_isize() {
    var v0: isize = 0
    var v1: isize = 1
    var v2: isize = -1
    var v3: isize = 42
    var v4: isize = -42
    var v5: isize = 1000000
    var v6: isize = -1000000
    ck(f"{v0}", "0", 9, "isize 0 {}")
    ck(f"{v0:+}", "+0", 9, "isize 0 {+}")
    ck(f"{v0:3}", "  0", 9, "isize 0 {3}")
    ck(f"{v0:12}", "           0", 9, "isize 0 {12}")
    ck(f"{v0:<12}", "0           ", 9, "isize 0 {<12}")
    ck(f"{v0:+12}", "          +0", 9, "isize 0 {+12}")
    ck(f"{v0:012}", "000000000000", 9, "isize 0 {012}")
    ck(f"{v0:+012}", "+00000000000", 9, "isize 0 {+012}")
    ck(f"{v1}", "1", 9, "isize 1 {}")
    ck(f"{v1:+}", "+1", 9, "isize 1 {+}")
    ck(f"{v1:3}", "  1", 9, "isize 1 {3}")
    ck(f"{v1:12}", "           1", 9, "isize 1 {12}")
    ck(f"{v1:<12}", "1           ", 9, "isize 1 {<12}")
    ck(f"{v1:+12}", "          +1", 9, "isize 1 {+12}")
    ck(f"{v1:012}", "000000000001", 9, "isize 1 {012}")
    ck(f"{v1:+012}", "+00000000001", 9, "isize 1 {+012}")
    ck(f"{v2}", "-1", 9, "isize -1 {}")
    ck(f"{v2:+}", "-1", 9, "isize -1 {+}")
    ck(f"{v2:3}", " -1", 9, "isize -1 {3}")
    ck(f"{v2:12}", "          -1", 9, "isize -1 {12}")
    ck(f"{v2:<12}", "-1          ", 9, "isize -1 {<12}")
    ck(f"{v2:😀^12}", "😀😀😀😀😀-1😀😀😀😀😀", 9, "isize -1 {😀^12}")
    ck(f"{v2:+12}", "          -1", 9, "isize -1 {+12}")
    ck(f"{v2:012}", "-00000000001", 9, "isize -1 {012}")
    ck(f"{v2:+012}", "-00000000001", 9, "isize -1 {+012}")
    ck(f"{v3}", "42", 9, "isize 42 {}")
    ck(f"{v3:+}", "+42", 9, "isize 42 {+}")
    ck(f"{v3:3}", " 42", 9, "isize 42 {3}")
    ck(f"{v3:12}", "          42", 9, "isize 42 {12}")
    ck(f"{v3:<12}", "42          ", 9, "isize 42 {<12}")
    ck(f"{v3:😀^12}", "😀😀😀😀😀42😀😀😀😀😀", 9, "isize 42 {😀^12}")
    ck(f"{v3:+12}", "         +42", 9, "isize 42 {+12}")
    ck(f"{v3:012}", "000000000042", 9, "isize 42 {012}")
    ck(f"{v3:+012}", "+00000000042", 9, "isize 42 {+012}")
    ck(f"{v4}", "-42", 9, "isize -42 {}")
    ck(f"{v4:+}", "-42", 9, "isize -42 {+}")
    ck(f"{v4:3}", "-42", 9, "isize -42 {3}")
    ck(f"{v4:12}", "         -42", 9, "isize -42 {12}")
    ck(f"{v4:<12}", "-42         ", 9, "isize -42 {<12}")
    ck(f"{v4:+12}", "         -42", 9, "isize -42 {+12}")
    ck(f"{v4:012}", "-00000000042", 9, "isize -42 {012}")
    ck(f"{v4:+012}", "-00000000042", 9, "isize -42 {+012}")
    ck(f"{v5}", "1000000", 9, "isize big {}")
    ck(f"{v5:+}", "+1000000", 9, "isize big {+}")
    ck(f"{v5:3}", "1000000", 9, "isize big {3}")
    ck(f"{v5:12}", "     1000000", 9, "isize big {12}")
    ck(f"{v5:<12}", "1000000     ", 9, "isize big {<12}")
    ck(f"{v5:+12}", "    +1000000", 9, "isize big {+12}")
    ck(f"{v5:012}", "000001000000", 9, "isize big {012}")
    ck(f"{v5:+012}", "+00001000000", 9, "isize big {+012}")
    ck(f"{v6}", "-1000000", 9, "isize big {}")
    ck(f"{v6:+}", "-1000000", 9, "isize big {+}")
    ck(f"{v6:3}", "-1000000", 9, "isize big {3}")
    ck(f"{v6:12}", "    -1000000", 9, "isize big {12}")
    ck(f"{v6:<12}", "-1000000    ", 9, "isize big {<12}")
    ck(f"{v6:😀^12}", "😀😀-1000000😀😀", 9, "isize big {😀^12}")
    ck(f"{v6:+12}", "    -1000000", 9, "isize big {+12}")
    ck(f"{v6:012}", "-00001000000", 9, "isize big {012}")
    ck(f"{v6:+012}", "-00001000000", 9, "isize big {+012}")
}

fn main() -> i32 {
    decimal_i8()
    decimal_i16()
    decimal_i32()
    decimal_i64()
    decimal_isize()
    if CODE == 0 {
        println("ok")
    }

    return CODE
}

// --- lit wiring ---
// REQUIRES: newlib
// RUN: rm -rf %t.d %t.exe %t.o2.exe
// RUN: %kairo_new %s -o %t.exe --cache-dir %t.d
// RUN: %t.exe | %FileCheck %s
// RUN: %kairo_new %s -O2 -o %t.o2.exe --cache-dir %t.d
// RUN: %t.o2.exe | %FileCheck %s
// CHECK-NOT: FAIL
// CHECK: ok
