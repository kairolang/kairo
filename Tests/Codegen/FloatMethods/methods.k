    cls_bf16("-inf", -inf)
    cls_bf16("nan", nan)
    cls_bf16("-nan", nn)
    io::println(
        f"bf16 unord {b_(nan.is_unordered(one))}{b_(one.is_unordered(nan))}{b_(nan.is_unordered(nan))}{b_(one.is_unordered(two))}{b_(inf.is_unordered(-inf))}",
    )

    // P754: a limit at the head of a method chain.
    io::println(
        f"bf16 chain {b_(bf16::NAN.is_nan())}{b_(bf16::MAX.is_finite())}{b_(bf16::INFINITY.is_infinite())}{b_(bf16::MIN_SUBNORMAL.is_subnormal())}{b_(bf16::MIN.is_sign_negative())}{b_(bf16::MAX.abs().is_normal())}",
    )
}

