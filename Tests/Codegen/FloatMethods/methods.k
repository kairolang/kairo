eval if defined!(__x86_64__) || defined!(__i386__) {
    fn f80_pow2_(k: i32) -> f80 {
        var r: f80 = 1.0
        var i      = k
        while i > 0 {
            r = r * 2.0
            i -= 1
        }

        while i < 0 {
            r = r * 0.5
            i += 1
        }

        return r
    }

    fn run_f80() {
        var L_EPS        = f80_pow2_(-63)
        var L_MINPOS     = f80_pow2_(-16382)
        var L_SUB        = f80_pow2_(-16445)
        var L_MAX        = (2.0 - L_EPS) * f80_pow2_(16383)
        var L_INF        = f64::INFINITY as f80
        var L_NAN        = f64::NAN as f80
        var z:       f80 = 0.0
        var nz           = -z
        var one:     f80 = 1.0
        var two:     f80 = 2.0
        var four:    f80 = 4.0
        var a:       f80 = 2.25
        var na           = -a
        var inf          = L_INF
        var nan          = L_NAN
        io::println(
            f"f80 bits {h_(four.to_bits())} {h_(nz.to_bits())} {h_(L_MAX.to_bits())} {h_(L_SUB.to_bits())} {h_(L_INF.to_bits())} {h_((-L_INF).to_bits())} {h_(L_NAN.to_bits())}",
        )

        io::println(
            f"f80 sqrt {h_(two.sqrt().to_bits())} {h_(a.sqrt().to_bits())} {h_(nz.sqrt().to_bits())} {h_(z.sqrt().to_bits())} {h_(inf.sqrt().to_bits())} {b_(na.sqrt().is_nan())}{b_(nan.sqrt().is_nan())}{b_((-inf).sqrt().is_nan())}",
        )

        var e  = L_EPS
        var hi = one + e
        var lo = one - e
        var mo = -one
        io::println(
            f"f80 fma {h_(hi.fma(lo, mo).to_bits())} {h_(two.fma(four, two).to_bits())} {b_(inf.fma(z, one).is_nan())}{b_(nan.fma(one, one).is_nan())}{b_(inf.fma(one, -inf).is_nan())} {h_(inf.fma(two, one).to_bits())} {h_(nz.fma(one, nz).to_bits())}",
        )

        io::println(
            f"f80 abs {h_(na.abs().to_bits())} {h_(nz.abs().to_bits())} {h_((-inf).abs().to_bits())} {h_(a.copysign(nz).to_bits())} {h_(na.copysign(one).to_bits())} {b_(nan.copysign(mo).is_sign_negative())}{b_(nan.copysign(mo).abs().is_sign_negative())}{b_(nan.copysign(mo).is_nan())}",
        )

        var nn = nan.copysign(mo)
        cls_f80("0", z)
        cls_f80("-0", nz)
        cls_f80("4", four)
        cls_f80("-2.25", na)
        cls_f80("sub", L_SUB)
        cls_f80("-sub", -L_SUB)
        cls_f80("minpos", L_MINPOS)
        cls_f80("max", L_MAX)
        cls_f80("inf", inf)
        cls_f80("-inf", -inf)
        cls_f80("nan", nan)
        cls_f80("-nan", nn)
        io::println(
            f"f80 unord {b_(nan.is_unordered(one))}{b_(one.is_unordered(nan))}{b_(nan.is_unordered(nan))}{b_(one.is_unordered(two))}{b_(inf.is_unordered(-inf))}",
        )
    }

    fn cls_f80(const name: string, v: f80) {
        io::println(
            f"f80 cls {name} {b_(v.is_nan())}{b_(v.is_infinite())}{b_(v.is_finite())}{b_(v.is_zero())}{b_(v.is_subnormal())}{b_(v.is_normal())}{b_(v.is_sign_negative())}",
        )
    }
}

fn run_f128() {
    var z:    f128 = 0.0
    var nz         = -z
    var one:  f128 = 1.0
    var two:  f128 = 2.0
    var four: f128 = 4.0
    var a:    f128 = 2.25
    var na         = -a
    var inf        = f128::INFINITY
    var nan        = f128::NAN
    io::println(
        f"f128 bits {h_(four.to_bits())} {h_(nz.to_bits())} {h_(f128::MAX.to_bits())} {h_(f128::MIN_SUBNORMAL.to_bits())} {h_(f128::INFINITY.to_bits())} {h_(f128::NEG_INFINITY.to_bits())} {h_(f128::NAN.to_bits())}",
    )

    io::println(
        f"f128 sqrt {h_(two.sqrt().to_bits())} {h_(a.sqrt().to_bits())} {h_(nz.sqrt().to_bits())} {h_(z.sqrt().to_bits())} {h_(inf.sqrt().to_bits())} {b_(na.sqrt().is_nan())}{b_(nan.sqrt().is_nan())}{b_((-inf).sqrt().is_nan())}",
    )

    var e  = f128::EPSILON
    var hi = one + e
    var lo = one - e
    var mo = -one
    io::println(
        f"f128 fma {h_(hi.fma(lo, mo).to_bits())} {h_(two.fma(four, two).to_bits())} {b_(inf.fma(z, one).is_nan())}{b_(nan.fma(one, one).is_nan())}{b_(inf.fma(one, -inf).is_nan())} {h_(inf.fma(two, one).to_bits())} {h_(nz.fma(one, nz).to_bits())}",
    )

    io::println(
        f"f128 abs {h_(na.abs().to_bits())} {h_(nz.abs().to_bits())} {h_((-inf).abs().to_bits())} {h_(a.copysign(nz).to_bits())} {h_(na.copysign(one).to_bits())} {b_(nan.copysign(mo).is_sign_negative())}{b_(nan.copysign(mo).abs().is_sign_negative())}{b_(nan.copysign(mo).is_nan())}",
    )

    var nn = nan.copysign(mo)
    cls_f128("0", z)
    cls_f128("-0", nz)
    cls_f128("4", four)
    cls_f128("-2.25", na)
    cls_f128("sub", f128::MIN_SUBNORMAL)
    cls_f128("-sub", -f128::MIN_SUBNORMAL)
    cls_f128("minpos", f128::MIN_POSITIVE)
    cls_f128("max", f128::MAX)
    cls_f128("inf", inf)
    cls_f128("-inf", -inf)
    cls_f128("nan", nan)
    cls_f128("-nan", nn)
    io::println(
        f"f128 unord {b_(nan.is_unordered(one))}{b_(one.is_unordered(nan))}{b_(nan.is_unordered(nan))}{b_(one.is_unordered(two))}{b_(inf.is_unordered(-inf))}",
    )

    // P754: a limit at the head of a method chain.
    io::println(
        f"f128 chain {b_(f128::NAN.is_nan())}{b_(f128::MAX.is_finite())}{b_(f128::INFINITY.is_infinite())}{b_(f128::MIN_SUBNORMAL.is_subnormal())}{b_(f128::MIN.is_sign_negative())}{b_(f128::MAX.abs().is_normal())}",
    )
}

fn cls_f128(const name: string, v: f128) {
    io::println(
        f"f128 cls {name} {b_(v.is_nan())}{b_(v.is_infinite())}{b_(v.is_finite())}{b_(v.is_zero())}{b_(v.is_subnormal())}{b_(v.is_normal())}{b_(v.is_sign_negative())}",
    )
}

fn main() -> i32 {
    run_f16()
    run_bf16()
    run_f32()
    run_f64()
    eval if defined!(__x86_64__) || defined!(__i386__) {
        run_f80()
    }

    run_f128()
    return 0
}

// --- lit wiring -----------------------------------------------------------
// REQUIRES: clang
// RUN: rm -rf %t.d
// RUN: %kairo %s -o %t.exe --cache-dir %t.d
// RUN: %t.exe | %FileCheck %s --check-prefixes=CHECK,X87
// RUN: %kairo %s -O2 -o %t.o2.exe --cache-dir %t.d
// RUN: %t.o2.exe | %FileCheck %s --check-prefixes=CHECK,X87
// CHECK: f16 bits 4400 8000 7bff 1 7c00 fc00 7e00
// CHECK-NEXT: f16 sqrt 3da8 3e00 8000 0 7c00 111
// CHECK-NEXT: f16 fma 8010 4900 111 7c00 8000
// CHECK-NEXT: f16 abs 4080 0 7c00 c080 4080 101
// CHECK-NEXT: f16 cls 0 0011000
// CHECK-NEXT: f16 cls -0 0011001
// CHECK-NEXT: f16 cls 4 0010010
// CHECK-NEXT: f16 cls -2.25 0010011
// CHECK-NEXT: f16 cls sub 0010100
// CHECK-NEXT: f16 cls -sub 0010101
// CHECK-NEXT: f16 cls minpos 0010010
// CHECK-NEXT: f16 cls max 0010010
// CHECK-NEXT: f16 cls inf 0100000
// CHECK-NEXT: f16 cls -inf 0100001
// CHECK-NEXT: f16 cls nan 1000000
// CHECK-NEXT: f16 cls -nan 1000001
// CHECK-NEXT: f16 unord 11100
// CHECK-NEXT: f16 chain 111111
// CHECK: bf16 bits 4080 8000 7f7f 1 7f80 ff80 7fc0
// CHECK-NEXT: bf16 sqrt 3fb5 3fc0 8000 0 7f80 111
// CHECK-NEXT: bf16 fma b880 4120 111 7f80 8000
