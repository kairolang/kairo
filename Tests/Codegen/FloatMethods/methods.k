    )

    io::println(
        f"bf16 abs {na.abs().to_bits():x} {nz.abs().to_bits():x} {(-inf).abs().to_bits():x} {a.copysign(nz).to_bits():x} {na.copysign(one).to_bits():x} {b_(nan.copysign(mo).is_sign_negative())}{b_(nan.copysign(mo).abs().is_sign_negative())}{b_(nan.copysign(mo).is_nan())}",
    )

