        f"f64 cls {name} {b_(v.is_nan())}{b_(v.is_infinite())}{b_(v.is_finite())}{b_(v.is_zero())}{b_(v.is_subnormal())}{b_(v.is_normal())}{b_(v.is_sign_negative())}",
    )
