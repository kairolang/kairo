// Every float method (num/float_ext.k, num/f128_ext.k) on every native float
// type: to_bits, sqrt, fma, abs, copysign, is_unordered, is_nan,
// is_infinite, is_finite, is_zero, is_subnormal, is_normal and
// is_sign_negative, on +-0, +-inf, NaN of both signs, the smallest
// subnormal, the smallest normal, MAX and ordinary values. Results are
// printed as encodings and checked against values computed exactly
// (fractions.Fraction, round to nearest even): sqrt(2), sqrt(2.25), and
// fma(1 + eps, 1 - eps, -1) = -eps^2, which only a single rounding gets
// (unfused, the product rounds to 1 and the sum to 0). The `chain` lines are
// P754: a limit at the head of a method chain, `f64::NAN.is_nan()` (not for
// f80, whose limits cannot sit in an eval-if branch yet, P760).
// Generated by Inputs/gen_methods.py (the oracle); regenerate, do not edit.
// f80 is x86 only; its lines are the X87 prefix. cross.k runs this file on
// i686 and aarch64.

import std::io

fn b_(x: bool) -> string {
    if x {
        return "1"
    }

    return "0"
}

fn h_(v: u128) -> string {
    return f"{(v >> 64) as u64:x}:{v as u64:x}"
}

fn run_f16() {
    var z:    f16 = 0.0
    var nz        = -z
    var one:  f16 = 1.0
    var two:  f16 = 2.0
    var four: f16 = 4.0
    var a:    f16 = 2.25
    var na        = -a
    var inf       = f16::INFINITY
    var nan       = f16::NAN
    io::println(
        f"f16 bits {four.to_bits():x} {nz.to_bits():x} {f16::MAX.to_bits():x} {f16::MIN_SUBNORMAL.to_bits():x} {f16::INFINITY.to_bits():x} {f16::NEG_INFINITY.to_bits():x} {f16::NAN.to_bits():x}",
    )

    io::println(
        f"f16 sqrt {two.sqrt().to_bits():x} {a.sqrt().to_bits():x} {nz.sqrt().to_bits():x} {z.sqrt().to_bits():x} {inf.sqrt().to_bits():x} {b_(na.sqrt().is_nan())}{b_(nan.sqrt().is_nan())}{b_((-inf).sqrt().is_nan())}",
    )

    var e  = f16::EPSILON
    var hi = one + e
    var lo = one - e
    var mo = -one
    io::println(
        f"f16 fma {hi.fma(lo, mo).to_bits():x} {two.fma(four, two).to_bits():x} {b_(inf.fma(z, one).is_nan())}{b_(nan.fma(one, one).is_nan())}{b_(inf.fma(one, -inf).is_nan())} {inf.fma(two, one).to_bits():x} {nz.fma(one, nz).to_bits():x}",
    )

    io::println(
        f"f16 abs {na.abs().to_bits():x} {nz.abs().to_bits():x} {(-inf).abs().to_bits():x} {a.copysign(nz).to_bits():x} {na.copysign(one).to_bits():x} {b_(nan.copysign(mo).is_sign_negative())}{b_(nan.copysign(mo).abs().is_sign_negative())}{b_(nan.copysign(mo).is_nan())}",
    )

    var nn = nan.copysign(mo)
    cls_f16("0", z)
    cls_f16("-0", nz)
    cls_f16("4", four)
    cls_f16("-2.25", na)
    cls_f16("sub", f16::MIN_SUBNORMAL)
    cls_f16("-sub", -f16::MIN_SUBNORMAL)
    cls_f16("minpos", f16::MIN_POSITIVE)
    cls_f16("max", f16::MAX)
    cls_f16("inf", inf)
    cls_f16("-inf", -inf)
    cls_f16("nan", nan)
    cls_f16("-nan", nn)
    io::println(
        f"f16 unord {b_(nan.is_unordered(one))}{b_(one.is_unordered(nan))}{b_(nan.is_unordered(nan))}{b_(one.is_unordered(two))}{b_(inf.is_unordered(-inf))}",
    )

    // P754: a limit at the head of a method chain.
    io::println(
        f"f16 chain {b_(f16::NAN.is_nan())}{b_(f16::MAX.is_finite())}{b_(f16::INFINITY.is_infinite())}{b_(f16::MIN_SUBNORMAL.is_subnormal())}{b_(f16::MIN.is_sign_negative())}{b_(f16::MAX.abs().is_normal())}",
    )
}

fn cls_f16(const name: string, v: f16) {
    io::println(
        f"f16 cls {name} {b_(v.is_nan())}{b_(v.is_infinite())}{b_(v.is_finite())}{b_(v.is_zero())}{b_(v.is_subnormal())}{b_(v.is_normal())}{b_(v.is_sign_negative())}",
    )
}

