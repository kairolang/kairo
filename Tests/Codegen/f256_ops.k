// f256: the arithmetic, comparisons and conversions of the primitive, bit
// for bit against an exact oracle. A deterministic stream of 3000 operand
// triples (xorshift64*, weighted to NaN, infinities, zeros, subnormals, both
// ends of the exponent range and near-cancelling pairs) goes through every
// operation, and each operation's results are folded into one FNV-1a hash,
// compared with the hash Scripts/gen_softfloat_tests.py computed from
// fractions.Fraction (round to nearest even, once). Text is checked the same
// way, and every finite value's shortest text must parse back to its bits.
// Generated by Scripts/gen_softfloat_tests.py; regenerate, do not edit.

import std::io

struct Rng {
    var s: u64 = 0
}

fn next_(r: *Rng) -> u64 {
    var x = r->s
    x    = x ^ x >> 12
    x    = x ^ x << 25
    x    = x ^ x >> 27
    r->s = x
    return x * 2685821657736338717
}

fn bits_(r: *Rng, k: i32) -> u512 {
    var v:   u512 = 0
    var got: i32  = 0
    while got < k {
        v = v << 64 | (next_(r) as u512)
        got += 64
    }

    if k < 512 {
        var one: u512 = 1
        v = v & (one << (k as u32)) - 1
    }

    return v
}

fn gen_(r: *Rng, near: u512, has_near: bool, moderate: bool) -> u512 {
    var nb:    u32  = 256
    var mb:    u32  = 236
    var emask: u512 = 524287
    var bias:  u512 = 262143
    var one:   u512 = 1
    var sign        = ((next_(r) & 1) as u512) << nb - 1
    var k           = next_(r) % 100
    if moderate {
        k = 50 + k % 50
    }

    if k < 3 {
        return emask << mb | one << mb - 1
    }

    if k < 6 {
        return sign | emask << mb
    }

    if k < 9 {
        return sign
    }

    if k < 15 {
        var n = 1 + next_(r) % (mb as u64)
        return sign | bits_(r, n as i32)
    }

    var e: u512 = 0
    var ne      = near >> mb & emask
    if k < 20 {
        e = (1 + next_(r) % 4) as u512
    } else if k < 25 {
        e = emask - 1 - ((next_(r) % 4) as u512)
    } else if k < 40 {
        e = bias - 8 + ((next_(r) % 17) as u512)
    } else if k < 50 && has_near && ne > 0 && ne < emask {
        e = ne + ((next_(r) % 5) as u512)
        if e < 3 {
            e = 1
        } else {
            e = e - 2
        }

        if e > emask - 1 {
            e = emask - 1
        }

        var nbits = 1 + next_(r) % 12
        var m     = near & (one << mb) - 1 ^ bits_(r, nbits as i32)
        return sign | e << mb | m
    } else if moderate {
        e = bias - 3000 + ((next_(r) % 6001) as u512)
    } else {
        e = 1 + ((next_(r) % ((emask - 1) as u64)) as u512)
    }

    var p       = next_(r) % 10
    var m: u512 = 0
    if p == 0 {
        m = (one << mb) - 1
    } else if p == 1 {
        m = one << ((next_(r) % (mb as u64)) as u32)
    } else if p == 2 {
        m = bits_(r, 8) << mb - 8
    } else {
        m = bits_(r, mb as i32)
    }

    return sign | e << mb | m
}

fn fnv_(h: *u64, v: u512, nbytes: i32) {
    for var i: i32 = 0; i < nbytes / 8; ++i {
        var c = ((v >> ((64 * i) as u32)) as u64)
        var x = *h
        *h = (x ^ c) * 1099511628211
    }
}

fn fnv_str_(h: *u64, const s: string) {
    var *p = s.as_ptr()
    for var i: usize = 0; i < s.length(); ++i {
        var x = *h
        *h = (x ^ (p[i] as u64)) * 1099511628211
    }
}

fn val_(b: u512) -> f256 {
    return __builtin_bitcast<f256, u256>(b as u256)
}

fn enc_(x: f256) -> u512 {
    return __builtin_bitcast<u256, f256>(x) as u512
}

fn cls_(x: f256) -> F256 {
    return F256::from_bits(__builtin_bitcast<u256, f256>(x))
}

fn check_(const name: string, got: u64, want: u64) -> i32 {
    if got == want {
        io::println(f"{name} ok")
        return 0
    }

    io::println(f"{name} MISMATCH got {got} want {want}")
    return 1
}

fn main() -> i32 {
    var r            = Rng { s: 11400714819323198741 }
    var h: [u64; 19]
    for var i: i32 = 0; i < 19; ++i {
        h[i] = 14695981039346656037
    }

    var trip_bad: i32 = 0
    for var i: i32 = 0; i < 3000; ++i {
        var a = gen_(&r, 0, false, false)
        var b = gen_(&r, a, true, false)
        var c = gen_(&r, 0, false, false)
        var x = val_(a)
        var y = val_(b)
        var z = val_(c)
        fnv_(&h[0], enc_(x + y), 32)
        fnv_(&h[1], enc_(x - y), 32)
        fnv_(&h[2], enc_(x * y), 32)
        fnv_(&h[3], enc_(x / y), 32)
        fnv_(&h[4], cls_(x).abs().sqrt().to_bits() as u512, 32)
        fnv_(&h[5], cls_(x).fma(cls_(y), cls_(z)).to_bits() as u512, 32)
        var cmp: u512 = 3
        if x < y {
            cmp = 1
        } else if x == y {
            cmp = 0
        } else if x > y {
            cmp = 2
        }

        if x <= y != (cmp == 1 || cmp == 0) {
            cmp = 99
        }

        if x != y == (cmp == 0) {
            cmp = 98
        }

        fnv_(&h[6], cmp, 8)
        fnv_(&h[7], __builtin_bitcast<u64, f64>(x as f64) as u512, 8)
        fnv_(&h[8], __builtin_bitcast<u32, f32>(x as f32) as u512, 8)
        var d = next_(&r)
        fnv_(&h[9], enc_(__builtin_bitcast<f64, u64>(d) as f256), 32)
        fnv_(&h[10], (x as i64) as u64 as u512, 8)
        fnv_(&h[11], (x as u32) as u512, 8)
        fnv_(&h[12], (x as i512) as u512, 64)
        var si = next_(&r) as i64
        fnv_(&h[13], enc_(si as f256), 32)
        var wi = (bits_(&r, 300) as i512) - (bits_(&r, 299) as i512)
        fnv_(&h[14], enc_(wi as f256), 32)
        fnv_(&h[15], __builtin_bitcast<u512, f512>(x as f512) as u512, 64)
    }

    for var i: i32 = 0; i < 300; ++i {
        var t  = val_(gen_(&r, 0, false, true))
        var s1 = f"{t}"
        fnv_str_(&h[16], s1)
        fnv_str_(&h[17], f"{t:.20e}")
        fnv_str_(&h[18], f"{t:>12.5}")
        var back = F256()
        if !F256::parse(s1, &back) {
            trip_bad += 1
        } else if !cls_(t).is_nan() && back.to_bits() != cls_(t).to_bits() {
            trip_bad += 1
        }
    }

    var bad: i32 = 0
    bad += check_("add", h[0], 9421661624164514947)
    bad += check_("sub", h[1], 2378092689220944950)
    bad += check_("mul", h[2], 9393399662977860314)
    bad += check_("div", h[3], 3441482822781233888)
    bad += check_("sqrt", h[4], 15769905850414915975)
    bad += check_("fma", h[5], 18296391556332853477)
    bad += check_("cmp", h[6], 13857220461935192161)
    bad += check_("to_f64", h[7], 8584246020611835211)
    bad += check_("to_f32", h[8], 7680459849175009013)
    bad += check_("from_f64", h[9], 16683035000608516357)
    bad += check_("to_i64", h[10], 7182769254849759517)
    bad += check_("to_u32", h[11], 7088553668303468117)
    bad += check_("to_i512", h[12], 12205663528428071391)
    bad += check_("from_i64", h[13], 10839637047717867031)
    bad += check_("from_i512", h[14], 7933468069878725586)
    bad += check_("to_f512", h[15], 6910079351041001964)
    bad += check_("text_shortest", h[16], 15604608743328183788)
    bad += check_("text_e20", h[17], 12766663493529723384)
    bad += check_("text_g5_width", h[18], 11328108865890217625)
    if trip_bad == 0 {
        io::println("roundtrip ok")
    } else {
        io::println(f"roundtrip MISMATCH {trip_bad}")
    }

    return bad + trip_bad
}

// --- lit wiring -----------------------------------------------------------
// REQUIRES: clang
// RUN: rm -rf %t.d
// RUN: %kairo %s -o %t.exe --cache-dir %t.d
// RUN: %t.exe | %FileCheck %s
// CHECK: add ok
// CHECK: sub ok
// CHECK: mul ok
// CHECK: div ok
// CHECK: sqrt ok
// CHECK: fma ok
// CHECK: cmp ok
// CHECK: to_f64 ok
// CHECK: to_f32 ok
// CHECK: from_f64 ok
// CHECK: to_i64 ok
// CHECK: to_u32 ok
// CHECK: to_i512 ok
// CHECK: from_i64 ok
// CHECK: from_i512 ok
// CHECK: to_f512 ok
// CHECK: text_shortest ok
// CHECK: text_e20 ok
// CHECK: text_g5_width ok
// CHECK: roundtrip ok
// CHECK-NOT: MISMATCH
