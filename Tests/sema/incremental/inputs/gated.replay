# Tests/sema/incremental/replay_gated.k: an extension that exists only in a
# file that declares cxx::std::string appears when the file's headers come
# to declare it and goes when they stop: by an edit of a header the file
# already imports (no .k file changes), and by an added or removed import.
step use_without_string
replace s/main.k:::    return answer():::    return lib_takes(s)
step header_gains_string
replace s/plain.hh:::// no includes:::#include <string>
step body_edit
replace s/main.k:::"abc":::"abcd"
step header_loses_string
replace s/plain.hh:::#include <string>:::// no includes
step add_import
replace s/main.k:::import lib::*:::import lib::*\nffi "c++" import "takes.hh"
step remove_import
replace s/main.k:::import lib::*\nffi "c++" import "takes.hh":::import lib::*
