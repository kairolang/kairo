    ck(f"{v12}", "-1000000000000000000000000000000", 11, "i128 big {}")
    ck(f"{v12:+}", "-1000000000000000000000000000000", 11, "i128 big {+}")
    ck(f"{v12:60}", "                            -1000000000000000000000000000000", 11, "i128 big {60}")
}

