// UTF-8 checking, counting and coding through the public members, against
// an oracle that decodes each sequence to its value and judges the value:
//   - the 300 inputs of llvm/unittests/Support/ConvertUTFTest.cpp, each
//     with LLVM's verdict;
//   - every four-byte lead with every second byte and third and fourth
//     bytes on both sides of the continuation range;
//   - every scalar value pushed, re-read forward and backward and re-checked;
//   - codepoint counts and the ASCII answer of views at every alignment of
//     text long enough to cross the counter's 255-word blocks;
//   - with an argument, every 1, 2 and 3 byte sequence at eight alignments
//     inside ASCII text (134 million inputs).
// from_utf8 is null exactly where the oracle rejects; where it accepts, the
// constructor from the same bytes builds an equal string.

import std::io

static FAILS: i32 = 0

fn fail(const what: string) {
    if FAILS < 20 {
        io::println(what)
    }

    FAILS += 1
}

// Length of the longest valid prefix of the `n` bytes at `p`.
fn naive_valid_up_to(p: unsafe *const u8, n: usize) -> usize {
    var i: usize = 0
    unsafe {
        while i < n {
            var b: u32 = p[i]
            if b < 0x80 {
                i += 1
                continue
            }

            var need: usize = 0
            var cp:   u32   = 0
            var min:  u32   = 0
            if (b & 0xe0) == 0xc0 {
                need = 1
                cp   = b & 0x1f
                min  = 0x80
            } else if (b & 0xf0) == 0xe0 {
                need = 2
                cp   = b & 0x0f
                min  = 0x800
            } else if (b & 0xf8) == 0xf0 {
                need = 3
                cp   = b & 0x07
                min  = 0x10000
            } else {
                return i
            }

            if n - i <= need {
                return i
            }

            for var k: usize = 1; k <= need; k += 1 {
                var c: u32 = p[i + k]
                if (c & 0xc0) != 0x80 {
                    return i
                }

                cp = (cp << 6) | (c & 0x3f)
            }

            if cp < min || cp > 0x10ffff || (cp >= 0xd800 && cp <= 0xdfff) {
                return i
            }

            i += need + 1
        }
    }

    return n
}

fn naive_count(p: unsafe *const u8, n: usize) -> usize {
    var c: usize = 0
    unsafe {
        for var i: usize = 0; i < n; i += 1 {
            if p[i] < 0x80 || p[i] >= 0xc0 {
                c += 1
            }
        }
    }

    return c
}

fn naive_ascii(p: unsafe *const u8, n: usize) -> bool {
    unsafe {
        for var i: usize = 0; i < n; i += 1 {
            if p[i] >= 0x80 {
                return false
            }
        }
    }

    return true
}

// One input: from_utf8 agrees with the oracle (or with `want` when it is
// 0 or 1), and a valid input builds the same string either way.
fn one_case(p: unsafe *const u8, n: usize, want: i32) -> bool {
    var valid = naive_valid_up_to(p, n) == n
    if want >= 0 && valid != (want == 1) {
        return false
    }

    unsafe {
        var s? = string::from_utf8(Slice<const u8>(p, n))
        if !s? {
            return !valid
        }

        if !valid {
            return false
        }

        if s.size() != n || s.codepoints() != naive_count(p, n) || s.is_ascii() != naive_ascii(p, n) {
            return false
        }

        var t = string(p as *const u8, n)
        return t == s && t.codepoints() == s.codepoints() && t.is_ascii() == s.is_ascii()
    }
}

