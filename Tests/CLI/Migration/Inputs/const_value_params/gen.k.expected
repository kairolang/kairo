// Fixture for const_value_params.k: generic value parameters in the old
// `const` spelling, beside every shape the rewrite must leave alone.
// A comment naming <const N: usize> stays as written.

class <eval N: usize> Buf {
    pub var data: [i32; N]
}

struct <T, eval M: i32, U> Mixed {
    pub var t: T
    pub var u: U
}

fn <eval K: usize> width(b: *Buf<K>) -> usize { return K }

class <eval A: usize> Outer {
    fn <eval B: usize> both(self) -> usize { return A + B }
}

fn <T, eval  N :usize> count(x: T) -> usize { return N }

fn keep(const x: i32) -> i32 {
    var s = "fn <const N: usize> g"
    return x
}

fn main() -> i32 { return 0 }
