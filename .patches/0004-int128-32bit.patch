--- a/clang/lib/Basic/Targets/RISCV.h
+++ b/clang/lib/Basic/Targets/RISCV.h
@@ -202,6 +202,13 @@ public:
     if (ISAInfo->hasExtension("zalrsc"))
       MaxAtomicInlineWidth = 32;
   }
+
+  // __int128 on RV32, what -fforce-enable-int128 gives (compiler-rt's
+  // RV32 builtins already build with that flag). The psABI rule for
+  // scalars wider than 2*XLEN passes it by reference; the backend expands
+  // its arithmetic inline and calls compiler-rt for i128<->fp conversions.
+  // Kairo's i128 lowers to it.
+  bool hasInt128Type() const override { return true; }
 };
 class LLVM_LIBRARY_VISIBILITY RISCV64TargetInfo : public RISCVTargetInfo {
 public:
diff --git a/clang/lib/Basic/Targets/X86.h b/clang/lib/Basic/Targets/X86.h
index 5a0817b09e64..583d3aa46f7d 100644
--- a/clang/lib/Basic/Targets/X86.h
+++ b/clang/lib/Basic/Targets/X86.h
@@ -473,6 +473,16 @@ public:
     MaxAtomicInlineWidth = 32;
   }
 
+  // __int128 as on x86_64, what -fforce-enable-int128 gives: Int128Align
+  // 128 matches the i386 data layout's i128:128. The backend expands i128
+  // arithmetic inline (division through ExpandLargeDivRem); i128<->fp
+  // conversions call compiler-rt (__floattidf, ...), which has them once
+  // __SIZEOF_INT128__ is defined. Kairo's i128 lowers to it. ABI note:
+  // libc++ switches file_time_type to duration<__int128> when it sees
+  // __SIZEOF_INT128__, so a libc++ built by a compiler without this is not
+  // link-compatible.
+  bool hasInt128Type() const override { return true; }
+
   BuiltinVaListKind getBuiltinVaListKind() const override {
     return TargetInfo::CharPtrBuiltinVaList;
   }
diff --git a/clang/lib/CodeGen/CodeGenModule.cpp b/clang/lib/CodeGen/CodeGenModule.cpp
index 85ed38f14462..a17f5e06d012 100644
--- a/clang/lib/CodeGen/CodeGenModule.cpp
+++ b/clang/lib/CodeGen/CodeGenModule.cpp
@@ -367,7 +367,10 @@ static void checkDataLayoutConsistency(const TargetInfo &Target,
     Check("long long", llvm::Type::getIntNTy(Context, Target.LongLongWidth),
           Target.LongLongAlign);
   // FIXME: There are int128 alignment mismatches on multiple targets.
+  // 32-bit targets get __int128 as -fforce-enable-int128 would (this fork),
+  // with its Int128Align of 128 against a data layout that has no i128 entry.
   if (Target.hasInt128Type() && !Target.getTargetOpts().ForceEnableInt128 &&
+      Target.getPointerWidth(LangAS::Default) >= 64 &&
       !Triple.isAMDGPU() && !Triple.isSPIRV() &&
       Triple.getArch() != llvm::Triple::ve)
     Check("__int128", llvm::Type::getIntNTy(Context, 128), Target.Int128Align);
