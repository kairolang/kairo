diff --git a/clang/lib/Basic/Targets/ARM.h b/clang/lib/Basic/Targets/ARM.h
index 43c4718f4735..cc09fb1220e0 100644
--- a/clang/lib/Basic/Targets/ARM.h
+++ b/clang/lib/Basic/Targets/ARM.h
@@ -181,6 +181,18 @@ public:
     return false;
   }
 
+  // __int128 on every ARM target, what -fforce-enable-int128 gives. AAPCS
+  // has no 128-bit integer and GCC has none here, so there is no ABI to
+  // match: the backend passes i128 as four words (core registers, then the
+  // stack) and expands its arithmetic inline; i128<->fp conversions call
+  // compiler-rt (__floattidf, ...). Int128Align stays 128 as with
+  // the flag, so objects built with and without it agree; the data layout
+  // says 64 (CodeGenModule's consistency check exempts 32-bit targets).
+  // Kairo's i128 lowers to it. ABI note: libc++ switches file_time_type to
+  // duration<__int128> when it sees __SIZEOF_INT128__, so a libc++ built by
+  // a compiler without this is not link-compatible.
+  bool hasInt128Type() const override { return true; }
+
   void getTargetDefinesARMV81A(const LangOptions &Opts,
                                MacroBuilder &Builder) const;
   void getTargetDefinesARMV82A(const LangOptions &Opts,
diff --git a/clang/lib/Basic/Targets/Mips.h b/clang/lib/Basic/Targets/Mips.h
index 4c09390c3c6d..bb4ab803354b 100644
--- a/clang/lib/Basic/Targets/Mips.h
+++ b/clang/lib/Basic/Targets/Mips.h
@@ -421,9 +421,13 @@ public:
     return llvm::ArrayRef(NewABIRegAliases);
   }
 
-  bool hasInt128Type() const override {
-    return (ABI == "n32" || ABI == "n64") || getTargetOpts().ForceEnableInt128;
-  }
+  // __int128 on o32 too, what -fforce-enable-int128 gives (n32 and n64 have
+  // it natively). GCC has none on o32, so there is no ABI to match: the
+  // backend passes i128 in a0-a3 / on the stack and returns it through
+  // sret. Division and i128<->fp conversion are libcalls (__divti3, ...),
+  // which compiler-rt builds once __SIZEOF_INT128__ is defined. Kairo's
+  // i128 lowers to it.
+  bool hasInt128Type() const override { return true; }
 
   unsigned getUnwindWordWidth() const override;
 
diff --git a/clang/lib/Basic/Targets/PPC.h b/clang/lib/Basic/Targets/PPC.h
index 664c9e15d8d1..ac78bbb8725c 100644
--- a/clang/lib/Basic/Targets/PPC.h
+++ b/clang/lib/Basic/Targets/PPC.h
@@ -428,6 +428,16 @@ public:
   std::pair<unsigned, unsigned> hardwareInterferenceSizes() const override {
     return std::make_pair(32, 32);
   }
+
+  // __int128 on 32-bit PowerPC (not AIX, which keeps its own rule), what
+  // -fforce-enable-int128 gives. GCC has none here, so there is no ABI to
+  // match: the backend passes i128 in four GPRs or on the stack. Division
+  // and i128<->fp conversion are libcalls (__divti3, __floattidf, ...), which
+  // compiler-rt builds once __SIZEOF_INT128__ is defined (CRT_HAS_128BIT).
+  // Kairo's i128 lowers to it.
+  bool hasInt128Type() const override {
+    return !getTriple().isOSAIX() || TargetInfo::hasInt128Type();
+  }
 };
 
 // Note: ABI differences may eventually require us to have a separate
